        "56c40efd-9201-4a79-86d6-f829d8584f99": {
          "type": "question",
          "settings": {
            "title": "Misc. Rings",
            "text": "<ul><li>Mokume Gane Rings: 8 weeks</li><li>Timascus Rings: 8 weeks</li><li>Reptilian Damascus Steel Ring: 8 weeks</li><li>Spirograph Damascus Steel Ring: 8 weeks</li><li>Superconductor Rings: 8 weeks</li></ul>"
