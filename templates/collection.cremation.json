    "faq_VdwH4a": {
      "type": "faq",
      "blocks": {
        "question_dTFxTP": {
          "type": "question",
          "settings": {
            "title": "Can I choose how the ashes are incorporated?",
            "text": "<p>We typically will sprinkle the ashes throughout the ring on top of the design to act as a compliment. </p><p>If you are wanting a ring that is predominantly filled with ashes or for the ashes to be completely hidden as a base layer, please reach out to us.</p>"
          }
        },
        "question_ye4zpL": {
          "type": "question",
          "settings": {
            "title": "Can I send Pet Cremains and Fur?",
            "text": "<p>Yes, we accept both Pet and Human cremains in addition to Fur/Hair!</p>"
          }
        },
        "question_nWPfzJ": {
          "type": "question",
          "settings": {
            "title": "How many cremains should I send to you?",
            "text": "<p>We typically only require roughly 2 teaspoons per ring.</p>"
          }
        },
        "question_WNkRQy": {
          "type": "question",
          "settings": {
            "title": "Will you send back any unused cremains?",
            "text": "<p>Yes, if you send us more than we need, we will send back any excess cremains with your order. If you do not receive any cremains back with your finished ring, it means we used them all.</p>"
          }
        },
        "question_DYNtCH": {
          "type": "question",
          "settings": {
            "title": "How does the Vial Kit Process work?",
            "text": "<p>If you order a cremation product with a vial kit included, we will ship you a vial kit within 24-48 business hours after you place your order. </p><p>Once received, you will fill the vial kit with the remains and you will be emailed instructions on how to send the cremains back to us.</p>"
          }
        },
        "question_78TDdL": {
          "type": "question",
          "settings": {
            "title": "How do I send you Cremains if I choose to not purchase the Vial Kit Add On?",
            "text": "<p>You are welcome to send us the cremains using your own method but please note the only way to send cremains legally through the US is through USPS Priority Mail Express.</p>"
          }
        },
        "question_4heaRU": {
          "type": "question",
          "settings": {
            "title": "Are Cremation Rings Eligible For a Resize, Return, or Exchange?",
            "text": "<p>Unfortunately, due to the nature of cremation jewelry, unless you purchase the Premium Protection Plan associated with the product, all cremation jewelry is NOT eligible for a free resize or exchange and is non refundable.</p>"
          }
        },
        "question_kTcTaU": {
          "type": "question",
          "settings": {
            "title": "Can I choose a different pre-set design that isn't listed for a Cremation Ring?",
            "text": "<p>Yes, just send us an email at support@patrickadairdesigns.com with the pre-set design you are looking to use!</p>"
          }
        }
      },
