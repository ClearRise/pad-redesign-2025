        "replo_text_bb4746a0-dfa9-4b1a-a0ae-0ac04069689f": "<p>SHOP NOW</p>",
        "replo_text_df78a53e-62e9-49f9-ba5f-49cef218eea0": "<p>Buy now, pay over time with AFFIRM. <a href=\"https://ridge.com/pages/buy-with-affirm?_gl=1*1vl4lu3*_gcl_au*MTAzNDk2MzYyMC4xNzEzMDM3NDE0\"><span style=\"text-decoration:underline\">LEARN MORE</span></a></p>",
