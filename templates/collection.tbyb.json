    "faq_mnbz7D": {
      "type": "faq",
      "blocks": {
        "question_bW6wKj": {
          "type": "question",
          "settings": {
            "title": "When do I have to return my items by?",
            "text": "<p>Your trial starts the day your items are marked delivered by the shipping courier. The trial period is 7 days.</p><p>Initiate your return before your trial ends by emailing us at support@patrickadairdesigns.com with your order # and the items you wish to return.</p><p>Once a return is initiated, you then have 5 days to return the products. You are responsible for return shipping costs on any products being returned.</p>"
          }
        },
        "question_dNNhcR": {
          "type": "question",
          "settings": {
            "title": "Why is there an authorization on my card?",
            "text": "<p>Similar to booking a hotel or rideshare, we reserve the funds in case you decide to keep all your items. An authorization is not a charge - you'll only be charged for what you keep.</p>"
          }
        },
        "question_wjGx3K": {
          "type": "question",
          "settings": {
            "title": "Do I get free shipping or free returns?",
            "text": "<p>Try Before You Buy Orders are NOT eligible for free shipping on returns.</p>"
          }
        },
        "question_C9hNkn": {
          "type": "question",
          "settings": {
            "title": "I initiated my return, why is my card being re-authorized?",
            "text": "<p>Banks have limits for how long a hold can be valid. We are likely still processing your return. As soon as your return is approved, your card will be charged only for what you kept and will no longer require re-authorizations.</p>"
          }
        },
        "question_RbfYLK": {
          "type": "question",
          "settings": {
            "title": "Why is my card being re-authorized after already initiating a return or before my order has shipped?",
            "text": "<p>Banks have limits for how long a hold can be valid. In the event of a return, we are still processing your return. As soon as your return is approved, your card will be charged only for what you kept and will no longer require re-authorizations. If your order has not shipped yet, it will ship shortly.</p>"
          }
        },
        "question_mwbHWn": {
          "type": "question",
          "settings": {
            "title": "My trial ended and I was charged, but now I want to return something. Is this still possible?",
            "text": "<p>Yes, you can still return eligible items within the our return window. Check out our <a href=\"/pages/limited-lifetime-warranty-and-return-policy\" target=\"_blank\" title=\"Limited Lifetime Warranty and Return Policy\">returns policy</a> for more details.</p>"
          }
        },
        "question_XaPKVe": {
          "type": "question",
          "settings": {
            "title": "Are Try Before You Buy Orders Eligible For a Free Gift?",
            "text": "<p>Unfortunately, due to the nature of Try Before You Buy, orders containing Try Before You Buy products are NOT eligible for free gifts during promotions.</p>"
          }
        }
      },
