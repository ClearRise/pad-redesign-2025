    $('.upsell_button_gtm').on('click', function(e){
    e.preventDefault();
   
    var id = $(this).attr('data-product-id');
      
      console.log(id);
    var q = 1;
    var ajax = {
        type: "POST",
        url: "/cart/add.js",
        data: "quantity=" + q + "&id=" + id,
        dataType: "json",
        success: function (n) {

          document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
          document.dispatchEvent(new CustomEvent('cart:build'));
                  
        },
        error: function (n, c) {
           console.log('fail');
        }
     };
    jQuery.ajax(ajax)  
