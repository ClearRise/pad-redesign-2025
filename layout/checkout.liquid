           {% if true %} 
              {% assign free_gift = false %}
              {% for line_item in checkout.line_items %}
                {% if line_item.product.type contains 'free_gift' %}
                  {% assign free_gift = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
            <div class="promoCodeInviteHeader" style="padding:10px;color: #fff !important;background-color: black !important;text-align: center !important;margin-bottom: 20px;font-size: 18px; margin-top: 5px; line-height: 1.2; {% unless free_gift %} display: none; {% endunless %}">
              <p>Order in the next  <b style="color: #138f7e;">10 minutes </b><br> to lock in your <b style="color: #138f7e;">FREE GIFT</b></p>
              <style>
                    body {
                        font-family: Arial, sans-serif;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        height: 1000vh;
                       
                        margin: 0;
                        padding: 0;
                    }
                    #countdown {
                        font-size: 42px;
                        color: #138f7e;
                    }
                </style>
                            <div id="countdown">00:00</div>
                <script>
                    let countdownDisplay = document.getElementById("countdown");
                    let timeLeft = 10 * 60; // 10 minutes in seconds
            
                    function updateCountdown() {
                        let minutes = Math.floor(timeLeft / 60);
                        let seconds = timeLeft % 60;
            
                        countdownDisplay.textContent = `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
            
                        if (timeLeft === 0) {
                           timeLeft = 10 * 60;
                            //clearInterval(countdownInterval);
                        } else {
                            timeLeft--;
                        }
                    }
            
                    updateCountdown(); // Update the countdown immediately
                    let countdownInterval = setInterval(updateCountdown, 1000); // Update the countdown every second
                </script>  
              </div>     
            {% endif %}
            {{ content_for_order_summary }}
          </div>
        </aside>
      </div>
    </div>

    {{ tracking_code }}
    <script>
 const shopCurrency = '{{ shop.money_format }}';
 Shopify.shop= 'patrick-adair-designs.myshopify.com'; 

   if (document.querySelector("body > aside > button.order-summary-toggle")) {
    document.querySelector("body > aside > button.order-summary-toggle").click();
  }

setTimeout(() => {
  document.getElementById("continue_button").addEventListener("click", function(event){ 
    if(!document.querySelector("#checkout_terms_cond").checked){
      event.preventDefault();
      document.querySelector("#terms_err_msg").style.display="block";
    }
  });
}, "1000");  


var observer = new MutationObserver(function(mutations) {
    if (document.querySelector('.section__content .fieldset [data-sms-marketing]')) {
          var newElement = document.createElement("div");
          newElement.id = "myElement";
          newElement.innerHTML = `<div class="field field--show-floating-label"><div class="terms_wrap checkbox-wrapper"><div class="checkbox__input"><input name="checkout[terms_cond]" type="hidden" value="0" autocomplete="off"><input class="input-checkbox" type="checkbox" value="1" name="checkout[terms_cond]" id="checkout_terms_cond"></div><label class="checkbox__label" for="checkout_terms_cond"><span style="color:red;">*&nbsp</span>I have read and agreed to Patrick Adair Design's <a href="https://patrickadairdesigns.com/pages/terms-and-conditions" target="_blank">Terms and Conditions Policy</a></label></div><div id="terms_err_msg"><p>*&nbsp You must agree to the terms and conditions before continuing</p></div></div>`;
          var parentElement = document.querySelector(".section--shipping-address .section__content .fieldset");         
          parentElement.appendChild(newElement);
          observer.disconnect();                 
    }
});

// Start observing
observer.observe(document.body, { //document.body is node target to observe
    childList: true, //This is a must have for the observer with subtree
    subtree: true //Set to true if changes must also be observed in descendants.
});  
      
</script>
