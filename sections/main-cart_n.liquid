            {% assign cart_total_exclude_gift = cart_total_exclude_gift
              | plus: item.final_price
              | times: item.quantity
            %}
          {% endif %}

          {% case item.properties._igp %}
            {% when '0', null, blank %}
              {% assign intelligems_discount = 0 %}
            {% else %}
              {% assign intelligems_discount = item.properties._igp | plus: 0 %}
              {% assign intelligems_total = intelligems_total
                | plus: item.properties._igp
                | times: item.quantity
              %}
          {% endcase %}
