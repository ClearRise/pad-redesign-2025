                  {% else %}
                    {{ 'cart.general.terms' | t }}
                  {% endif %}
                </label>
              </div>
            {% endif %}

            {%- if settings.shipping_protection_product != blank -%}
            {%- endif -%}

            <div class="cart__item-row cart__checkout-wrapper">
              <div class="sticky-bar">
                <div class="cart__item-sub cart__item-row">
                  <div>{{ 'cart.general.subtotal' | t }}</div>
                  <div data-subtotal class="cart-subtotal">
                    <span class="bcpo-cart-original-total"><span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_total" style="display:none !important;"></span>{{ cart.total_price | money_without_trailing_zeros }}</span>
                  </div>
                </div>
                <div class="nvd-mini"></div>
                <button
                  type="submit"
                  name="checkout"
                  data-terms-required="{{ settings.cart_terms_conditions_enable }}"
                  class="btn cart__checkout btn-primary-secondary-primary"
                >
                  {{ 'cart.general.checkout' | t }}
                </button>
              </div>

              {% if additional_checkout_buttons and settings.cart_additional_buttons %}
                <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
              {% endif %}
            </div>

            <div class="cart__item-row text-center">
              <small>
                {{ 'cart.general.shipping_at_checkout' | t -}}
                <br>
              </small>
            </div>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>

  <script>
    function scrollbar() {
      var rect = document.querySelector('.cart__checkout-wrapper').getBoundingClientRect();
      var innerheight = window.innerHeight - 100;
      if (innerheight > rect.top && rect.top > -100 ) {
        document.querySelector('.cart__checkout-wrapper').classList.add('active');
      } else {
        document.querySelector('.cart__checkout-wrapper').classList.remove('active');
      }
    }

    scrollbar();
    window.addEventListener('scroll', scrollbar, false);
  </script>

