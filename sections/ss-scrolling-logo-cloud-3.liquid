      "info": "Enter a value in pixels"
    },
    {
      "type": "text",
      "id": "logo_bar_height_mobile",
      "label": "Logo Bar Height (Mobile)",
      "info": "Enter a value in pixels"
    },
    {
      "type": "text",
      "id": "logo_bar_top_desktop",
      "label": "Logo Bar Top (Desktop)",
      "info": "Enter a value in pixels"
    },
