    },
    {
      "type": "text",
      "id": "height_mobile",
      "label": "Height (Mobile)",
      "info": "Enter a value in pixels"
    },
    {
      "type": "text",
      "id": "position_top_desktop",
      "label": "Position Top (Desktop)",
      "info": "Enter a value in pixels"
    },
    {
      "type": "text",
      "id": "position_top_mobile",
      "label": "Position Top (Mobile)",
      "info": "Enter a value in pixels"
    },
    {
      "type": "text",
      "id": "logo_bar_height_desktop",
