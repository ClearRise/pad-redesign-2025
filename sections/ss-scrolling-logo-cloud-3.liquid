{%- liquid

  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign background_color = section.settings.background_color
  
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width

  assign border_thickness = section.settings.border_thickness
  assign border_color = section.settings.border_color

  assign header_size =  section.settings.header_size 
  assign header_color =  section.settings.header_color
  assign header_align = section.settings.header_align
  assign heading_custom = section.settings.heading_custom
  assign heading_font = section.settings.heading_font
  
  assign sliders_mt = section.settings.sliders_mt
  assign logo_padding_top = section.settings.logo_padding_top
  assign logo_padding_bottom = section.settings.logo_padding_bottom
  assign shadow = section.settings.shadow
  assign scrolling_velocity = section.settings.scrolling_velocity
  assign pause_hover = section.settings.pause_hover
  assign slider_background_color = section.settings.slider_background_color
  assign slider_gap_mobile = section.settings.slider_gap_mobile
  assign slider_gap = section.settings.slider_gap
  assign slider_direction = section.settings.slider_direction
  assign slider_rotate = section.settings.slider_rotate
  assign slider_mb = section.settings.slider_mb
  assign slider_rotate_mobile = section.settings.slider_rotate_mobile
  assign slider_mb_mobile = section.settings.slider_mb_mobile

  assign icon_width_mobile =  section.settings.icon_width_mobile
  assign icon_width_desktop =  section.settings.icon_width_desktop

  assign logo_text_font_size_desktop = section.settings.logo_text_font_size_desktop
  assign logo_text_font_size_mobile = section.settings.logo_text_font_size_mobile
  assign logo_text_color = section.settings.logo_text_color
-%}
<style>

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    margin-top: {{ margin_top | times: 0.85 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.85 | round: 0 }}px;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    background: {{ background_color }};
    border: {{ border_thickness }}px solid {{ border_color }};
    {% unless full_width %}
      max-width: {{ content_width }}rem;
    {% endunless %}
    overflow: hidden;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
  }
</style>

<style>

  {{ heading_font | font_face: font_display: 'swap' }}
  
  .scrolling-logo-cloud_{{ section.id }} {
    margin-top: {{ sliders_mt | times: 0.85 | round: 0 }}px;
  }

  .scrolling-logo-cloud-title-{{ section.id }} {
    width: 100%;
    margin: 0px;
    text-align: {{ header_align }};
    padding: 0 15px;
    font-size:{{ header_size | times: 0.75 | round: 0 }}px;
    color: {{ header_color }};
  }
  
  .scrolling-logo-cloud_placeholder {
    width:100%;
  }

  .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} {
    display: block;
    {% comment %} flex: 0 0 {{ icon_width | times: 0.85 | round: 0 }}px;
    width: 100%; {% endcomment %}
    {% comment %} width: {{ icon_width_mobile }}px;
    height: {{ icon_width_mobile }}px; {% endcomment %}
  }
  
  .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} img,
  .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} svg {
    width: {{ icon_width_mobile }}px;
    display: block;
    object-fit: cover;
  }

  .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} svg {
    max-height: 80px;
  }

  .marquee-horizontal-{{ section.id }} {
      position: relative;
      z-index: 1;
      display: inline-flex;
      overflow: hidden;
      width: 100%;
      -webkit-box-pack: start;
      -webkit-justify-content: flex-start;
      -ms-flex-pack: start;
      justify-content: flex-start;
      -webkit-box-align: center;
      -webkit-align-items: center;
      -ms-flex-align: center;
      align-items: center;
      width: 200%;
      left: -50%;
  }

  .marquee-horizontal-{{ section.id }}.reverse {
    flex-direction: row-reverse;
  }

  .track-horizontal-{{section.id}} {
      padding-left: {{ slider_gap_mobile }}px;
      display: -webkit-box;
      display: -webkit-flex;
      display: -ms-flexbox;
      display: flex;
      flex-shrink: 0;
      gap: {{ slider_gap_mobile }}px;
      -webkit-box-pack: start;
      -webkit-justify-content: flex-start;
      -ms-flex-pack: start;
      justify-content: flex-start;
      -webkit-box-align: center;
      -webkit-align-items: center;
      -ms-flex-align: center;
      align-items: center;
      white-space: nowrap;
      will-change: transform;
      font-size: {{ logo_text_font_size_desktop }}px;
      font-family: "Gelica Bold" !important;
      {% comment %} padding-right: 30px; {% endcomment %}
      color: {{ logo_text_color }};
  }
  
  @keyframes marquee-horizontal-left {
    0% {
        transform: translateZ(0);
        visibility: visible;
    }
    
    100% {
        transform: translate3d(-100%,0,0);
    }
  }

  @keyframes marquee-horizontal-right {
    0% {
        transform: translate3d(-100%,0,0);
        visibility: visible;
    }
    
    100% {
        transform: translateZ(0);
    }
  }

  .marquee-horizontal-{{ section.id }}.first-marquee-horizontal-{{ section.id }} {
    background-color: {{ slider_background_color }};
    transform: rotate({{ slider_rotate_mobile }}deg);
    transform-origin: center;
    bottom: {{ slider_mb_mobile }}px;
  }

  .marquee-horizontal-{{ section.id }}.first-marquee-horizontal-{{ section.id }} .track-horizontal-{{section.id}} {
    animation: marquee-horizontal-{{ slider_direction }} {{ scrolling_velocity | times: 1000 | round: 0 }}ms linear infinite;
  }
  
  @media screen and (min-width: 768px) {
    
    .scrolling-logo-cloud-title-{{ section.id }} {
      {% comment %} font-size:{{ header_size }}px; {% endcomment %}
      color: {{ header_color }};
    }
  
    .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} {
      {% comment %} flex: 0 0 {{ icon_width }}px;
      width: 100%; {% endcomment %}
      {% comment %} width: {{ icon_width_desktop }}px;
      height: {{ icon_width_desktop }}px; {% endcomment %}
    }
    .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} img,
    .scrolling-logo-cloud_{{ section.id }} .slide-{{ section.id }} svg {
      width: {{ icon_width_desktop }}px;
    }
    
    .track-horizontal-{{section.id}} {
      padding-left: {{ slider_gap }}px;
      gap: {{ slider_gap }}px;
    }

    .marquee-horizontal-{{ section.id }}.first-marquee-horizontal-{{ section.id }} {
      transform: rotate({{ slider_rotate }}deg);
      bottom: {{ slider_mb }}px;
    }
  }

  @media screen and (max-width: 767px) {
    .scrolling-logo-cloud_{{ section.id }} {
      padding: 0 15px;
    }   
    .track-horizontal-{{section.id}} {
      font-size: {{ logo_text_font_size_mobile }}px;
    }
  }

  {% if pause_hover %}
    .marquee-horizontal-{{ section.id }}:hover .track-horizontal-{{section.id}} {
       animation-play-state: paused 
    }
  {% endif %}
  
  #shopify-section-{{ section.id }} {
    height: {{ section.settings.section_height_desktop }}px;
  }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      height: {{ section.settings.section_height_mobile }}px;
    }
  }

  .custom-scroll-logo-cloud-3-{{ section.id }} {
    height: {{ section.settings.height_desktop }}px;
    position: relative;
    top: {{ section.settings.position_top_desktop }}px;
  }
  .custom-scroll-logo-cloud-3-{{ section.id }} .scrolling-logo-cloud .marquee-horizontal {
    height: {{ section.settings.logo_bar_height_desktop }}px;
    position: relative;
    top: {{ section.settings.logo_bar_top_desktop }}px;
  }
  .custom-scroll-logo-cloud-3-{{ section.id }}
    .scrolling-logo-cloud
    .marquee-horizontal
    .scrolling-logo-cloud-slide {
    display: flex;
    align-items: center;
  }
  .custom-scroll-logo-cloud-3-{{ section.id }}
    .scrolling-logo-cloud
    .marquee-horizontal
    .scrolling-logo-cloud-slide
    img {
    {% comment %} max-width: 30px; {% endcomment %}
    margin-right: 10px;
  }
  @media screen and (max-width: 767px) {
    .custom-scroll-logo-cloud-3-{{ section.id }} {
      height: {{ section.settings.height_mobile }}px;
      top: {{ section.settings.position_top_mobile }}px;
    }
    .custom-scroll-logo-cloud-3-{{ section.id }} .scrolling-logo-cloud .marquee-horizontal {
      height: {{ section.settings.logo_bar_height_mobile }}px;
      top: {{ section.settings.logo_bar_top_mobile }}px;
    }
  }
</style>

{% if heading_custom %}
  <style>
    .scrolling-logo-cloud-title-{{ section.id }} {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      font-weight: {{ heading_font.weight }};
      font-style: {{ heading_font.style }};
    }
  </style>
{% endif %}

{% capture loop %}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'slide' -%}
          <div class="scrolling-logo-cloud-slide slide-{{ section.id }}">
            {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" >{% endif %}
              {%- if block.settings.image != blank -%}
                <div class="slide-description">{{ block.settings.text }}</div>                
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag: 'scrolling-logo-cloud_placeholder' }}
              {%- endif -%}
            {% if block.settings.link != blank %}</a>{% endif %}
          </div>
    {%- endcase -%}
  {%- endfor -%}
{% endcapture %}

<section
  class="section-{{ section.id }}-settings custom-scroll-logo-cloud-3 custom-scroll-logo-cloud-3-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --pt: {{ padding_top | times: 0.75 | round: 0 }}px;
    --pt-desktop: {{ padding_top }}px;
    --pb: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    --pb-desktop: {{ padding_bottom }}px;
  "
>
  <div 
    class="scrolling-logo-cloud scrolling-logo-cloud_{{ section.id }}" id="ss-scrolling-logo-cloud"
    >
    <div class="marquee-horizontal marquee-horizontal-{{ section.id }} first-marquee-horizontal-{{ section.id }}" style="padding:0;
    padding-top:{{ logo_padding_top }}px;padding-bottom:{{ logo_padding_bottom }}px; {% if shadow %} box-shadow: 4px 4px 20px rgba(191, 191, 191, 0.5);{% endif %};">
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
      <div class="track-horizontal track-horizontal-{{section.id}} outer_flex">
        {{ loop }}
      </div>
    </div>
    <div class="separate-background-{{ section.id }}"></div>
  </div>
</section>

<script>
  function initScrollingLogoCloudPro() {
    var htmlElement = document.documentElement;

    if (window.getComputedStyle(htmlElement).getPropertyValue('direction') === 'rtl') {
        document.querySelector('.marquee-horizontal-{{ section.id }}').classList.add('reverse');
    }
  }

  document.addEventListener('DOMContentLoaded', initScrollingLogoCloudPro);
  
  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initScrollingLogoCloudPro);
     document.addEventListener('shopify:section:load', initScrollingLogoCloudPro);
  }
</script>

