{% comment %}
  Order Tracking Component - Converted from React to Liquid
  This component displays order progress with business day calculations
{% endcomment %}

{% assign order_date = section.settings.order_date | default: 'now' | date: '%s' %}
{% assign bifm_order = section.settings.bifm_order | default: false %}
{% assign custom_steps_text = section.settings.custom_steps_text | default: 'Step 1,Step 2,Step 3,Step 4,Step 5,Step 6,Step 7,Step 8' %}
{% assign diy_steps_text = section.settings.diy_steps_text | default: 'Step 1,Step 2,Step 3,Step 4,Step 5,Step 6' %}
{% assign bifm_days_limit = section.settings.bifm_days_limit | default: 10 %}
{% assign diy_days_limit = section.settings.diy_days_limit | default: 5 %}
{% assign custom_order = section.settings.custom_order | default: false %}
{% assign expedited_order = section.settings.expedited_order | default: false %}
{% assign expedited_days_limit = section.settings.expedited_days_limit | default: 3 %}

{% comment %} Calculate business days elapsed {% endcomment %}
{% assign current_date = 'now' | date: '%s' %}
{% assign order_timestamp = order_date | plus: 0 %}
{% assign current_timestamp = current_date | plus: 0 %}
{% assign seconds_diff = current_timestamp | minus: order_timestamp %}
{% assign days_diff = seconds_diff | divided_by: 86400 %}

{% comment %} Simple business days calculation (excluding weekends) {% endcomment %}
{% assign business_days_elapsed = 0 %}
{% assign temp_date = order_timestamp %}
{% for i in (1..days_diff) %}
  {% assign temp_date_obj = temp_date | date: '%w' %}
  {% if temp_date_obj != '0' and temp_date_obj != '6' %}
    {% assign business_days_elapsed = business_days_elapsed | plus: 1 %}
  {% endif %}
  {% assign temp_date = temp_date | plus: 86400 %}
{% endfor %}

{% comment %} Calculate total shipment business days {% endcomment %}
{% if expedited_order != false %}
  {% assign total_shipment_business_days = expedited_days_limit | plus: 0 %}
{% elsif bifm_order == true or custom_order == true %}
  {% assign total_shipment_business_days = bifm_days_limit | plus: 0 %}
{% else %}
  {% assign total_shipment_business_days = diy_days_limit | plus: 0 %}
{% endif %}

{% comment %} Determine steps to use {% endcomment %}
{% if bifm_order == true %}
  {% assign steps_text_to_use = custom_steps_text %}
{% else %}
  {% assign steps_text_to_use = diy_steps_text %}
{% endif %}

{% assign step_names = steps_text_to_use | split: ',' %}

{% comment %} Calculate current step index {% endcomment %}
{% assign current_step_index = -1 %}
{% for step in step_names %}
  {% assign step_index = forloop.index0 %}
  {% assign threshold = 0 %}
  
  {% if bifm_order == true %}
    {% case step_index %}
      {% when 0 %}
        {% assign threshold = 0 %}
      {% when 1 %}
        {% assign threshold = total_shipment_business_days | times: 0.25 | floor %}
      {% when 2 %}
        {% assign threshold = total_shipment_business_days | times: 0.45 | floor %}
      {% when 3 %}
        {% assign threshold = total_shipment_business_days | times: 0.80 | floor %}
      {% when 4 %}
        {% assign threshold = total_shipment_business_days %}
      {% when 5 %}
        {% assign threshold = total_shipment_business_days | plus: 1 %}
      {% when 6 %}
        {% assign threshold = total_shipment_business_days | plus: 3 %}
      {% when 7 %}
        {% assign threshold = total_shipment_business_days | plus: 4 %}
    {% endcase %}
  {% else %}
    {% case step_index %}
      {% when 0 %}
        {% assign threshold = 0 %}
      {% when 1 %}
        {% assign threshold = total_shipment_business_days | times: 0.10 | floor %}
      {% when 2 %}
        {% assign threshold = total_shipment_business_days | times: 0.20 | floor %}
      {% when 3 %}
        {% assign threshold = total_shipment_business_days | times: 0.60 | floor %}
      {% when 4 %}
        {% assign threshold = total_shipment_business_days | times: 0.75 | floor %}
      {% when 5 %}
        {% assign threshold = total_shipment_business_days %}
    {% endcase %}
  {% endif %}
  
  {% if business_days_elapsed < threshold %}
    {% assign current_step_index = forloop.index0 | minus: 1 %}
    {% break %}
  {% endif %}
{% endfor %}

{% if current_step_index == -1 and business_days_elapsed >= total_shipment_business_days %}
  {% assign current_step_index = step_names.size | minus: 1 %}
{% endif %}

{% if current_step_index == -1 and business_days_elapsed >= 0 %}
  {% assign current_step_index = 0 %}
{% endif %}

{% comment %} Calculate expected shipment date {% endcomment %}
{% assign expected_shipment_date = order_date | date: '%m/%d/%y' %}
{% assign temp_shipment_date = order_date %}
{% for i in (1..total_shipment_business_days) %}
  {% assign temp_day = temp_shipment_date | date: '%w' %}
  {% if temp_day == '0' or temp_day == '6' %}
    {% assign temp_shipment_date = temp_shipment_date | plus: 86400 %}
  {% endif %}
  {% assign temp_shipment_date = temp_shipment_date | plus: 86400 %}
{% endfor %}
{% assign expected_shipment_date = temp_shipment_date | date: '%m/%d/%y' %}

{% comment %} Calculate progress percentage {% endcomment %}
{% assign progress_percentage = business_days_elapsed | times: 100.0 | divided_by: total_shipment_business_days %}
{% if progress_percentage > 100 %}
  {% assign progress_percentage = 100 %}
{% endif %}

<style>
.order-tracking-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 24px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-radius: 20px;
  box-shadow: 0 8px 32px rgba(37, 99, 235, 0.08), 0 2px 8px rgba(0, 0, 0, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.order-tracking-topInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  padding: 20px 24px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(37, 99, 235, 0.1);
}

.order-number {
  font-size: 18px;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: 0.5px;
}

.order-placed-date {
  font-size: 16px;
  color: #64748b;
  font-weight: 500;
}

.order-tracking-stepper-container {
  position: relative;
  margin: 32px 0;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  padding: 32px 20px 24px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(37, 99, 235, 0.08);
}

.order-tracking-stepper-contianer {
  position: relative;
  overflow: hidden;
}

.order-tracking-stepper {
  display: flex;
  gap: 40px;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 0 20px;
}

.order-tracking-stepper-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140px;
  position: relative;
  flex-shrink: 0;
}

.order-tracking-stepper-item::after {
  content: '';
  position: absolute;
  top: 24px;
  left: 100%;
  width: 40px;
  height: 3px;
  background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 100%);
  border-radius: 2px;
  z-index: 1;
}

.order-tracking-stepper-item:last-child::after {
  display: none;
}

.order-tracking-stepper-item-icon {
  position: relative;
  z-index: 2;
  margin-bottom: 12px;
  width: 48px;
  height: 48px;
  flex-shrink: 0;
}

.order-tracking-stepper-item-icon-circle {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  border: 3px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.order-tracking-stepper-item-icon-circle-inner {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.order-tracking-stepper-item-icon-circle-inner-icon {
  width: 20px;
  height: 20px;
  color: #64748b;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.order-tracking-stepper-item-label {
  font-size: 14px;
  font-weight: 600;
  color: #475569;
  text-align: center;
  line-height: 1.4;
  max-width: 120px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Active and completed states */
.order-tracking-stepper-item.active .order-tracking-stepper-item-icon-circle {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  border-color: #2563eb;
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.3);
}

.order-tracking-stepper-item.active .order-tracking-stepper-item-icon-circle-inner {
  background: #ffffff;
}

.order-tracking-stepper-item.active .order-tracking-stepper-item-icon-circle-inner-icon {
  color: #2563eb;
}

.order-tracking-stepper-item.active .order-tracking-stepper-item-label {
  color: #1e293b;
  font-weight: 700;
}

.order-tracking-stepper-item.completed .order-tracking-stepper-item-icon-circle {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  border-color: #059669;
  box-shadow: 0 4px 16px rgba(5, 150, 105, 0.3);
}

.order-tracking-stepper-item.completed .order-tracking-stepper-item-icon-circle-inner {
  background: #ffffff;
}

.order-tracking-stepper-item.completed .order-tracking-stepper-item-icon-circle-inner-icon {
  color: #059669;
}

.order-tracking-stepper-item.completed .order-tracking-stepper-item-label {
  color: #065f46;
  font-weight: 600;
}

.order-tracking-stepper-item.completed::after {
  background: linear-gradient(90deg, #059669 0%, #10b981 100%);
}

/* Swiper navigation buttons */
{% comment %} .swiper-button-prev,
.swiper-button-next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: rgba(255, 255, 255, 0.95);
  border: 2px solid #e2e8f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10px);
}

.swiper-button-prev:hover,
.swiper-button-next:hover {
  background: #f8fafc;
  border-color: #2563eb;
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.2);
} {% endcomment %}

.swiper-button-prev::after,
.swiper-button-next::after {
  font-size: 18px;
  font-weight: bold;
  color: #64748b;
}

.swiper-button-prev {
  left: 10px;
}

.swiper-button-next {
  right: 10px;
}

/* Progress bar */
.order-tracking-stepper-progress {
  margin-top: 24px;
  padding: 0 20px;
}

.order-tracking-stepper-progress-bar {
  width: 100%;
  height: 8px;
  background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 100%);
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}

.order-tracking-stepper-progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
  border-radius: 4px;
  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.order-tracking-stepper-progress-bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.4) 50%, transparent 100%);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* Table styles */
.order-tracking-table-container {
  margin-top: 32px;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(37, 99, 235, 0.08);
}

.order-tracking-table-header {
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  border-bottom: 2px solid #e2e8f0;
}

.order-tracking-table-header-line {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 20px;
  padding: 20px 24px;
}

.order-tracking-table-header-item-title {
  font-size: 16px;
  font-weight: 700;
  color: #1e293b;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.order-tracking-table-body {
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-style: italic;
}

/* Responsive design */
@media (max-width: 768px) {
  .order-tracking-container {
    padding: 24px 16px;
    border-radius: 16px;
  }
  
  .order-tracking-topInfo {
    flex-direction: column;
    gap: 12px;
    text-align: center;
    padding: 16px 20px;
  }
  
  .order-number {
    font-size: 16px;
  }
  
  .order-placed-date {
    font-size: 14px;
  }
  
  .order-tracking-stepper-container {
    padding: 24px 16px 20px;
  }
  
  .order-tracking-stepper {
    gap: 24px;
    padding: 0 16px;
  }
  
  .order-tracking-stepper-item {
    width: 100px;
  }
  
  .order-tracking-stepper-item-icon-circle {
    width: 40px;
    height: 40px;
  }
  
  .order-tracking-stepper-item-icon-circle-inner {
    width: 28px;
    height: 28px;
  }
  
  .order-tracking-stepper-item-icon-circle-inner-icon {
    width: 16px;
    height: 16px;
  }
  
  .order-tracking-stepper-item-label {
    font-size: 12px;
    max-width: 80px;
  }
  
  {% comment %} .swiper-button-prev,
  .swiper-button-next {
    width: 36px;
    height: 36px;
  }
  
  .swiper-button-prev::after,
  .swiper-button-next::after {
    font-size: 14px;
  } {% endcomment %}
  
  .order-tracking-table-header-line {
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 16px 20px;
  }
  
  .order-tracking-table-header-item-title {
    font-size: 14px;
  }
}

@media (max-width: 480px) {
  .order-tracking-stepper {
    gap: 16px;
  }
  
  .order-tracking-stepper-item {
    min-width: 80px;
  }
  
  .order-tracking-stepper-item-icon-circle {
    width: 36px;
    height: 36px;
  }
  
  .order-tracking-stepper-item-icon-circle-inner {
    width: 24px;
    height: 24px;
  }
  
  .order-tracking-stepper-item-icon-circle-inner-icon {
    width: 14px;
    height: 14px;
  }
  
  .order-tracking-stepper-item-label {
    font-size: 11px;
    max-width: 70px;
  }
}
</style>

<div class="order-tracking-container order-tracking-container-{{ section.id }}">
  <div class="order-tracking-topInfo">
    <div class="order-number">
      Order #676767B
    </div>
    <div class="order-placed-date">
      Placed on: 07/11/2025
    </div>
  </div>
  <div class="order-tracking-stepper-container">
    <div class="order-tracking-stepper-contianer order-tracking-stepper-contianer-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for step in step_names %}
          {% assign step_index = forloop.index0 %}
          {% assign is_complete = false %}
          {% assign is_active = false %}
          {% if step_index < current_step_index %}
            {% assign is_complete = true %}
          {% endif %}
          {% if step_index == current_step_index %}
            {% assign is_active = true %}
          {% endif %}
          <div class="order-tracking-stepper-item swiper-slide{% if is_active %} active{% endif %}{% if is_complete %} completed{% endif %}">
            <div class="order-tracking-stepper-item-icon">
              <div class="order-tracking-stepper-item-icon-circle">
                <div class="order-tracking-stepper-item-icon-circle-inner">
                  <div class="order-tracking-stepper-item-icon-circle-inner-icon">
                    {% if is_complete %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" fill="currentColor"/>
                      </svg>
                    {% else %}
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 22h20L12 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
            <div class="order-tracking-stepper-item-label">
              {{ step }}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-button-prev swiper-button-prev-{{ section.id }}"></div>
      <div class="swiper-button-next swiper-button-next-{{ section.id }}"></div>
      <div class="order-tracking-stepper-progress">
        <div class="order-tracking-stepper-progress-bar">
          <div class="order-tracking-stepper-progress-bar-fill" style="width: {{ progress_percentage }}%"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="order-tracking-table-container">
    <div class="order-tracking-table-header">
      <div class="order-tracking-table-header-line">
        <div class="order-tracking-table-header-item-title label-product">
          Product
        </div>
        <div class="order-tracking-table-header-item-title label-price">
          Price
        </div>
        <div class="order-tracking-table-header-item-title label-quantity">
          Quantity
        </div>
        <div class="order-tracking-table-header-item-title label-total">
          Total
        </div>
      </div>
    </div>
    <div class="order-tracking-table-body">
      Order details will be displayed here
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const orderTrackingStepper = new Swiper(".order-tracking-stepper-contianer-{{ section.id }}", {
      slidesPerView: 'auto',
      spaceBetween: 10,
      navigation: {
        nextEl: '.swiper-button-next-{{ section.id }}',
        prevEl: '.swiper-button-prev-{{ section.id }}',
      }
    });
  });
</script>

{% schema %}
{
  "name": "Order Tracking",
  "settings": [
    {
      "type": "text",
      "id": "order_date",
      "label": "Order Date"
    },
    {
      "type": "checkbox",
      "id": "bifm_order",
      "label": "BIFM Order",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "custom_order",
      "label": "Custom Order",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "expedited_order",
      "label": "Expedited Order",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_steps_text",
      "label": "Custom Steps Text",
      "default": "Step 1,Step 2,Step 3,Step 4,Step 5,Step 6,Step 7,Step 8"
    },
    {
      "type": "text",
      "id": "diy_steps_text",
      "label": "DIY Steps Text",
      "default": "Step 1,Step 2,Step 3,Step 4,Step 5,Step 6"
    },
    {
      "type": "range",
      "id": "bifm_days_limit",
      "label": "BIFM Days Limit",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "diy_days_limit",
      "label": "DIY Days Limit",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "expedited_days_limit",
      "label": "Expedited Days Limit",
      "min": 1,
      "max": 7,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Order Tracking"
    }
  ]
}
{% endschema %}