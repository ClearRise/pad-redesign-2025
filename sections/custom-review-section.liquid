<style>
  .custom-review-section {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }
  .custom-review-section__container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_top_desktop }}px;
  }
  .custom-review-image__container{
    width: 50%;
  }
  .custom-review-section__content-inner {
    padding: 0 80px;
  }
  .custom-review-section__content {
    width: 50%;
    padding: 0 40px;
  }
  .custom-review-section__review-stars {
    display: flex;
    align-items: center;
    padding-bottom: 5px;
  }
  .custom-review-section__review-star {
    width: 24px;
    height: 24px;
  }
  .custom-review-section__review-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .custom-review-section__review-name-text {
    font-size: 16px;
    color: #666666;
  }
  .custom-review-section__review-title {
    font-size: 18px;
  }
  .custom-review-section__review-text {
    color: #666666;
    font-size: 16px;
    padding-bottom: 40px;
  }
  .custom-review-section__review {
    text-align: left;
    padding: 20px;
    border: 1px solid rgb(77, 168, 49);
  }
  .custom-review-section__content-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .custom-review-section__title {
    font-size: 32px;
    padding-bottom: 10px;
  }
  .custom-review-section__subtitle {
    font-size: 14px;
    padding-bottom: 5px;
  }
  .custom-review-section__reviews {
    width: 102%;
    {% comment %} position: relative; {% endcomment %}
  }
  .custom-review-section__title-container {
    text-align: center;
  }
  .swiper-button-next-{{ section.id }} {
    right: 0px !important;
    width: 40px;
    height: 40px;
    background-color: #ffffff;
    border-radius: 50%;
    top: 62%;
  }
  .swiper-button-prev-{{ section.id }} {
    left: 0px !important;
    width: 40px;
    height: 40px;
    background-color: #ffffff;
    border-radius: 50%;
    top: 62%;
  }
  .swiper-button-lock {
    display: block !important;
  }
  @media (max-width: 768px) {
    .custom-review-section__container {
      flex-direction: column;
    }
    .custom-review-image__container{
      width: 100%;
      padding-bottom: 20px;
    }
    .custom-review-section__content {
      width: 100%;
    }
    .custom-review-image-container__image {
      padding: 0 20px;
    }
    .custom-review-section__content {
      padding: 0;
    }
    .custom-review-section__title {
      font-size: 24px;
    }
    .custom-review-section__title-container {
      padding-bottom: 20px;
      padding-top: 20px;
    }
    .swiper-button-next-{{ section.id }} {
      right: -5px !important;
      width: 40px;
    }
    .swiper-button-prev-{{ section.id }} {
      left: -5px !important;
      width: 40px;
    }
  }
  @media (max-width: 1440px) {
    .custom-review-section__content-inner {
      padding: 0 60px;
    }
  }
  @media (max-width: 1024px) {
    .custom-review-section__content-inner {
      padding: 0 40px;
    }
  }
  @media (max-width: 768px) {
    .custom-review-section__content-inner {
      padding: 0 20px;
    }
  }
  .custom-review-section__title-mobile {
    display: none;
  }
  .custom-review-section__title-desktop {
    display: block;
  }
  @media (max-width: 768px) {
    .custom-review-section__title-mobile {
      display: block;
    }
    .custom-review-section__title-desktop {
      display: none;
    }
  }
</style>

{% if section.settings.show_top_break_line %}
  <div class="line-break-container-ss">
    <div class="right-line-ss"></div>
    <div class="center-logo-ss">
      <img
        src="https://cdn.shopify.com/s/files/1/2126/0063/files/Logomark_Black_5d072c0b-89e7-43a3-a591-fb57ef92ccfc.svg?v=1756211322"
        width="16px"
        height="16px"
      >
    </div>
    <div class="left-line-ss"></div>
  </div>
{% endif %}

<div class="custom-review-section">
  <div class="custom-review-section__container page-width">
    <div class="custom-review-section__title-container custom-review-section__title-mobile">
      <div class="custom-review-section__subtitle">{{ section.settings.subtitle }}</div>
      <h2 class="custom-review-section__title">{{ section.settings.title }}</h2>
    </div>
    <div class="custom-review-image__container">
      <div class="custom-review-image-container__image">
        <img src="{{ section.settings.main_image | image_url: width: 1000 }}" alt="{{ section.settings.main_image.alt }}">
      </div>
    </div>
    <div class="custom-review-section__content">
      <div class="custom-review-section__content-inner custom-review-section__content-inner-{{ section.id }}">
        <div class="custom-review-section__title-container custom-review-section__title-desktop">
          <div class="custom-review-section__subtitle">{{ section.settings.subtitle }}</div>
          <h2 class="custom-review-section__title">{{ section.settings.title }}</h2>
        </div>
        <div class="custom-review-section__reviews custom-review-section__reviews-{{ section.id }} overflow-hidden">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="custom-review-section__review swiper-slide">
                <div class="custom-review-section__review-stars">
                  {% for i in (1..5) %}
                    <span class="custom-review-section__review-star">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" fill="#FBB040"/>
                      </svg>
                    </span>
                  {% endfor %}
                </div>
                <h3 class="custom-review-section__review-title">{{ block.settings.title }}</h3>
                <div class="custom-review-section__review-text">{{ block.settings.text }}</div>
                <div class="custom-review-section__review-name">
                  <span class="custom-review-section__review-name-text">{{ block.settings.name }}</span>
                  <span class="custom-review-section__review-name-text">Verified Buyer</span>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-button-prev swiper-button-prev-{{ section.id }}">
            {% if section.settings.prev_button_image != blank %}
              <img src="{{ section.settings.prev_button_image | image_url: width: 100 }}" alt="{{ section.settings.prev_button_image.alt }}">
            {% endif %}
          </div>
          <div class="swiper-button-next swiper-button-next-{{ section.id }}">
            {% if section.settings.next_button_image != blank %}
              <img src="{{ section.settings.next_button_image | image_url: width: 100 }}" alt="{{ section.settings.next_button_image.alt }}">
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% if section.settings.show_bottom_break_line %}
  <div class="line-break-container-ss">
    <div class="right-line-ss"></div>
    <div class="center-logo-ss">
      <img
        src="https://cdn.shopify.com/s/files/1/2126/0063/files/Logomark_Black_5d072c0b-89e7-43a3-a591-fb57ef92ccfc.svg?v=1756211322"
        width="16px"
        height="16px"
      >
    </div>
    <div class="left-line-ss"></div>
  </div>
{% endif %}


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiper = new Swiper('.custom-review-section__reviews-{{ section.id }}', {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      navigation: {
        nextEl: '.swiper-button-next-{{ section.id }}',
        prevEl: '.swiper-button-prev-{{ section.id }}',
      },
    });
  });
</script>

{% schema %}
{
  "name": "Custom Review Section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "checkbox",
      "id": "show_top_break_line",
      "label": "Show Top Break Line",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_break_line",
      "label": "Show Bottom Break Line",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "prev_button_image",
      "label": "Prev Button Image"
    },
    {
      "type": "image_picker",
      "id": "next_button_image",
      "label": "Next Button Image"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "text_color_2",
      "label": "Text Color 2"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "default": 20,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Review Section"
    }
  ]
}
{% endschema %}