{% style %}
.shopify-section {
  margin: 0;
  padding: 0;
  width: 100%;
}
{% endstyle %}

<div class="promo-section">
  <div class="promo-content" style="background-color: {{ section.settings.background_color }}">
    <div class="promo-image-wrapper">
      <div class="promo-image" style="min-height: {{ section.settings.desktop_height }}px">
        {% if section.settings.desktop_image != blank %}
          <img src="{{ section.settings.desktop_image | img_url: 'master' }}" 
               alt="{{ section.settings.desktop_image.alt | escape }}"
               loading="lazy"
               style="object-position: {{ section.settings.focal_point }};"
               class="desktop-only">
        {% endif %}
        {% if section.settings.mobile_image != blank %}
          <img src="{{ section.settings.mobile_image | img_url: 'master' }}" 
               alt="{{ section.settings.mobile_image.alt | escape }}"
               loading="lazy"
               style="object-position: {{ section.settings.focal_point }};"
               class="mobile-only">
        {% endif %}
      </div>
    </div>
    <div class="promo-text" style="color: {{ section.settings.text_color }}">
      <div class="text-content">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>
        {% if section.settings.button_text != blank %}
          <div class="promo-button">
            <a href="{{ section.settings.button_link }}" 
               style="background-color: {{ section.settings.button_color }}">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
.promo-section {
  width: 100%;
  margin: 0;
  padding: 0;
}

.promo-content {
  display: flex;
  align-items: stretch;
  width: 100%;
}

.promo-image-wrapper {
  flex: 1;
  padding: 0;
}

.promo-text {
  flex: 1;
  max-width: 500px;
  padding: 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.promo-text h2 {
  font-size: 2.5rem;
  line-height: 1.2;
  margin-bottom: 1rem;
  font-weight: 700;
}

.promo-text p {
  font-size: 1.1rem;
  line-height: 1.5;
  margin-bottom: 1.5rem;
}

.promo-button a {
  display: inline-block;
  padding: 12px 24px;
  color: white;
  text-decoration: none;
  border-radius: 4px;
  font-weight: 600;
  transition: opacity 0.3s ease;
}

.promo-button a:hover {
  opacity: 0.9;
}

.promo-image {
  position: relative;
  height: 100%;
}

.promo-image img {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.mobile-only {
  display: none;
}

@media screen and (max-width: 768px) {
  .promo-content {
    flex-direction: column;
  }

  .promo-text,
  .promo-image {
    max-width: 100%;
  }

  .promo-image {
    min-height: {{ section.settings.mobile_height }}px !important;
  }

  .promo-text {
    padding: 20px;
    text-align: center;
  }

  .promo-text h2 {
    font-size: 2rem;
  }

  .desktop-only {
    display: none;
  }

  .mobile-only {
    display: block;
  }
}
</style>

{% schema %}
{
  "name": "Promotional Section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#ff4400"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Desktop Image Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Mobile Image Height",
      "default": 300
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Image Focus Point",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "top center",
          "label": "Top"
        },
        {
          "value": "bottom center",
          "label": "Bottom"
        },
        {
          "value": "center left",
          "label": "Left"
        },
        {
          "value": "center right",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Black Friday Starts Now"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Gear Built To Last, Prices That Won't"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "UP TO 47% OFF"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "presets": [
    {
      "name": "Promotional Section",
      "category": "Promotional"
    }
  ]
}
{% endschema %}