<div class="promo-section">
  <div class="promo-content" style="background-color: {{ section.settings.background_color }}">
    <div class="promo-image-wrapper">
      {% if section.settings.image != blank %}
        <div class="promo-image">
          <div class="image-container">
            <img src="{{ section.settings.image | img_url: 'master' }}" 
                 alt="{{ section.settings.image.alt | escape }}"
                 loading="lazy">
          </div>
        </div>
      {% endif %}
    </div>
    <div class="promo-text" style="color: {{ section.settings.text_color }}">
      <div class="text-content">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>
        {% if section.settings.button_text != blank %}
          <div class="promo-button">
            <a href="{{ section.settings.button_link }}" 
               style="background-color: {{ section.settings.button_color }}">
              {{ section.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
.promo-section {
  width: 100%;
  margin: 0;
  padding: 0;
}

.promo-content {
  display: flex;
  width: 100%;
  min-height: 500px;
}

.promo-image-wrapper {
  flex: 1;
  position: relative;
}

.promo-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-container {
  width: 100%;
  height: 100%;
}

.promo-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.promo-text {
  flex: 1;
  max-width: 500px;
  display: flex;
  align-items: center;
}

.text-content {
  padding: 60px;
  width: 100%;
}

{% schema %}
{
  "name": "Promotional Section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#ff4400"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Desktop Image Height",
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Mobile Image Height",
      "default": 300
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Black Friday Starts Now"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Gear Built To Last, Prices That Won't"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "UP TO 47% OFF"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Promotional Section",
      "category": "Promotional"
    }
  ]
}
{% endschema %}