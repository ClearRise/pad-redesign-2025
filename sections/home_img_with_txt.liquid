<style>
  .home_img_with_txt {
    background: #000000;
    color: #fff;
    display: flex;
    justify-content: center;
/*     padding-bottom: 60px; */
    padding-top: 60px;
  }
  .img_item_wrap{
  	max-width: 33.33%;
    text-align: center;
    padding: 10px;
    display: block;
    float: left;
    width: 33%;
}
  }
  .sub_title {
    margin-bottom: 10px;
    font-size: 18px;
    font-weight: 600;
  }
  .img_item_wrap img{
    width: 100%;
    aspect-ratio: 1 / 1;
    height: 100%;
    object-fit: cover;
  }
  .sub_description{
  	max-width: 60%;
    margin: auto;
    margin-top: 20px;
    font-size: 16px;
    line-height: 125%;
  }
  @media only screen and (max-width: 767px){
 	.sub_title {
        margin-bottom: 10px;
        font-size: 15px!important;
        min-height: 50px;
    }
    .img_item_wrap{
/*       max-width: 100%!important; */
     }
/*     .img_item_wrap img{
      width: 105px;
   	  height: 105px;
      object-fit: cover;
    } */
    .sub_description{
      max-width: 95%;
      font-size: 15px !important;
    }
    .home_img_with_txt{
    	display: block;
    } 
    .sub_description {
        margin-top: 15px;
        margin-bottom: 35px;
    }    
    
  }
  
</style>  

<section class="section section--{{ section.id }} home_img_with_txt" data-section-id="{{ section.id }}" data-section-type="home-img_with_txt">
 <div class="page-width">
  <div class="img_item_wrap">
    <p class="sub_title">{{section.settings.sub_title1}}</p>
    <img src="{{ section.settings.image_1 | img_url: 'large' }}">
    <p class="sub_description">{{section.settings.text_1}}</p>
  </div>
  <div class="img_item_wrap">
    <p class="sub_title">{{section.settings.sub_title2}}</p>
    <img src="{{ section.settings.image_2 | img_url: 'large' }}">
    <p class="sub_description">{{section.settings.text_2}}</p>
  </div>
  <div class="img_item_wrap">
    <p class="sub_title">{{section.settings.sub_title3}}</p>
    <img src="{{ section.settings.image_3 | img_url: 'large' }}">
    <p class="sub_description">{{section.settings.text_3}}</p>
  </div>
 </div>  
</section>



