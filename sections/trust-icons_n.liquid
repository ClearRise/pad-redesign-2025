<style>
  .trust-icons-section-ss {
    padding-right: 30px;
    padding-left: 30px;
    padding-top: {{ section.settings.top_padding }}px;
    padding-bottom: {{ section.settings.bottom_padding }}px;
  }
  .trust-icons-container-ss {
    display: flex;
    justify-content: space-around;
  }
  .trust-icons-wrapper-ss {
    display: flex;
    max-width: 300px;
    align-items: center;
  }
  .trust-icon-ss {
    width: 40px;
    margin-right: 10px;
    color: #999999;
  }
  .trust-label-ss {
    font-weight: 400;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .trust-icons-wrapper-ss {
      flex-direction: column;
    }
    .trust-icon-ss {
      margin-right: 0px;
      width: 20px;
    }
    .trust-label-ss {
      text-align: center;
    }
    .trust-icons-section-ss {
      padding-right: 10px;
      padding-left: 10px;
      padding-top: {{ section.settings.top_padding | times: 0.4 }}px;
      padding-bottom: {{ section.settings.bottom_padding | times: 0.4 }}px;
    }
    .trust-icons-section-ss img {
      width: 20px;
      height: 20px;
    }
  }
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_background }};
  }
</style>

<div class="trust-icons-section-ss trust-icons-section-ss-{{ section.id }}">
  <div class="trust-icons-container-ss">
    <div class="trust-icons-wrapper-ss">
      <div class="trust-icon-ss">
        {% if section.settings.trust_icon_1_image != blank %}
          <img src="{{ section.settings.trust_icon_1_image | image_url: width: 40 }}" alt="{{ section.settings.trust_icon_1_label }}" width="40" height="40">
        {% else %}
        <svg
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          class="bi bi-gem"
        >
          <path d="M3.1.7a.5.5 0 0 1 .4-.2h9a.5.5 0 0 1 .4.2l2.976 3.974c.149.185.156.45.01.644L8.4 15.3a.5.5 0 0 1-.8 0L.1 5.3a.5.5 0 0 1 0-.6l3-4zm11.386 3.785-1.806-2.41-.776 2.413 2.582-.003zm-3.633.004.961-2.989H4.186l.963 2.995 5.704-.006zM5.47 5.495 8 13.366l2.532-7.876-5.062.005zm-1.371-.999-.78-2.422-1.818 2.425 2.598-.003zM1.499 5.5l5.113 6.817-2.192-6.82L1.5 5.5zm7.889 6.817 5.123-6.83-2.928.002-2.195 6.828z"/>
        </svg>
        {% endif %}
      </div>
      {% if section.settings.trust_icon_1_label != blank %}
        <div class="trust-label-ss">{{ section.settings.trust_icon_1_label }}</div>
      {% else %}
        <div class="trust-label-ss">Exotic Materials</div>
      {% endif %}
    </div>
    <div class="trust-icons-wrapper-ss">
      <div class="trust-icon-ss">
        {% if section.settings.trust_icon_2_image != blank %}
