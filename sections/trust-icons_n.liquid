{% if section.settings.show_bottom_break_line %}
  <div class="line-break-container-ss">
    <div class="right-line-ss"></div>
    <div class="center-logo-ss">
      <img
        src="https://cdn.shopify.com/s/files/1/2126/0063/files/Logomark_Black_5d072c0b-89e7-43a3-a591-fb57ef92ccfc.svg?v=1756211322"
        width="{{ section.settings.top_logo_size }}px"
        height="{{ section.settings.top_logo_size }}px"
      >
    </div>
    <div class="left-line-ss"></div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Trust Icons(new-2)",
  "presets": [
    {
      "name": "Trust Icons(new-2)"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "section_background",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Top Padding",
      "default": 0,
      "unit": "px",
      "max": 100,
      "min": 0
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "Bottom Padding",
      "default": 0,
      "unit": "px",
      "max": 100,
      "min": 0
    },
    {
      "type": "checkbox",
      "id": "show_bottom_break_line",
      "label": "Show Bottom Break Line",
      "default": false
    },
    {
      "type": "range",
      "id": "top_logo_size",
      "label": "Logo Size",
      "min": 10,
      "max": 100,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Trust Icons"
    },
    {
      "type": "image_picker",
      "id": "trust_icon_1_image",
      "label": "Trust Icon 1 Image"
    },
    {
      "type": "text",
      "id": "trust_icon_1_label",
      "label": "Trust Icon 1 Label"
    },
    {
      "type": "image_picker",
      "id": "trust_icon_2_image",
      "label": "Trust Icon 2 Image"
    },
    {
      "type": "text",
      "id": "trust_icon_2_label",
      "label": "Trust Icon 2 Label"
    },
    {
      "type": "image_picker",
      "id": "trust_icon_3_image",
      "label": "Trust Icon 3 Image"
    },
    {
      "type": "text",
      "id": "trust_icon_3_label",
      "label": "Trust Icon 3 Label"
    },
    {
      "type": "image_picker",
      "id": "trust_icon_4_image",
      "label": "Trust Icon 4 Image"
    },
    {
      "type": "text",
      "id": "trust_icon_4_label",
      "label": "Trust Icon 4 Label"
    }
  ]
}
{% endschema %}
