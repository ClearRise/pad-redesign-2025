{%- style -%}
.logo-bar--{{ section.id }} {
  opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
}
.logo-list-new-ss .section-header {
  text-align: left;
  font-size: 14px;
}
.logo-swiper-container-ss .swiper-slide {
  display: flex;
  justify-content: center;
  height: 90px;
}
.logo-list-new-ss .logo-bar {
  justify-content: space-between;
  flex-wrap: unset;
  margin-bottom: 0px;
}

.logo-bar__item {
  flex: 0 1 110px;
  vertical-align: middle;
  margin: 0 15px 20px
}

.logo-list-new-ss .logo-bar__item {
  margin: 0px;
  border: 1px solid grey;
  flex: none;
}

@media only screen and (min-width:769px) {

  .logo-bar__item {
    flex: 0 1 160px;
    margin: 0 20px 30px
  }

  .logo-list-new-ss .logo-bar__item {
    margin: 0px;
  }
}
@media (max-width: 768px) {
  .logo-swiper-container-ss .swiper-slide {
    height: 60px;
  }
  .logo-list-new-ss .section-header {
    margin-bottom: 10px;
    font-size: 18px;
  }
}
{%- endstyle -%}

{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="page-width logo-list-new-ss">
  {%- if section.settings.title != blank -%}
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="logo-swiper-container-ss">
      <div class="logo-bar logo-bar--{{ section.id }} swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="logo-bar__item swiper-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="logo-bar__link">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url }}" loading="lazy">
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

<script>
  
  document.addEventListener("DOMContentLoaded", function () {
    var swiper = new Swiper(".logo-swiper-container-ss", {
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        type: "progressbar", // 🛠 Converts dots into a line
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      breakpoints: {
        // Desktop (768px and above)
        1024: {
          slidesPerView: 5,
          spaceBetween: 20
        },
        // Mobile (below 768px)
        0: {
          slidesPerView: 3,
          spaceBetween: 10
        }
      },
      // 🛠 Fix: Prevent Page Scrolling Issue
      touchStartPreventDefault: false,
      passiveListeners: true
    });
  });
</script>

{% schema %}
  {
    "name": "Logo list(New)",
    "class": "index-section",
    "max_blocks": 10,
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "range",
        "id": "logo_opacity",
        "label": "Logo opacity",
        "default": 76,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "%"
      },
      {
        "type": "checkbox",
        "id": "divider",
        "label": "Show section divider",
        "default": false
      }
    ],
    "blocks": [
      {
        "type": "logo_image",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link",
            "info": "Optional"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Logo list(New)",
        "blocks": [
          {
            "type": "logo_image"
          },
          {
            "type": "logo_image"
          },
          {
            "type": "logo_image"
          },
          {
            "type": "logo_image"
          }
        ]
      }
    ]
  }
{% endschema %}
