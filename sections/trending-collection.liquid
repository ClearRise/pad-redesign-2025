{%- liquid
  assign selected_collection = collection
  if section.settings.collection != blank
    assign selected_collection = section.settings.collection
  endif
-%}

<style>
  .product-grid-container-ss {
    padding-right: {{ section.settings.padding_horizontal }}px;
    padding-left: {{ section.settings.padding_horizontal }}px;
  }
  #CollectionAjaxContent-Nofilter-{{ section.id }} {
    .collection-filter {
      display: none;
    }
  }
</style>

{{ 'main-collection.css' | asset_url | stylesheet_tag: preload:true }}

<div
  class="current collection-content custom_collection_content"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
  data-collection-title="{{ selected_collection.title }}"
>
  <div id="CollectionAjaxContent-Nofilter-{{ section.id }}" class="">
    <div class="product-grid-container-ss">
      {% if section.settings.title != blank %}
      <div class="grid">
        <h2 class="h1 grid__item one-whole">{{section.settings.title}}</h2>
      </div>
      {% endif %}
      
      <div class="grid">
        <div class="grid__item one-whole grid__item--content">
          {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
          {%- assign pageUrl = contentForQuerystring | split:'"pageurl":"' | last | split:'"' | first | split:'.com' | last |
             replace:'\/','/' | 
             replace:'%20',' ' | 
             replace:'\u0026','&'
          -%}
          {% assign limit_part = pageUrl | split: 'limit=' | last %}
          {% assign limit_value = limit_part | split: '&' | first %}
          {%- liquid
            for block in section.blocks
              case block.type
                when 'product_grid'
                  assign limit_value_abs = limit_value | abs
          
                  if limit_value_abs and limit_value_abs > 0
                    assign paginate_by = limit_value
                  else
                    assign paginate_by = block.settings.per_row | times: block.settings.rows_per_page
          
                    if paginate_by == 0 or paginate_by == blank
                      assign paginate_by = 60
                    endif
                  endif
              endcase
            endfor
          -%}


          {%- paginate selected_collection.products by paginate_by -%}
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }} {%- if block.type == 'product-grid' -%}data-scroll-to{%- endif -%}>
              {%- case block.type -%}
              {%- when 'collection_description' -%}
                {%- if selected_collection.description != blank -%}
                  <div class="rte collection__description custom_collection__description">
                    {{ selected_collection.description }}
                  </div>
                {%- endif -%}
              {%- when 'subcollections' -%}
                {%- if paginate.current_page == 1 -%}
                  {%- render 'subcollections', per_row: block.settings.subcollections_per_row -%}
                {%- endif -%}
              {%- when 'product_grid' -%}
                <div data-scroll-to>
                  {% render 'collection-grid_trending',
                    collection: selected_collection,
                    items: selected_collection.products,
                    enable_collection_count: block.settings.enable_collection_count,
                    per_row: block.settings.per_row,
                    mobile_flush_grid: block.settings.mobile_flush_grid,
                    quick_shop_enable: settings.quick_shop_enable,
                    subtitle_type: section.settings.subtitle_type,
                    type_enable: section.settings.type_enable,
                    subtitle_enable: section.settings.subtitle_enable,
                    paginate_by: paginate_by
                  %}
                  {%- if paginate.pages > 1 -%}
                    {%- render 'pagination', paginate: paginate -%}
                  {%- endif -%}
                </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "CollectionPage",
  {% if selected_collection.description != blank %}
    "description": {{ selected_collection.description | strip_html | json }},
  {% endif %}
  {% if page_image %}
    {% assign image_size = page_image.width | append: 'x' %}
    "image": {
      "@type": "ImageObject",
      "height": {{ page_image.height | json }},
      "url": {{ page_image | img_url: image_size | prepend: "https:" | json }},
      "width": {{ page_image.width | json }}
    },
  {% endif %}
  "name": {{ selected_collection.title | json }}
}
</script>

{% schema %}
  {
    "name": "Trending Collection",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection",
        "info": "Select a collection to display. If not selected, the current collection page will be used."
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "range",
        "id": "padding_horizontal",
        "min": 0,
        "max": 100,
        "step": 5,
        "label": "Horizontal Padding",
        "default": 50
      },
      {
        "type": "header",
        "content": "Product item"
      },
      {
        "type": "checkbox",
        "id": "type_enable",
        "label": "Show Set Type"
      },
      {
        "type": "checkbox",
        "id": "subtitle_enable",
        "label": "Show Subtitle"
      }, 
      {
        "type": "select",
        "id": "subtitle_type",
        "label": "Subtitle type",
        "default": "two",
        "options": [
          {
            "value": "two",
            "label": "Two columns"
          },
          {
            "value": "three",
            "label": "Default"
          }
        ]
      },
      {
        "type": "text",
        "id": "custom_badge",
        "label": "Custom badge text"
      },
      {
        "type": "header",
        "content": "Saved Amount Option"
      },      
      {
        "type": "radio",
        "id": "saved_amount_option",
        "label": "Choose Option",
        "default": "basic_logic",
        "options": [
          {
            "value": "basic_logic",
            "label": "Display $ off ( > $100 )"
          },
          {
            "value": "display_price",
            "label": "Display all $ off"
          },
          {
            "value": "display_percentage",
            "label": "Display all % off"
          },
          {
            "value": "display_entries",
            "label": "Display entries"
          } 
        ]
      },
      {
        "type": "range",
        "id": "entries_multiplier",
        "label": "Entries multiplier",
        "default": 1,
        "min": 0.1,
        "max": 10,
        "step": 0.1,
        "info": "Multiplier for converting price to entries (e.g., 2.0 = $100 shows as 200 Entries)"
      },
      {
        "type": "header",
        "content": "loading style"
      },
      {
        "type": "checkbox",
        "id": "load_more",
        "label": "Load more"
      },
      {
        "type": "header",
        "content": "Tryon Badge"
      },
      {
        "type": "checkbox",
        "id": "show_tryon_badge",
        "label": "Show Tryon Badge",
        "default": false
      },
      {
        "type": "text",
        "id": "tryon_badge_text",
        "label": "Tryon Badge Text",
        "default": "Try Free"
      }
    ],
    "blocks": [
      {
        "type": "collection_description",
        "name": "Collection description",
        "limit": 1
      },
      {
        "type": "product_grid",
        "name": "Products",
        "settings": [
          {
            "type": "checkbox",
            "id": "enable_collection_count",
            "label": "Enable collection count",
            "default": true
          },
          {
            "type": "range",
            "id": "per_row",
            "label": "Products per row",
            "default": 4,
            "min": 2,
            "max": 5,
            "step": 1
          },
          {
            "type": "range",
            "id": "rows_per_page",
            "label": "Rows per page",
            "default": 7,
            "min": 3,
            "max": 20,
            "step": 1
          },
          {
            "type": "checkbox",
            "id": "mobile_flush_grid",
            "label": "Flush grid on mobile",
            "default": false
          }
        ],
        "limit": 1
      },
      {
        "type": "subcollections",
        "name": "Subcollections",
        "settings": [
          {
            "type": "paragraph",
            "content": "Links to collections from your menu will appear here. [Learn more](https://archetypethemes.co/blogs/expanse/how-do-i-create-subcollections)"
          },
          {
            "type": "range",
            "id": "subcollections_per_row",
            "label": "Subcollections per row",
            "default": 5,
            "min": 2,
            "max": 5,
            "step": 1
          }
        ],
        "limit": 1
      }
    ],
    "presets": [
      {
        "name": "Trending Collection"
      }
    ]
  }
{% endschema %}
