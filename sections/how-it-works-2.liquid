{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }
  .how-it-works-2-ss-{{ section.id }} {
    {% if section.settings.full_width %}
      width: 100%;
    {% else %}
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
    {% endif %}
    margin: 30px auto !important;
  }
  .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-title {
    font-size: {{ section.settings.title_font_size_desktop }}px;
    color: {{ section.settings.title_color }};
    text-align: center;
    margin-bottom: 20px;
  }
  .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-step-title {
    font-size: {{ section.settings.step_title_font_size_desktop }}px;
    color: {{ section.settings.step_title_color }};
    text-align: center;
  }
  .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-step-description {
    font-size: {{ section.settings.step_description_font_size_desktop }}px;
    color: {{ section.settings.step_description_color }};
    text-align: center;
  }
  .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-steps {
    display: flex;
    gap: 20px;
    margin-top: 8px;
  }
  .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-step {
    flex: 1;
  }
  @media (max-width: 768px) {
    .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-title {
      font-size: {{ section.settings.title_font_size_mobile }}px;
    }
    .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-step-title {
      font-size: {{ section.settings.step_title_font_size_mobile }}px;
    }
    .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-step-description {
      font-size: {{ section.settings.step_description_font_size_mobile }}px;
    }
    .how-it-works-2-ss-{{ section.id }} .how-it-works-2-ss-steps {
      flex-direction: column;
    }
  }
{% endstyle %}

<div class="how-it-works-2-ss how-it-works-2-ss-{{ section.id }}">
  <div class="how-it-works-2-ss-container">
    <div class="how-it-works-2-ss-title">
      {{ section.settings.title }}
    </div>
    <div class="how-it-works-2-ss-steps">
      {% for block in section.blocks %}
        <div class="how-it-works-2-ss-step">
          <div class="how-it-works-2-ss-step-title">{{ block.settings.title }}</div>
          <div class="how-it-works-2-ss-step-description">{{ block.settings.description }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works 2",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "default": 1600,
      "min": 1000,
      "max": 2000,
      "step": 50
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Title Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "label": "Title Font Size (Desktop)",
      "default": 26,
      "min": 8,
      "max": 92,
      "step": 1
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Title Font Size (Mobile)",
      "default": 24,
      "min": 8,
      "max": 92,
      "step": 1
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Step Settings"
    },
    {
      "type": "range",
      "id": "step_title_font_size_desktop",
      "label": "Step Title Font Size (Desktop)",
      "default": 18,
      "min": 8,
      "max": 92,
      "step": 1
    },
    {
      "type": "range",
      "id": "step_title_font_size_mobile",
      "label": "Step Title Font Size (Mobile)",
      "default": 18,
      "min": 8,
      "max": 92,
      "step": 1
    },
    {
      "type": "range",
      "id": "step_description_font_size_desktop",
      "label": "Step Description Font Size (Desktop)",
      "default": 14,
      "min": 8,
      "max": 92,
      "step": 1
    },
    {
      "type": "range",
      "id": "step_description_font_size_mobile",
      "label": "Step Description Font Size (Mobile)",
      "default": 14,
      "min": 8,
      "max": 92,
      "step": 1
    },
    {
      "type": "color",
      "id": "step_description_color",
      "label": "Step Description Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works 2"
    }
  ]
}
{% endschema %}