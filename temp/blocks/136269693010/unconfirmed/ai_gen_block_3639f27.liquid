{% doc %}
  @prompt
    A review carousel section where I can upload individual photos and text to each one. It should show 3 total reviews. On desktop it should show all 3 reviews on the same width and on mobile, there should be an arrow to scroll from 1 to the next
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-review-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-review-carousel__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-review-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-review-carousel__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .ai-review-carousel__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-review-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-review-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-review-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-review-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    justify-content: center;
  }

  .ai-review-carousel__star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.star_color }};
  }

  .ai-review-carousel__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    text-align: center;
  }

  .ai-review-carousel__author-{{ ai_gen_id }} {
    color: {{ block.settings.author_color }};
    font-size: {{ block.settings.author_size }}px;
    font-weight: 600;
    text-align: center;
  }

  .ai-review-carousel__nav-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-review-carousel__grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: hidden;
      scroll-snap-type: x mandatory;
      gap: 20px;
      scroll-behavior: smooth;
    }

    .ai-review-carousel__item-{{ ai_gen_id }} {
      min-width: 100%;
      scroll-snap-align: start;
    }

    .ai-review-carousel__nav-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      margin-top: 30px;
    }

    .ai-review-carousel__nav-button-{{ ai_gen_id }} {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background-color: {{ block.settings.arrow_background }};
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: opacity 0.3s ease;
    }

    .ai-review-carousel__nav-button-{{ ai_gen_id }}:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .ai-review-carousel__nav-button-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
      stroke: {{ block.settings.arrow_color }};
    }

    .ai-review-carousel__dots-{{ ai_gen_id }} {
      display: flex;
      gap: 8px;
    }

    .ai-review-carousel__dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ block.settings.dot_color }};
      opacity: 0.3;
      transition: opacity 0.3s ease;
    }

    .ai-review-carousel__dot-{{ ai_gen_id }}.active {
      opacity: 1;
    }
  }
{% endstyle %}

<review-carousel-{{ ai_gen_id }} class="ai-review-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-review-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-review-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-review-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-review-carousel__grid-{{ ai_gen_id }}" data-carousel>
        {% for i in (1..3) %}
          {% liquid
            assign image_key = 'review_' | append: i | append: '_image'
            assign text_key = 'review_' | append: i | append: '_text'
            assign author_key = 'review_' | append: i | append: '_author'
            assign rating_key = 'review_' | append: i | append: '_rating'

            assign review_image = block.settings[image_key]
            assign review_text = block.settings[text_key]
            assign review_author = block.settings[author_key]
            assign review_rating = block.settings[rating_key]
          %}

          <div class="ai-review-carousel__item-{{ ai_gen_id }}">
            <div class="ai-review-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if review_image %}
                <img
                  src="{{ review_image | image_url: width: 600 }}"
                  alt="{{ review_author | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                  class="ai-review-carousel__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-review-carousel__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-review-carousel__stars-{{ ai_gen_id }}">
              {% for star in (1..review_rating) %}
                <svg class="ai-review-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            {% if review_text != blank %}
              <p class="ai-review-carousel__text-{{ ai_gen_id }}">{{ review_text }}</p>
            {% endif %}

            {% if review_author != blank %}
              <p class="ai-review-carousel__author-{{ ai_gen_id }}">{{ review_author }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="ai-review-carousel__nav-{{ ai_gen_id }}">
        <button
          class="ai-review-carousel__nav-button-{{ ai_gen_id }}"
          data-prev
          aria-label="Previous review"
        >
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18l-6-6 6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="ai-review-carousel__dots-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            <span class="ai-review-carousel__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-dot="{{ i }}"></span>
          {% endfor %}
        </div>

        <button
          class="ai-review-carousel__nav-button-{{ ai_gen_id }}"
          data-next
          aria-label="Next review"
        >
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18l6-6-6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</review-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.totalReviews = 3;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dots = this.querySelectorAll('[data-dot]');

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.navigate(-1));
          this.nextButton.addEventListener('click', () => this.navigate(1));
        }

        this.updateButtons();
      }

      navigate(direction) {
        this.currentIndex += direction;
        
        if (this.currentIndex < 0) {
          this.currentIndex = 0;
        } else if (this.currentIndex >= this.totalReviews) {
          this.currentIndex = this.totalReviews - 1;
        }

        const scrollAmount = this.carousel.children[0].offsetWidth * this.currentIndex;
        this.carousel.scrollTo({
          left: scrollAmount,
          behavior: 'smooth'
        });

        this.updateButtons();
        this.updateDots();
      }

      updateButtons() {
        if (this.prevButton && this.nextButton) {
          this.prevButton.disabled = this.currentIndex === 0;
          this.nextButton.disabled = this.currentIndex === this.totalReviews - 1;
        }
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('review-carousel-{{ ai_gen_id }}', ReviewCarousel{{ ai_gen_id }});
  })();
</script>

