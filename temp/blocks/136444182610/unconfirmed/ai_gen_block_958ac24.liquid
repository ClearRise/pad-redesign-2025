      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "text_shadow_blur",
      "label": "Shadow blur",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "text_shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Subheadline"
    },
    {
      "type": "richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "<p>Welcome to our store</p>"
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "label": "Font size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "spacing_after_subheadline",
      "label": "Spacing below",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Discover Our Collection</p>"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Font size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "spacing_after_headline",
      "label": "Spacing below",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Explore our premium selection of handcrafted jewelry</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
