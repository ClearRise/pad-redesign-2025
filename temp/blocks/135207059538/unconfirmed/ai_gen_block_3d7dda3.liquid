{% doc %}
  @prompt
    Layout & structure
    
    Full-width section with a simple white (or editable) background.
    
    Title at the top left: “Beyond Compare” with an optional small info icon next to it.
    
    Below the title, show a comparison table with 5 columns and 6 rows:
    
    Column 1 = feature labels.
    
    Columns 2–5 = brand columns.
    
    Row 1 = header row for the brand names.
    
    Rows 2–6 = feature rows.
    
    Default content (merchant can change later)
    
    Brand headers row: empty cell in column 1, then: “Quince”, “J.Crew”, “Everlane”, “Todd Snyder”.
    
    Feature labels in column 1:
    
    Price
    
    Savings (%)
    
    100% Grade-A Mongolian Cashmere
    
    Free Shipping
    
    Free Returns
    
    Example values (just as placeholders that can be edited):
    
    Price row: $59.90, $158.00, $188.00, $348.00
    
    Savings row: ●, 62%, 68%, 83%
    
    100% Cashmere row: ●, ✕, ✕, ✕
    
    Free Shipping row: ●, ✕, ●, ●
    
    Free Returns row: 365 days, 30 days, 30 days, 30 days
    
    Design & styling
    
    Looks like a clean comparison table:
    
    Thin horizontal lines between rows.
    
    Column 2 (the main brand) has a very light background highlight behind the entire column.
    
    Use circles or dots for “yes” values and an “×” icon for “no” values.
    
    Text is left-aligned in the first column and centered in the brand columns.
    
    On mobile, stack the content so it is still readable (for example, each feature row can show the brand name above the value, or show the table as horizontally scrollable).
    
    Customization settings in the theme editor
    
    Make all of the following editable in the section settings / blocks:
    
    Section:
    
    Section title text (“Beyond Compare”).
    
    Optional subtitle text under the title.
    
    Colors:
    
    Section background color.
    
    Table border color.
    
    Main text color.
    
    Muted text color.
    
    Highlight background color for the main brand column.
    
    “Yes” dot color.
    
    “No” icon color.
    
    Brands & features:
    
    Brand names for columns 2–5.
    
    For each feature row:
    
    Label text (column 1).
    
    Value in each brand column (free-text, so merchants can type numbers, words, dots, or icons).
    
    Allow merchants to reorder feature rows v, On mobile, please make it so there isn't a scroll option and instead, condense it to only show the main brand column and brand 2 and brand 3 columns
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_bg_color }};
    padding: 40px 20px;
    width: 100%;
  }

  .ai-comparison-table-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-comparison-table-header-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-comparison-table-title-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-comparison-table-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-comparison-table-info-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.text_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    cursor: help;
  }

  .ai-comparison-table-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.muted_text_color }};
    margin: 8px 0 0;
  }

  .ai-comparison-table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-comparison-table-{{ ai_gen_id }} table {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_bg_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} th,
  .ai-comparison-table-{{ ai_gen_id }} td {
    padding: 16px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th {
    font-weight: 600;
    font-size: {{ block.settings.header_font_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th:first-child {
    text-align: left;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody th {
    font-weight: 500;
    font-size: {{ block.settings.body_font_size }}px;
    color: {{ block.settings.text_color }};
    text-align: left;
    white-space: nowrap;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td {
    font-size: {{ block.settings.body_font_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
  }

  .ai-comparison-table-{{ ai_gen_id }} .ai-highlight-column-{{ ai_gen_id }} {
    background-color: {{ block.settings.highlight_bg_color }};
  }

  .ai-comparison-table-yes-icon-{{ ai_gen_id }} {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: {{ block.settings.yes_icon_color }};
  }

  .ai-comparison-table-no-icon-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.no_icon_color }};
    font-size: 18px;
    font-weight: bold;
  }

  .ai-comparison-table-mobile-hide-{{ ai_gen_id }} {
    display: table-cell;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-comparison-table-wrapper-{{ ai_gen_id }} {
      overflow-x: visible;
    }

    .ai-comparison-table-{{ ai_gen_id }} th,
    .ai-comparison-table-{{ ai_gen_id }} td {
      padding: 12px 8px;
      font-size: 14px;
    }

    .ai-comparison-table-{{ ai_gen_id }} thead th {
      font-size: 14px;
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody th {
      font-size: 13px;
    }

    .ai-comparison-table-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-comparison-table-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-comparison-table-mobile-hide-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table-container-{{ ai_gen_id }}">
    <div class="ai-comparison-table-header-{{ ai_gen_id }}">
      <div class="ai-comparison-table-title-wrapper-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-comparison-table-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.show_info_icon %}
          <span class="ai-comparison-table-info-icon-{{ ai_gen_id }}" title="{{ block.settings.info_icon_text }}">i</span>
        {% endif %}
      </div>
      {% if block.settings.subtitle != blank %}
        <p class="ai-comparison-table-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-comparison-table-wrapper-{{ ai_gen_id }}">
      <table>
        <thead>
          <tr>
            <th></th>
            <th class="ai-highlight-column-{{ ai_gen_id }}">{{ block.settings.brand_1_name }}</th>
            <th>{{ block.settings.brand_2_name }}</th>
            <th>{{ block.settings.brand_3_name }}</th>
            <th class="ai-comparison-table-mobile-hide-{{ ai_gen_id }}">{{ block.settings.brand_4_name }}</th>
          </tr>
        </thead>
        <tbody>
          {% for i in (1..6) %}
            {% liquid
              assign feature_label_key = 'feature_' | append: i | append: '_label'
              assign feature_brand1_key = 'feature_' | append: i | append: '_brand1'
              assign feature_brand2_key = 'feature_' | append: i | append: '_brand2'
              assign feature_brand3_key = 'feature_' | append: i | append: '_brand3'
              assign feature_brand4_key = 'feature_' | append: i | append: '_brand4'

              assign feature_label = block.settings[feature_label_key]
              assign feature_brand1 = block.settings[feature_brand1_key]
              assign feature_brand2 = block.settings[feature_brand2_key]
              assign feature_brand3 = block.settings[feature_brand3_key]
              assign feature_brand4 = block.settings[feature_brand4_key]
            %}

            {% if feature_label != blank %}
              <tr>
                <th>{{ feature_label }}</th>
                <td class="ai-highlight-column-{{ ai_gen_id }}">
                  {% if feature_brand1 == 'yes' %}
                    <span class="ai-comparison-table-yes-icon-{{ ai_gen_id }}"></span>
                  {% elsif feature_brand1 == 'no' %}
                    <span class="ai-comparison-table-no-icon-{{ ai_gen_id }}">×</span>
                  {% else %}
                    {{ feature_brand1 }}
                  {% endif %}
                </td>
                <td>
                  {% if feature_brand2 == 'yes' %}
                    <span class="ai-comparison-table-yes-icon-{{ ai_gen_id }}"></span>
                  {% elsif feature_brand2 == 'no' %}
                    <span class="ai-comparison-table-no-icon-{{ ai_gen_id }}">×</span>
                  {% else %}
                    {{ feature_brand2 }}
                  {% endif %}
                </td>
                <td>
                  {% if feature_brand3 == 'yes' %}
                    <span class="ai-comparison-table-yes-icon-{{ ai_gen_id }}"></span>
                  {% elsif feature_brand3 == 'no' %}
                    <span class="ai-comparison-table-no-icon-{{ ai_gen_id }}">×</span>
                  {% else %}
                    {{ feature_brand3 }}
                  {% endif %}
                </td>
                <td class="ai-comparison-table-mobile-hide-{{ ai_gen_id }}">
                  {% if feature_brand4 == 'yes' %}
                    <span class="ai-comparison-table-yes-icon-{{ ai_gen_id }}"></span>
                  {% elsif feature_brand4 == 'no' %}
                    <span class="ai-comparison-table-no-icon-{{ ai_gen_id }}">×</span>
                  {% else %}
                    {{ feature_brand4 }}
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

