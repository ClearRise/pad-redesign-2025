{% doc %}
  @prompt
    Create a product page section “Add & Save” that shows a vertical list of upsell rows (no carousel). Data source is product metafield custom.upsells (list of product references). Hide if empty.
    
    Each row matches the design: image tile on left, title + price + compare-at + badge in middle, toggle switch on right.
    
    Toggle ON adds the upsell product’s first available variant to cart (AJAX ok).
    Toggle OFF removes that same variant from cart.
    
    Include settings for all colors/backgrounds/text/badge/toggle, plus border radius, spacing, and editable header text.
    
    Make it fully responsive and maintain consistent row heights.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign upsell_products = product.metafields.custom.upsells.value %}

{% if upsell_products != blank and upsell_products.size > 0 %}
  {% style %}
    .ai-upsell-container-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      background-color: {{ block.settings.section_background }};
      padding: {{ block.settings.section_padding }}px;
      border-radius: {{ block.settings.section_border_radius }}px;
    }

    .ai-upsell-header-{{ ai_gen_id }} {
      margin: 0 0 {{ block.settings.row_spacing }}px;
      color: {{ block.settings.header_text_color }};
      font-size: {{ block.settings.header_font_size }}px;
      text-align: left;
    }

    .ai-upsell-rows-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      gap: {{ block.settings.row_spacing }}px;
    }

    .ai-upsell-row-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      gap: {{ block.settings.content_spacing }}px;
      background-color: {{ block.settings.row_background }};
      border: 1px solid {{ block.settings.row_border_color }};
      border-radius: {{ block.settings.row_border_radius }}px;
      padding: {{ block.settings.row_padding }}px;
      min-height: 100px;
    }

    .ai-upsell-image-{{ ai_gen_id }} {
      flex-shrink: 0;
      width: {{ block.settings.image_size }}px;
      height: {{ block.settings.image_size }}px;
      border-radius: {{ block.settings.image_border_radius }}px;
      overflow: hidden;
      background-color: {{ block.settings.image_background }};
    }

    .ai-upsell-image-{{ ai_gen_id }} img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ai-upsell-info-{{ ai_gen_id }} {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }

    .ai-upsell-title-{{ ai_gen_id }} {
      margin: 0;
      color: {{ block.settings.title_color }};
      font-size: {{ block.settings.title_font_size }}px;
      line-height: 1.3;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ai-upsell-price-wrapper-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ai-upsell-price-{{ ai_gen_id }} {
      color: {{ block.settings.price_color }};
      font-size: {{ block.settings.price_font_size }}px;
      font-weight: 600;
    }

    .ai-upsell-compare-price-{{ ai_gen_id }} {
      color: {{ block.settings.compare_price_color }};
      font-size: {{ block.settings.compare_price_font_size }}px;
      text-decoration: line-through;
      opacity: 0.7;
    }

    .ai-upsell-badge-{{ ai_gen_id }} {
      display: inline-block;
      padding: 4px 8px;
      background-color: {{ block.settings.badge_background }};
      color: {{ block.settings.badge_text_color }};
      font-size: {{ block.settings.badge_font_size }}px;
      border-radius: {{ block.settings.badge_border_radius }}px;
      font-weight: 600;
    }

    .ai-upsell-toggle-wrapper-{{ ai_gen_id }} {
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .ai-upsell-toggle-{{ ai_gen_id }} {
      position: relative;
      width: {{ block.settings.toggle_width }}px;
      height: {{ block.settings.toggle_height }}px;
      background-color: {{ block.settings.toggle_off_background }};
      border-radius: {{ block.settings.toggle_height }}px;
      cursor: pointer;
      transition: background-color 0.3s ease;
      border: none;
      padding: 0;
    }

    .ai-upsell-toggle-{{ ai_gen_id }}[aria-checked="true"] {
      background-color: {{ block.settings.toggle_on_background }};
    }

    .ai-upsell-toggle-knob-{{ ai_gen_id }} {
      position: absolute;
      top: 3px;
      left: 3px;
      width: calc({{ block.settings.toggle_height }}px - 6px);
      height: calc({{ block.settings.toggle_height }}px - 6px);
      background-color: {{ block.settings.toggle_knob_color }};
      border-radius: 50%;
      transition: transform 0.3s ease;
    }

    .ai-upsell-toggle-{{ ai_gen_id }}[aria-checked="true"] .ai-upsell-toggle-knob-{{ ai_gen_id }} {
      transform: translateX(calc({{ block.settings.toggle_width }}px - {{ block.settings.toggle_height }}px));
    }

    .ai-upsell-loading-{{ ai_gen_id }} {
      opacity: 0.6;
      pointer-events: none;
    }

    @media screen and (max-width: 749px) {
      .ai-upsell-container-{{ ai_gen_id }} {
        padding: {{ block.settings.section_padding | times: 0.7 }}px;
      }

      .ai-upsell-row-{{ ai_gen_id }} {
        gap: {{ block.settings.content_spacing | times: 0.7 }}px;
        padding: {{ block.settings.row_padding | times: 0.7 }}px;
      }

      .ai-upsell-image-{{ ai_gen_id }} {
        width: {{ block.settings.image_size | times: 0.8 }}px;
        height: {{ block.settings.image_size | times: 0.8 }}px;
      }

      .ai-upsell-title-{{ ai_gen_id }} {
        font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
      }

      .ai-upsell-toggle-{{ ai_gen_id }} {
        width: {{ block.settings.toggle_width | times: 0.9 }}px;
        height: {{ block.settings.toggle_height | times: 0.9 }}px;
      }

      .ai-upsell-toggle-knob-{{ ai_gen_id }} {
        width: calc({{ block.settings.toggle_height | times: 0.9 }}px - 6px);
        height: calc({{ block.settings.toggle_height | times: 0.9 }}px - 6px);
      }

      .ai-upsell-toggle-{{ ai_gen_id }}[aria-checked="true"] .ai-upsell-toggle-knob-{{ ai_gen_id }} {
        transform: translateX(calc({{ block.settings.toggle_width | times: 0.9 }}px - {{ block.settings.toggle_height | times: 0.9 }}px));
      }
    }
  {% endstyle %}

  <upsell-section-{{ ai_gen_id }} class="ai-upsell-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.header_text != blank %}
      <h2 class="ai-upsell-header-{{ ai_gen_id }}">{{ block.settings.header_text }}</h2>
    {% endif %}

    <div class="ai-upsell-rows-{{ ai_gen_id }}">
      {% for upsell_product in upsell_products %}
        {% if upsell_product.available %}
          {% assign first_available_variant = upsell_product.selected_or_first_available_variant %}
          {% assign savings = 0 %}
          {% if first_available_variant.compare_at_price and first_available_variant.compare_at_price > first_available_variant.price %}
            {% assign savings = first_available_variant.compare_at_price | minus: first_available_variant.price %}
          {% endif %}

          <div class="ai-upsell-row-{{ ai_gen_id }}" data-product-id="{{ upsell_product.id }}" data-variant-id="{{ first_available_variant.id }}">
            <div class="ai-upsell-image-{{ ai_gen_id }}">
              {% if upsell_product.featured_image %}
                <img
                  src="{{ upsell_product.featured_image | image_url: width: 200 }}"
                  alt="{{ upsell_product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-upsell-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-upsell-info-{{ ai_gen_id }}">
              <h3 class="ai-upsell-title-{{ ai_gen_id }}">{{ upsell_product.title }}</h3>
              
              <div class="ai-upsell-price-wrapper-{{ ai_gen_id }}">
                <span class="ai-upsell-price-{{ ai_gen_id }}">{{ first_available_variant.price | money }}</span>
                
                {% if first_available_variant.compare_at_price and first_available_variant.compare_at_price > first_available_variant.price %}
                  <span class="ai-upsell-compare-price-{{ ai_gen_id }}">{{ first_available_variant.compare_at_price | money }}</span>
                  
                  {% if block.settings.show_badge %}
                    <span class="ai-upsell-badge-{{ ai_gen_id }}">
                      {% if block.settings.badge_type == 'percent' %}
                        {% assign percent = savings | times: 100.0 | divided_by: first_available_variant.compare_at_price | round %}
                        {{ block.settings.badge_text | replace: '[amount]', percent | append: '%' }}
                      {% else %}
                        {{ block.settings.badge_text | replace: '[amount]', savings | money }}
                      {% endif %}
                    </span>
                  {% endif %}
                {% endif %}
              </div>
            </div>

            <div class="ai-upsell-toggle-wrapper-{{ ai_gen_id }}">
              <button
                type="button"
                class="ai-upsell-toggle-{{ ai_gen_id }}"
                role="switch"
                aria-checked="false"
                aria-label="Add {{ upsell_product.title | escape }} to cart"
              >
                <span class="ai-upsell-toggle-knob-{{ ai_gen_id }}"></span>
              </button>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </upsell-section-{{ ai_gen_id }}>

  <script>
    (function() {
      class UpsellSection{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
          this.toggles = this.querySelectorAll('.ai-upsell-toggle-{{ ai_gen_id }}');
          this.cartItems = new Map();
        }

        connectedCallback() {
          this.fetchCartItems().then(() => {
            this.setupToggles();
          });
        }

        async fetchCartItems() {
          try {
            const response = await fetch('/cart.js');
            const cart = await response.json();
            
            cart.items.forEach(item => {
              this.cartItems.set(item.variant_id, item.key);
            });

            this.updateToggleStates();
          } catch (error) {
            console.error('Error fetching cart:', error);
          }
        }

        updateToggleStates() {
          this.toggles.forEach(toggle => {
            const row = toggle.closest('.ai-upsell-row-{{ ai_gen_id }}');
            const variantId = parseInt(row.dataset.variantId);
            
            if (this.cartItems.has(variantId)) {
              toggle.setAttribute('aria-checked', 'true');
            }
          });
        }

        setupToggles() {
          this.toggles.forEach(toggle => {
            toggle.addEventListener('click', async (e) => {
              e.preventDefault();
              
              const row = toggle.closest('.ai-upsell-row-{{ ai_gen_id }}');
              const variantId = parseInt(row.dataset.variantId);
              const isChecked = toggle.getAttribute('aria-checked') === 'true';

              row.classList.add('ai-upsell-loading-{{ ai_gen_id }}');

              try {
                if (isChecked) {
                  await this.removeFromCart(variantId);
                } else {
                  await this.addToCart(variantId);
                }
              } catch (error) {
                console.error('Error updating cart:', error);
              } finally {
                row.classList.remove('ai-upsell-loading-{{ ai_gen_id }}');
              }
            });
          });
        }

        async addToCart(variantId) {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          });

          if (response.ok) {
            const data = await response.json();
            this.cartItems.set(variantId, data.items[0].key);
            
            const toggle = this.querySelector(`[data-variant-id="${variantId}"] .ai-upsell-toggle-{{ ai_gen_id }}`);
            toggle.setAttribute('aria-checked', 'true');

            this.dispatchCartUpdate();
          } else {
            throw new Error('Failed to add to cart');
          }
        }

        async removeFromCart(variantId) {
          const cartKey = this.cartItems.get(variantId);
          
          if (!cartKey) {
            return;
          }

          const response = await fetch('/cart/change.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: cartKey,
              quantity: 0
            })
          });

          if (response.ok) {
            this.cartItems.delete(variantId);
            
            const toggle = this.querySelector(`[data-variant-id="${variantId}"] .ai-upsell-toggle-{{ ai_gen_id }}`);
            toggle.setAttribute('aria-checked', 'false');

            this.dispatchCartUpdate();
          } else {
            throw new Error('Failed to remove from cart');
          }
        }

        dispatchCartUpdate() {
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
            bubbles: true
          }));
        }
      }

      customElements.define('upsell-section-{{ ai_gen_id }}', UpsellSection{{ ai_gen_id }});
    })();
  </script>
{% endif %}

