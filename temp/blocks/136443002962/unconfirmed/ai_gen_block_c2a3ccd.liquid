{% doc %}
  @prompt
    Can you make me a hero image section. 
    
    It needs to have a headline, a subheadline, and a body text. 
    
    Then a button section. 
    
    These should all be customizable (both placement, font, color, etc.) 
    
    The layout should be subheadline on top of headline then body text then button (it'd be nice if we could have the option to have two buttons) 
    , Can You make the buttons side by side on mobile, Can you make it so we can upload a desktop photo and a mobile photo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.hero_height_desktop }}px;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    padding: 40px 20px;
    z-index: 1;
  }

  .ai-hero-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    text-align: {{ block.settings.text_alignment }};
    width: 100%;
  }

  .ai-hero-subheadline-{{ ai_gen_id }} {
    color: {{ block.settings.subheadline_color }};
    font-size: {{ block.settings.subheadline_size }}px;
    font-family: {{ block.settings.subheadline_font.family }}, {{ block.settings.subheadline_font.fallback_families }};
    font-weight: {{ block.settings.subheadline_font.weight }};
    margin: 0 0 {{ block.settings.subheadline_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-hero-headline-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size }}px;
    font-family: {{ block.settings.headline_font.family }}, {{ block.settings.headline_font.fallback_families }};
    font-weight: {{ block.settings.headline_font.weight }};
    margin: 0 0 {{ block.settings.headline_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-hero-body-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    margin: 0 0 {{ block.settings.body_spacing }}px 0;
    line-height: 1.6;
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    flex-wrap: wrap;
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: {{ block.settings.button_border_radius }}px;
  }

  .ai-hero-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
  }

  .ai-hero-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_bg_hover }};
    color: {{ block.settings.button_primary_color_hover }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_bg_hover }};
    color: {{ block.settings.button_secondary_color_hover }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.hero_height_mobile }}px;
    }

    .ai-hero-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      padding: 20px 15px;
    }

    .ai-hero-subheadline-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheadline_size | times: 0.7 }}px;
    }

    .ai-hero-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.6 }}px;
    }

    .ai-hero-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }

    .ai-hero-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.hero_image_desktop %}
      <img
        src="{{ block.settings.hero_image_desktop | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image_desktop.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image_desktop.width }}"
        height="{{ block.settings.hero_image_desktop.height }}"
        class="ai-hero-image-{{ ai_gen_id }} ai-hero-image-desktop-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-image-placeholder-{{ ai_gen_id }} ai-hero-image-desktop-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-empty-state-{{ ai_gen_id }}">
          Add a desktop hero image to get started
        </div>
      </div>
    {% endif %}

    {% if block.settings.hero_image_mobile %}
      <img
        src="{{ block.settings.hero_image_mobile | image_url: width: 1000 }}"
        alt="{{ block.settings.hero_image_mobile.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image_mobile.width }}"
        height="{{ block.settings.hero_image_mobile.height }}"
        class="ai-hero-image-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}"
      >
    {% elsif block.settings.hero_image_desktop %}
      <img
        src="{{ block.settings.hero_image_desktop | image_url: width: 1000 }}"
        alt="{{ block.settings.hero_image_desktop.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image_desktop.width }}"
        height="{{ block.settings.hero_image_desktop.height }}"
        class="ai-hero-image-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-image-placeholder-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-empty-state-{{ ai_gen_id }}">
          Add a mobile hero image
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-hero-content-{{ ai_gen_id }}">
      <div class="ai-hero-text-container-{{ ai_gen_id }}">
        {% if block.settings.subheadline != blank %}
          <div class="ai-hero-subheadline-{{ ai_gen_id }}">
            {{ block.settings.subheadline }}
          </div>
        {% endif %}

        {% if block.settings.headline != blank %}
          <h2 class="ai-hero-headline-{{ ai_gen_id }}">
            {{ block.settings.headline }}
          </h2>
        {% endif %}

        {% if block.settings.body_text != blank %}
          <div class="ai-hero-body-{{ ai_gen_id }}">
            {{ block.settings.body_text }}
          </div>
        {% endif %}

        <div class="ai-hero-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_primary_label != blank %}
            <a
              href="{{ block.settings.button_primary_link }}"
              class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_primary_label }}
            </a>
          {% endif %}

          {% if block.settings.show_secondary_button and block.settings.button_secondary_label != blank %}
            <a
              href="{{ block.settings.button_secondary_link }}"
              class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_secondary_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile image",
      "info": "Optional. Desktop image will be used if not set."
    },
    {
      "type": "range",
      "id": "hero_height_desktop",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Desktop height",
      "default": 600
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "min": 200,
      "max": 700,
      "step": 50,
      "unit": "px",
      "label": "Mobile height",
      "default": 400
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content layout"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Subheadline"
    },
    {
      "type": "richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "<p>Welcome to our store</p>"
    },
    {
      "type": "font_picker",
      "id": "subheadline_font",
      "label": "Font",
      "default": "futura_n4"
    },
    {
      "type": "range",
      "id": "subheadline_size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "subheadline_spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 12
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Discover Our Collection</p>"
    },
    {
      "type": "font_picker",
      "id": "headline_font",
      "label": "Font",
      "default": "futura_n5"
    },
    {
      "type": "range",
      "id": "headline_size",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Font size",
      "default": 56
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "headline_spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Explore our premium selection of handcrafted jewelry designed to make every moment special.</p>"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font",
      "default": "futura_n4"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "body_spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 30
