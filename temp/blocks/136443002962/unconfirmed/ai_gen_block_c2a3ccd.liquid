    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_primary_bg",
      "label": "Background color",
      "default": "#138f7e"
    },
    {
      "type": "color",
      "id": "button_primary_color",
