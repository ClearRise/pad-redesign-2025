      "id": "button_secondary_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_secondary_bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_secondary_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_secondary_bg_hover",
      "label": "Hover background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "button_secondary_color_hover",
      "label": "Hover text color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
