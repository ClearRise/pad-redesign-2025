{%- liquid
  assign output_tab = true
  if title == blank and content == blank
    assign output_tab = false
  endif
-%}
{%- if output_tab -%}
  <div class="collapsibles-wrapper collapsibles-wrapper--border-bottom  style--{{style}}">
    <button type="button"
      class="label collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height {% if force_open %}default-expand{% endif %}" aria-controls="Product-content-{{ id }}">
      {{ title }}
      {%- render 'collapsible-icons' -%}
    </button>
    <div id="Product-content-{{ id }}"
      class="collapsible-content collapsible-content--all">
      <div class="collapsible-content__inner rte">
        {{ content }} 
         {% if readmore %}
             {%- render 'tool-tip-trigger',
                          title: 'read-more',
                          content: size_chart.content,
                          context: 'read-more'
                        -%}
          {% endif %}
      </div>
    </div>
  </div>
{%- endif -%}
