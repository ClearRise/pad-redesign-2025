  {% if settings.show_gift_box and cart.total_price < SecondTierMinRaw %}
    <span class="cart_progress_text cart-shipping__success black_txt first_tier_progress">{{ settings.first_tier_progress }}</span>
  
  {% elsif settings.second_show_gift_box and cart.total_price >= SecondTierMinRaw and cart.total_price < ThirdTierAmountRaw %}
    <p class="cart_progress_text cart-shipping__success black_txt second_tier_progress">{{ settings.second_tier_progress }}</p>
  
  {% elsif settings.third_show_gift_box and cart.total_price >= ThirdTierAmountRaw %}
    <p class="cart_progress_text cart-shipping__success black_txt third_tier_progress">{{ settings.third_tier_progress }}</p>
  {% endif %}
  </span>
      </div>
      {% endcomment %}
      <div class="progress-bar-static-text" id="progress-bar-static-text-inside">
        <span></span>
      </div>
<!--       <div class="cart-shippingThreshold__bar">
        <span class="cart-shippingThreshold__progress"></span>
      </div> -->
      <div class="progress-bar-progress cart-shippingThreshold__progress" style="background-color: rgb(151, 203, 231); background-size: auto 18px; width: 29.1667%;">
        <span></span>
      </div>
      <div class="checkpoint-separator" style="
                        width: 2px;
                        left: 0%;
                        transform: ;
