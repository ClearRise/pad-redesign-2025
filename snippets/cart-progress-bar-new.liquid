       {% else %}
         <img id="SecondTier" class="progress-bar-product-img" src="https://cdn.shopify.com/s/files/1/2126/0063/files/gift.jpg?v=1679941718" width="30px" height="30px" alt="free Gift" > 
       {% endif %}  
        <span title="2 Free Gift">2 Free Gifts </span>
      </div>
       <div class="checkpoint-image-wrapper" style="max-height: 42px;max-width: 50px;left: max(100%, calc(30px / 2));transform: translateY(-50%) translateX(-82%);display: flex;--checkpoint-images-size: 30px">
        <div style="font-size: 12px; position: relative; width: 100%; padding-top: 100%;"> ${{ settings.cart_threshold_amount_third }} </div>
      </div>
      <div class="checkpoint-title" style="top: max(6px, 6px);left: max(100%, calc(var(--width) / 2)); --width: 100%;    width: 100%;transform: translateY(-50%) translateX(-73%);">
       {% if cart.total_price < ThirdTierAmountRaw %}
         <img id="ThirdTier" class="progress-bar-product-img" src="https://cdn.shopify.com/s/files/1/2126/0063/files/gift-grey.jpg?v=1680035764" width="30px" height="30px" alt="free Gift" > 
       {% else %}
         <img id="ThirdTier" class="progress-bar-product-img" src="https://cdn.shopify.com/s/files/1/2126/0063/files/gift.jpg?v=1679941718" width="30px" height="30px" alt="free Gift" > 
