      </div>  
      <div class="checkpoint-title" style="top: max(6px, 6px);left: max(69%, calc(var(--width) / 2)); --width:0px;transform: translateY(-50%) translateX(-100%);">
       {% if cart.total_price < SecondTierMinRaw %}
