      </div>
      <div class="progress-bar-add-2" style="display: none; position: absolute; top: -30px;left: 50%; transform: translateY(-50%) translateX(-50%); z-index: 999;">
        <button onclick="window.pg.addCheckpointToCart(2)" type="button" class="progress-bar-button-add">
          <span> + </span>
        </button>
      </div>
      <div class="checkpoint-image-wrapper" style="max-height: 42px;max-width: 42px;left: max(33%, calc(30px / 2));transform: translateY(-50%) translateX(-50%);display: flex;--checkpoint-images-size: 30px;">
        <div style="font-size: 12px; position: relative; width: 100%; padding-top: 100%;">${{ settings.cart_threshold_amount }}
