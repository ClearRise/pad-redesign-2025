          <p class="gift_box_title_empty">{{ settings.empty_cart_text3 | times: 100 | money_without_trailing_zeros }}</p>
        {% endif %}

        {% if new_total_price >= GiftBoxAmountRaw %}
          <div class="gift_box ffffffffffff">
            {% if first_product_found == false or second_product_found == false %}
              <h5 class="upsell-heading gift_box_title">Gifts will be added at checkout screen</h5>
            {% else %}
              <h5 class="upsell-heading gift_box_title">{{ settings.gift_box_title }}</h5>
            {% endif %}

            <div class="upsell-collection dgCartUpsellCont gift-products pad_10">
              {% comment %} Check if both gifts are already added {% endcomment %}
              {% assign both_gifts_added = false %}
              {% if first_product_found == false and second_product_found == false %}
                {% assign both_gifts_added = true %}
              {% endif %}
              
              {% comment %} Show message if both gifts are added {% endcomment %}
              {% if both_gifts_added %}
                <div class="both-gifts-added-message" style="text-align: center; padding: 20px; background: #f8f9fa; border-radius: 8px; margin-bottom: 20px;">
