<style>
  .upsell-heading {
    letter-spacing: .8px !important;
  }

  .gift_box {
    border-radius: 5px;
    border: 1px solid rgb(123, 139, 157);
    /* background: #f3f3f3; */
  }

  .item_added_to_cart button {
    pointer-events: none;
  }

  .gift_box_title {
    padding-top: 10px;
    color: black;
    /* border-bottom: 1px solid rgb(196, 196, 196); */
    margin: 0;
    font-size: 14px;
    font-weight: 800;
    padding-left: 40px;
    text-align: left;
  }

  .gift_box_title_empty {
    padding-top: 10px;
    color: black;
    margin: 0;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.3px;
    display: none;
  }

  .gift-products .upsell-product {
    background: white;
    margin: 0;
    width: 100% !important;
    display: flex;
    align-items: center;
    flex-direction: column;
    border: 1px solid rgb(224, 230, 235) !important;
    border-radius: 7px;
    min-height: 260px;
  }

  .gift_box .upsell-product-inner.gift-product {
    margin-bottom: 10px;
  }
  .gift_box .upsell-product-inner.gift-product:last-of-type {
    margin-bottom: 0px;
  }
  @media (max-width: 768px) {
    .gift-products .upsell-product {
      flex-direction: row;
      min-height: unset !important;
      padding: 10px !important;
    }
    .gift_box {
      padding: 5px !important;
    }
    .gift_box .upsell-product-inner.gift-product {
      margin-bottom: 10px;
    }
    .gift_box .upsell-product-inner.gift-product:last-of-type {
      margin-bottom: 0px;
    }
  }
  .gift_box .gift-products .upsell-product {
    border-width: none !important;
  }
  .gift_box .upsell-product.dgCartUpsellInner.border_line.mb_10 {
    flex-direction: row;
    min-height: unset !important;
    padding: 10px !important;
  }
  .gift_box_title {
    padding-left: 10px !important;
  }
  @media (min-width: 768px) {
    .gift_box .upsell-product.dgCartUpsellInner.border_line.mb_10 {
      gap: 30px;
    }
  }
  .upsell-product-heading {
    margin-top: 5px;
    border-top: 1px solid #e9e9e9;
    padding-top: 10px;
    margin-bottom: 2px;
  }

  .dgCartUpsell {
    text-align: center;
    /* margin: 25px auto; */
    max-width: 1170px;
    margin-bottom: 0px;
    margin-top: 20px;
  }

  .dgCartUpsellCont {
    margin: 0 auto;
    flex: 1;
  }

  @media (max-width: 768px) {
    .dgCartUpsellCont {
      padding: 0px !important;
      width: 100%;
    }
    .dgCartUpsellCont > * {
      padding: 0px !important;
    }
  }

  .dgCartUpsellInner {
    display: inline-flex;
    margin: 0 auto;
    border: 1px solid #f0f0f0;
  }

  .dgCartUpsellForm {
    max-width: 300px;
    padding: 10px 15px;
    margin: 10px;
  }

  .dgCartUpsellForm * {
    display: block;
    clear: both;
    width: 100%;
    margin-bottom: 15px;
  }

  .dgCartUpsell .dci-title {
    font-size: 14px;
    line-height: 21px;
    min-height: 45px;
  }

  .dgCartUpsellQty {
    display: none !important;
  }

  .dgCartUpsell input[type=number] {
    float: none;
    display: block;
  }

  .dgCartUpsell .btn-primary,
  .dgCartUpsell .btn-primary:hover {
    /* Button styles */
  }

  .overlay {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    position: fixed;
    background: #222222d9;
    z-index: 9999;
  }

  .overlay__inner {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    position: absolute;
  }

  .overlay__content {
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .spinner {
    width: 75px;
    height: 75px;
    display: inline-block;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.05);
    border-top-color: #fff;
    animation: spin 1s infinite linear;
    border-radius: 100%;
    border-style: solid;
  }

  @keyframes spin {
    100% {
      transform: rotate(360deg);
    }
  }

  @media only screen and (max-width: 600px) {
    .upsell-collection .upsell-product .upsell-product-image img {
      width: 100%;
      /* max-width: 80px !important; */
    }
  }

  {% comment %} {% if settings.enable_placing_both_gifts_in_one_step == false %} {% endcomment %}
    .product-2 {
      opacity: 0 !important;
      visibility: hidden !important;
      height: 0 !important;
    }
  {% comment %} {% endif %} {% endcomment %}
  .dgCartUpsellInner {
    padding: 20px 20px 20px 20px !important;
    border-width: 0px !important;
    background: transparent !important;
  }

  @media (max-width: 767px) {
    .gift_box_title {
      font-size: 12px;
    }
    .dgCartUpsell .dci-title {
      font-size: 12px;
    }
  }
</style>

{% assign upsellCollection = 'upsells' %}
{% assign upsellLimit = '3' %}
{% assign upsellTitle = settings.upsell_box_title %}
{% assign upsellAtc = 'Add to cart' %}

<div class="dgCartUpsell dgCartUpSellWrapper appear-delay-3" id="cart_gift_wrap">

  {% assign FirstTierAmountRaw = settings.cart_threshold_amount | times: 100 %}
  {% assign SecondTierMinRaw = 100000000000 %}
  {% assign SecondTierMaxRaw = 100000000000 %}
  {% assign ThirdTierAmountRaw = settings.cart_threshold_amount_third | times: 100 %}

  {% if settings.enable_collection_based_gifts %}
    {% assign show_first_tier = false %}
    {% assign show_second_tier = false %}
    {% assign show_third_tier = false %}

    {% for item in cart.items %}
      {% for collection in settings.first_tier_collections %}
        {% if item.product.collections contains collection %}
          {% assign show_first_tier = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% unless show_first_tier %}
        {% for collection in settings.second_tier_collections %}
          {% if item.product.collections contains collection %}
            {% assign show_second_tier = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endunless %}

      {% unless show_first_tier or show_second_tier %}
        {% for collection in settings.third_tier_collections %}
          {% if item.product.collections contains collection %}
            {% assign show_third_tier = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endunless %}
    {% endfor %}

    {% if show_first_tier %}
      {% assign new_total_price = FirstTierAmountRaw %}
    {% elsif show_second_tier %}
      {% assign new_total_price = SecondTierMinRaw %}
    {% elsif show_third_tier %}
      {% assign new_total_price = ThirdTierAmountRaw %}
    {% endif %}
  {% else %}
    {% assign new_total_price = cart.total_price | minus: hide_price %}
  {% endif %}

  {% if settings.second_show_gift_box %}
    {% assign SecondTierMinRaw = settings.cart_threshold_amount_second | times: 100 %}
  {% endif %}

  {% if settings.third_show_gift_box %}
    {% assign SecondTierMaxRaw = settings.cart_threshold_amount_third | times: 100 %}
  {% endif %}

  {% assign new_total_price = cart.total_price | minus: hide_price %}

  {% if settings.enable_collection_based_gifts %}
    {% if show_first_tier and new_total_price >= FirstTierAmountRaw and new_total_price < SecondTierMinRaw %}
      {% assign show_first_tier = true %}
    {% elsif show_second_tier and new_total_price >= SecondTierMinRaw %}
      {% assign show_second_tier = true %}
    {% elsif show_third_tier and new_total_price >= SecondTierMaxRaw %}
      {% assign show_third_tier = true %}
    {% endif %}

    <script>
      console.log("new total price ----- {{ new_total_price | json }} |||--++ {{ settings.show_gift_box }}")
    </script>
    {% comment %} {% if show_first_tier and settings.show_gift_box %} {% endcomment %}
    {% if settings.show_gift_box or true %}
      <!-- First Tier Gift Box -->
      {% assign GiftBoxAmount = settings.cart_threshold_amount %}
      {% assign GiftBoxAmountRaw = settings.cart_threshold_amount | times: 100 %}
      {% assign GiftBoxAmountMoney = GiftBoxAmountRaw | abs | money_without_trailing_zeros %}
      {% assign already_added = 'Change Gift' %}
      {% assign first_product_found = true %}
      {% assign second_product_found = true %}

      {% if settings['product-handle-1'] %}
        {% assign first_gift_product = settings['product-handle-1'] %}
        {% assign first_gift_product_id = first_gift_product.selected_or_first_available_variant.id %}
        {% for item in cart.items %}
          {% if item.id == first_gift_product_id %}
            {% assign first_product_found = false %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if settings['product-handle-2'] %}
        {% assign second_gift_product = settings['product-handle-2'] %}
        {% assign second_gift_product_id = second_gift_product.selected_or_first_available_variant.id %}
        {% for item in cart.items %}
          {% if item.id == second_gift_product_id %}
            {% assign second_product_found = false %}
          {% endif %}
        {% endfor %}
      {% endif %}

      
      <script>
        console.log("new total price ----- {{ new_total_price | json }} ||| {{ GiftBoxAmountRaw }}")
      </script>

      {% if new_total_price < GiftBoxAmountRaw %}
        <!--
          <h4 class="" style="border-top: 1px solid;padding-top: 10px;margin-bottom: 0px;height: 14px; color: #000;font-size: 17px; letter-spacing: 0.1px;">{{ settings.spend_progress }}</h4>
        -->
        <p class="gift_box_title_empty">{{ settings.empty_cart_text1 }}</p>
        <p class="gift_box_title_empty">{{ settings.empty_cart_text2 }}</p>
        <p class="gift_box_title_empty">{{ settings.empty_cart_text3 }}</p>
      {% endif %}

      {% if new_total_price >= GiftBoxAmountRaw %}
        <div class="gift_box ffffffffffff">
          {% if first_product_found == false or second_product_found == false %}
            <h5 class="upsell-heading gift_box_title">Gifts will be added at checkout screen</h5>
          {% else %}
            <h5 class="upsell-heading gift_box_title">{{ settings.gift_box_title }}</h5>
          {% endif %}

          <div class="upsell-collection dgCartUpsellCont gift-products pad_10">
            {% if settings['product-handle-1'] %}
              {% assign first_gift_product = settings['product-handle-1'] %}
              {% assign first_gift_product_id = first_gift_product.selected_or_first_available_variant.id %}
              {% assign gift_product_found = true %}
              {% for item in cart.items %}
                {% if item.id == first_gift_product_id %}
                  {% assign gift_product_found = false %}
                {% endif %}
              {% endfor %}

              <div
                product-id="{{ first_gift_product_id }}"
                class="upsell-product-inner gift-product upsell_product-{{ first_gift_product_id }} {% if second_product_found == false %}hide{% else %}show{% endif %}"
              >
                <div class="upsell-product dgCartUpsellInner border_line mb_10">
                  <div class="upsell-product-image">
                    <img
                      class="dci-image"
                      src="{{ first_gift_product | img_url: '100x100' }}"
                      alt="{{ first_gift_product.title | escape }}"
                    >
                  </div>
                  <div class="upsell-product-info">
                    <div class="product-title-link">
                      <strong class="dci-title">{{ first_gift_product.title }}</strong>
                    </div>
                    {% if first_gift_product.metafields.custom.description != blank %}
                      <p class="description">
                        {{ first_gift_product.metafields.custom.description | truncate: 100, '. . . ' }}
                      </p>
                    {% endif %}

                    <div class="cart__item-sub">
                      <div class="upsell-product-price aaaaaaaaa">
                        FREE <s>{{ first_gift_product.compare_at_price | money_without_trailing_zeros }}</s>
                      </div>
                    </div>
                  </div>
                  <button
                    {% if first_product_found == false %}
                      data-remove_var="{{ first_gift_product_id }}"
                    {% endif %}
                    data-product-id="{{ first_gift_product_id }}"
                    class="button btn d-block upsell-suggest-product-button {% if first_product_found == false %}change_free_gift{% else %}upsell_button_gtm{% endif %} upsell-add-to-cart"
                    {% if first_gift_product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    {% if first_product_found == false %}
                      {{ already_added }}
                    {% elsif first_gift_product.selected_or_first_available_variant.available == false %}
                      SOLD OUT
                    {% else %}
                      {{ upsellAtc }}
                    {% endif %}
                  </button>
                </div>
              </div>
            {% endif %}

            {% if settings['product-handle-2'] %}
              {% assign second_gift_product = settings['product-handle-2'] %}
              {% assign second_gift_product_id = second_gift_product.selected_or_first_available_variant.id %}
              {% assign gift_product_found = true %}
              {% for item in cart.items %}
                {% if item.id == second_gift_product_id %}
                  {% assign gift_product_found = false %}
                {% endif %}
              {% endfor %}

              <div
                product-id="{{ second_gift_product_id }}"
                class="{% if settings.hide_gift_2 %}product-2{% endif %} upsell-product-inner gift-product upsell_product-{{ second_gift_product_id }} {% if first_product_found == false %}hide{% else %}show{% endif %}"
              >
                <div class="upsell-product dgCartUpsellInner border_line">
                  <div class="upsell-product-image">
                    <img
                      class="dci-image"
                      src="{{ second_gift_product | img_url: '100x100' }}"
                      alt="{{ second_gift_product.title | escape }}"
                    >
                  </div>
                  <div class="upsell-product-info">
                    <div class="product-title-link">
                      <strong class="dci-title">{{ second_gift_product.title }}</strong>
                    </div>
                    {% if second_gift_product.metafields.custom.description != blank %}
                      <p class="description">
                        {{ second_gift_product.metafields.custom.description | truncate: 100, '. . . ' }}
                      </p>
                    {% endif %}
                    <div class="cart__item-sub">
                      <div class="upsell-product-price bbbbbbbbb">
                        FREE <s>{{ second_gift_product.compare_at_price | money_without_trailing_zeros }}</s>
                      </div>
                    </div>
                  </div>
                  <button
                    {% if second_product_found == false %}
                      data-remove_var="{{ second_gift_product_id }}"
                    {% endif %}
                    data-product-id="{{ second_gift_product_id }}"
                    class="upsell-add-to-cart-gift-first {% if second_product_found == false %}change_free_gift{% else %}upsell_button_gtm{% endif %} upsell-add-to-cart"
                    {% if second_gift_product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    {% if second_product_found == false %}
                      {{ already_added }}
                    {% elsif second_gift_product.selected_or_first_available_variant.available == false %}
                      SOLD OUT
                    {% else %}
                      {{ upsellAtc }}
                    {% endif %}
                  </button>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endif %}

    {% if show_second_tier and settings.second_show_gift_box %}
      {% render 'secondtiergift' %}
    {% endif %}

    {% if show_third_tier and settings.third_show_gift_box %}
      {% render 'thirdtiergift' %}
    {% endif %}

    <!--
      <div>
        <h4>Debug Information:</h4>
        <pre>
          show_first_tier: {{ show_first_tier | json }}
          show_second_tier: {{ show_second_tier | json }}
          show_third_tier: {{ show_third_tier | json }}
        </pre>
      </div>
    -->

  {% else %}
    {% if settings.enable_placing_both_gifts_in_one_step == false %}
      {% if settings.show_gift_box and new_total_price >= FirstTierAmountRaw and new_total_price < SecondTierMinRaw %}
        <!-- gift box -->
        {% assign GiftBoxAmount = settings.cart_threshold_amount %}
        {% assign GiftBoxAmountRaw = settings.cart_threshold_amount | times: 100 %}
        {% assign GiftBoxAmountMoney = GiftBoxAmountRaw | abs | money_without_trailing_zeros %}
        {% assign already_added = 'Change Gift' %}
        {% assign first_product_found = true %}
        {% assign second_product_found = true %}

        {% if settings['product-handle-1'] %}
          {% assign first_gift_product = settings['product-handle-1'] %}
          {% assign first_gift_product_id = first_gift_product.selected_or_first_available_variant.id %}
          {% for item in cart.items %}
            {% if item.id == first_gift_product_id %}
              {% assign first_product_found = false %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if settings['product-handle-2'] %}
          {% assign second_gift_product = settings['product-handle-2'] %}
          {% assign second_gift_product_id = second_gift_product.selected_or_first_available_variant.id %}
          {% for item in cart.items %}
            {% if item.id == second_gift_product_id %}
              {% assign second_product_found = false %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if new_total_price < GiftBoxAmountRaw %}
          <!--
            <h4 class="" style="border-top: 1px solid;padding-top: 10px;margin-bottom: 0px;height: 14px; color: #000;font-size: 17px; letter-spacing: 0.1px;">{{ settings.spend_progress }}</h4>
          -->
          <p class="gift_box_title_empty">{{ settings.empty_cart_text1 }}</p>
          <p class="gift_box_title_empty">{{ settings.empty_cart_text2 }}</p>
          <p class="gift_box_title_empty">{{ settings.empty_cart_text3 }}</p>
        {% endif %}

        {% if new_total_price >= GiftBoxAmountRaw %}
          <div class="gift_box ffffffffffff">
            {% if first_product_found == false or second_product_found == false %}
              <h5 class="upsell-heading gift_box_title">Gifts will be added at checkout screen</h5>
            {% else %}
              <h5 class="upsell-heading gift_box_title">{{ settings.gift_box_title }}</h5>
            {% endif %}

            <div class="upsell-collection dgCartUpsellCont gift-products pad_10">
              {% if settings['product-handle-1'] %}
                {% assign first_gift_product = settings['product-handle-1'] %}
                {% assign first_gift_product_id = first_gift_product.selected_or_first_available_variant.id %}
                {% assign gift_product_found = true %}
                {% for item in cart.items %}
                  {% if item.id == first_gift_product_id %}
                    {% assign gift_product_found = false %}
                  {% endif %}
                {% endfor %}

                <div
                  product-id="{{ first_gift_product_id }}"
                  class="upsell-product-inner gift-product upsell_product-{{ first_gift_product_id }} {% if second_product_found == false %}hide{% else %}show{% endif %}"
                >
                  <div class="upsell-product dgCartUpsellInner border_line mb_10">
                    <div class="upsell-product-image">
                      <img
                        class="dci-image"
                        src="{{ first_gift_product | img_url: '100x100' }}"
                        alt="{{ first_gift_product.title | escape }}"
                      >
                    </div>
                    <div class="upsell-product-info">
                      <div class="product-title-link">
                        <strong class="dci-title">{{ first_gift_product.title }}</strong>
                      </div>
                      {% if first_gift_product.metafields.custom.description != blank %}
                        <p class="description">
                          {{ first_gift_product.metafields.custom.description | truncate: 100, '. . . ' }}
                        </p>
                      {% endif %}

                      <div class="cart__item-sub">
                        <div class="upsell-product-price aaaaaaaaa">
                          FREE <s>{{ first_gift_product.compare_at_price | money_without_trailing_zeros }}</s>
                        </div>
                      </div>
                    </div>
                    <button
                      {% if first_product_found == false %}
                        data-remove_var="{{ first_gift_product_id }}"
                      {% endif %}
                      data-product-id="{{ first_gift_product_id }}"
                      class="button btn d-block upsell-suggest-product-button {% if first_product_found == false %}change_free_gift{% else %}upsell_button_gtm{% endif %} upsell-add-to-cart"
                      {% if first_gift_product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      {% if first_product_found == false %}
                        {{ already_added }}
                      {% elsif first_gift_product.selected_or_first_available_variant.available == false %}
                        SOLD OUT
                      {% else %}
                        {{ upsellAtc }}
                      {% endif %}
                    </button>
                  </div>
                </div>
              {% endif %}

              {% if settings['product-handle-2'] %}
                {% assign second_gift_product = settings['product-handle-2'] %}
                {% assign second_gift_product_id = second_gift_product.selected_or_first_available_variant.id %}
                {% assign gift_product_found = true %}
                {% for item in cart.items %}
                  {% if item.id == second_gift_product_id %}
                    {% assign gift_product_found = false %}
                  {% endif %}
                {% endfor %}

                <div
                  product-id="{{ second_gift_product_id }}"
                  class="{% if settings.hide_gift_2 %}product-2{% endif %} upsell-product-inner gift-product upsell_product-{{ second_gift_product_id }} {% if first_product_found == false %}hide{% else %}show{% endif %}"
                >
                  <div class="upsell-product dgCartUpsellInner border_line mb_10">
                    <div class="upsell-product-image">
                      <img
                        class="dci-image"
                        src="{{ second_gift_product | img_url: '100x100' }}"
                        alt="{{ second_gift_product.title | escape }}"
                      >
                    </div>
                    <div class="upsell-product-info">
                      <div class="product-title-link">
                        <strong class="dci-title">{{ second_gift_product.title }}</strong>
                      </div>
                      {% if second_gift_product.metafields.custom.description != blank %}
                        <p class="description">
                          {{ second_gift_product.metafields.custom.description | truncate: 100, '. . . ' }}
                        </p>
                      {% endif %}
                      <div class="cart__item-sub">
                        <div class="upsell-product-price bbbbbbbbb">
                          FREE <s>{{ second_gift_product.compare_at_price | money_without_trailing_zeros }}</s>
                        </div>
                        <button
                          {% if second_product_found == false %}
                            data-remove_var="{{ second_gift_product_id }}"
                          {% endif %}
                          data-product-id="{{ second_gift_product_id }}"
                          class="{% if second_product_found == false %}change_free_gift{% else %}upsell_button_gtm{% endif %} upsell-add-to-cart"
                          {% if second_gift_product.selected_or_first_available_variant.available == false %}
                            disabled
                          {% endif %}
                        >
                          {% if second_product_found == false %}
                            {{ already_added }}
                          {% elsif second_gift_product.selected_or_first_available_variant.available == false %}
                            SOLD OUT
                          {% else %}
                            {{ upsellAtc }}
                          {% endif %}
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endif %}

      {% if settings.second_show_gift_box and new_total_price >= SecondTierMinRaw and new_total_price < SecondTierMaxRaw %}
        {% render 'secondtiergift' %}
      {% endif %}

      {% if settings.third_show_gift_box and new_total_price >= ThirdTierAmountRaw %}
        {% render 'thirdtiergift' %}
      {% endif %}

    {% else %}
      {% comment %} modify code only this block {% endcomment %}
      {% if settings.show_gift_box and new_total_price >= FirstTierAmountRaw and new_total_price < SecondTierMinRaw %}
        <!-- gift box -->
        {% assign GiftBoxAmount = settings.cart_threshold_amount %}
        {% assign GiftBoxAmountRaw = settings.cart_threshold_amount | times: 100 %}
        {% assign GiftBoxAmountMoney = GiftBoxAmountRaw | abs | money_without_trailing_zeros %}
        {% assign already_added = 'Change Gift' %}
        {% assign first_product_found = true %}
        {% assign second_product_found = true %}

        {% if settings['product-handle-1'] %}
          {% assign first_gift_product = settings['product-handle-1'] %}
          {% assign first_gift_product_id = first_gift_product.selected_or_first_available_variant.id %}
          {% for item in cart.items %}
            {% if item.id == first_gift_product_id %}
              {% assign first_product_found = false %}
            {% endif %}
          {% endfor %}
