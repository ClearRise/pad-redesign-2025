                  <p style="margin: 0; color: #6c757d; font-size: 14px;">You've successfully added both free gifts to your cart. They will be included with your order.</p>
                </div>
              {% endif %}
              
              {% comment %} Display first gift - hide if already added {% endcomment %}
              {% if settings['product-handle-1'] %}
                {% assign first_gift_product = settings['product-handle-1'] %}
                {% assign first_gift_product_id = first_gift_product.selected_or_first_available_variant.id %}
                {% assign first_gift_product_found = true %}
                {% for item in cart.items %}
                  {% if item.id == first_gift_product_id %}
                    {% assign first_gift_product_found = false %}
                  {% endif %}
                {% endfor %}

                <div
                  product-id="{{ first_gift_product_id }}"
                  class="upsell-product-inner gift-product upsell_product-{{ first_gift_product_id }} {% if first_gift_product_found == false %}hide{% else %}show{% endif %}"
                >
                  <div class="upsell-product dgCartUpsellInner border_line mb_10">
                    <div class="upsell-product-image">
                      <img
                        class="dci-image"
                        src="{{ first_gift_product | img_url: '100x100' }}"
                        alt="{{ first_gift_product.title | escape }}"
                        width="100"
                        height="100"
                      >
                    </div>
                    <div class="upsell-product-info">
                      <div class="product-title-link">
                        <strong class="dci-title">{{ first_gift_product.title }}</strong>
                      </div>
                      {% if first_gift_product.metafields.custom.description != blank %}
                        <p class="description">
                          {{ first_gift_product.metafields.custom.description | truncate: 100, '. . . ' }}
                        </p>
                      {% endif %}

                      <div class="cart__item-sub">
                        <div class="upsell-product-price aaaaaaaaa">
                          FREE <s>{{ first_gift_product.compare_at_price | money_without_trailing_zeros }}</s>
                        </div>
                      </div>
                    </div>
                    <button
                      {% if first_gift_product_found == false %}
                        data-remove_var="{{ first_gift_product_id }}"
                      {% endif %}
                      data-product-id="{{ first_gift_product_id }}"
                      class="button btn d-block upsell-suggest-product-button {% if first_gift_product_found == false %}change_free_gift{% else %}upsell_button_gtm{% endif %} upsell-add-to-cart"
                      {% if first_gift_product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      {% if first_gift_product_found == false %}
                        {{ already_added }}
                      {% elsif first_gift_product.selected_or_first_available_variant.available == false %}
                        SOLD OUT
                      {% else %}
                        {{ upsellAtc }}
                      {% endif %}
                    </button>
                  </div>
                </div>
              {% endif %}

              {% comment %} Display second gift - hide if already added {% endcomment %}
              {% if settings['product-handle-2'] %}
                {% assign second_gift_product = settings['product-handle-2'] %}
                {% assign second_gift_product_id = second_gift_product.selected_or_first_available_variant.id %}
                {% assign second_gift_product_found = true %}
                {% for item in cart.items %}
                  {% if item.id == second_gift_product_id %}
                    {% assign second_gift_product_found = false %}
                  {% endif %}
                {% endfor %}

                <div
                  product-id="{{ second_gift_product_id }}"
                  class="{% if settings.hide_gift_2 %}product-2{% endif %} upsell-product-inner gift-product upsell_product-{{ second_gift_product_id }} {% if second_gift_product_found == false %}hide{% else %}show{% endif %}"
                >
                  <div class="upsell-product dgCartUpsellInner border_line mb_10">
                    <div class="upsell-product-image">
                      <img
                        class="dci-image"
                        src="{{ second_gift_product | img_url: '100x100' }}"
                        alt="{{ second_gift_product.title | escape }}"
                        width="100"
                        height="100"
                      >
                    </div>
                    <div class="upsell-product-info">
                      <div class="product-title-link">
                        <strong class="dci-title">{{ second_gift_product.title }}</strong>
                      </div>
                      {% if second_gift_product.metafields.custom.description != blank %}
                        <p class="description">
                          {{ second_gift_product.metafields.custom.description | truncate: 100, '. . . ' }}
                        </p>
                      {% endif %}
                      <div class="cart__item-sub">
                        <div class="upsell-product-price bbbbbbbbb">
                          FREE <s>{{ second_gift_product.compare_at_price | money_without_trailing_zeros }}</s>
                        </div>
                      </div>
                    </div>
                    <button
                      {% if second_gift_product_found == false %}
                        data-remove_var="{{ second_gift_product_id }}"
                      {% endif %}
                      data-product-id="{{ second_gift_product_id }}"
                      class="button btn d-block upsell-suggest-product-button {% if second_gift_product_found == false %}change_free_gift{% else %}upsell_button_gtm{% endif %} upsell-add-to-cart"
                      {% if second_gift_product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      {% if second_gift_product_found == false %}
                        {{ already_added }}
                      {% elsif second_gift_product.selected_or_first_available_variant.available == false %}
                        SOLD OUT
                      {% else %}
                        {{ upsellAtc }}
                      {% endif %}
                    </button>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endif %}

      {% if settings.second_show_gift_box and new_total_price >= SecondTierMinRaw and new_total_price < SecondTierMaxRaw %}
        {% render 'secondtiergift_2' %}
      {% endif %}

      {% if settings.third_show_gift_box and new_total_price >= ThirdTierAmountRaw %}
        {% render 'thirdtiergift_2' %}
      {% endif %}
      {% comment %}
        Smart gift removal based on cart level and tier logic
      {% endcomment %}
      
      {% assign cart_items = cart.items | map: 'id' %}
      {% assign cart_total = cart.total_price %}
      
      {% comment %} Define tier thresholds {% endcomment %}
      {% assign first_tier_threshold = settings.cart_threshold_amount | times: 100 %}
      {% assign second_tier_threshold = settings.cart_threshold_amount_second | times: 100 %}
      {% assign third_tier_threshold = settings.cart_threshold_amount_third | times: 100 %}
      
      {% comment %} Get all gift product IDs {% endcomment %}
      {% assign first_tier_product_1_id = settings['product-handle-1'].selected_or_first_available_variant.id %}
      {% assign first_tier_product_2_id = settings['product-handle-2'].selected_or_first_available_variant.id %}
      {% assign second_tier_product_1_id = settings['second_product-handle-1'].selected_or_first_available_variant.id %}
      {% assign second_tier_product_2_id = settings['second_product-handle-2'].selected_or_first_available_variant.id %}
      {% assign third_tier_product_1_id = settings['third_product-handle-1'].selected_or_first_available_variant.id %}
      {% assign third_tier_product_2_id = settings['third_product-handle-2'].selected_or_first_available_variant.id %}
      
      {% assign gifts_to_remove = '' %}
      {% assign current_tier = 0 %}
      
      {% comment %} Determine current cart tier {% endcomment %}
      {% if cart_total >= third_tier_threshold %}
        {% assign current_tier = 3 %}
      {% elsif cart_total >= second_tier_threshold %}
        {% assign current_tier = 2 %}
      {% elsif cart_total >= first_tier_threshold %}
        {% assign current_tier = 1 %}
      {% endif %}
      
      {% comment %} Logic for removing free gifts based on tier rules {% endcomment %}
      
      {% comment %} Rule 1: Remove free gifts from the next higher level {% endcomment %}
      {% if current_tier == 0 %}
        {% comment %} Below tier 1 - remove all gifts from all tiers {% endcomment %}
        {% if cart_items contains first_tier_product_1_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: first_tier_product_1_id | append: ',' %}
        {% endif %}
        {% if cart_items contains first_tier_product_2_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: first_tier_product_2_id | append: ',' %}
        {% endif %}
        {% if cart_items contains second_tier_product_1_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: second_tier_product_1_id | append: ',' %}
        {% endif %}
        {% if cart_items contains second_tier_product_2_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: second_tier_product_2_id | append: ',' %}
        {% endif %}
        {% if cart_items contains third_tier_product_1_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: third_tier_product_1_id | append: ',' %}
        {% endif %}
        {% if cart_items contains third_tier_product_2_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: third_tier_product_2_id | append: ',' %}
        {% endif %}
      {% endif %}
      
      {% if current_tier == 1 %}
        {% comment %} At tier 1 - remove gifts from next higher level (tier 2) {% endcomment %}
        {% if cart_items contains second_tier_product_1_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: second_tier_product_1_id | append: ',' %}
        {% endif %}
        {% if cart_items contains second_tier_product_2_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: second_tier_product_2_id | append: ',' %}
        {% endif %}
        {% comment %} At tier 1 - remove gifts from next higher level (tier 3) {% endcomment %}
        {% if cart_items contains third_tier_product_1_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: third_tier_product_1_id | append: ',' %}
        {% endif %}
        {% if cart_items contains third_tier_product_2_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: third_tier_product_2_id | append: ',' %}
        {% endif %}
      {% endif %}
      
      {% if current_tier == 2 %}
        {% comment %} At tier 2 - remove gifts from next higher level (tier 3) {% endcomment %}
        {% if cart_items contains third_tier_product_1_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: third_tier_product_1_id | append: ',' %}
        {% endif %}
        {% if cart_items contains third_tier_product_2_id %}
          {% assign gifts_to_remove = gifts_to_remove | append: third_tier_product_2_id | append: ',' %}
        {% endif %}
      {% endif %}
      
      {% comment %} Rule 2: Remove gifts from lower levels if there is at least one gift from the current level {% endcomment %}
      
      {% comment %} Check if there's at least one gift from current tier {% endcomment %}
      {% assign has_current_tier_gift = false %}
      {% if current_tier == 1 %}
        {% if cart_items contains first_tier_product_1_id or cart_items contains first_tier_product_2_id %}
          {% assign has_current_tier_gift = true %}
        {% endif %}
      {% elsif current_tier == 2 %}
        {% if cart_items contains second_tier_product_1_id or cart_items contains second_tier_product_2_id %}
          {% assign has_current_tier_gift = true %}
        {% endif %}
      {% elsif current_tier == 3 %}
        {% if cart_items contains third_tier_product_1_id or cart_items contains third_tier_product_2_id %}
          {% assign has_current_tier_gift = true %}
        {% endif %}
      {% endif %}
      
      {% comment %} If there's at least one gift from current tier, remove all gifts from lower tiers {% endcomment %}
      {% if has_current_tier_gift %}
        {% if current_tier >= 2 %}
          {% comment %} Remove tier 1 gifts {% endcomment %}
          {% if cart_items contains first_tier_product_1_id %}
            {% assign gifts_to_remove = gifts_to_remove | append: first_tier_product_1_id | append: ',' %}
          {% endif %}
          {% if cart_items contains first_tier_product_2_id %}
            {% assign gifts_to_remove = gifts_to_remove | append: first_tier_product_2_id | append: ',' %}
          {% endif %}
        {% endif %}
        
        {% if current_tier >= 3 %}
          {% comment %} Remove tier 2 gifts {% endcomment %}
          {% if cart_items contains second_tier_product_1_id %}
            {% assign gifts_to_remove = gifts_to_remove | append: second_tier_product_1_id | append: ',' %}
          {% endif %}
          {% if cart_items contains second_tier_product_2_id %}
            {% assign gifts_to_remove = gifts_to_remove | append: second_tier_product_2_id | append: ',' %}
          {% endif %}
          {% comment %} Remove tier 1 gifts {% endcomment %}
          {% if cart_items contains first_tier_product_1_id %}
            {% assign gifts_to_remove = gifts_to_remove | append: first_tier_product_1_id | append: ',' %}
          {% endif %}
          {% if cart_items contains first_tier_product_2_id %}
            {% assign gifts_to_remove = gifts_to_remove | append: first_tier_product_2_id | append: ',' %}
          {% endif %}
        {% endif %}
      {% endif %}
      {% comment %} Remove all identified gifts at once using permalink method {% endcomment %}
      {% if gifts_to_remove != '' %}
        {% assign gifts_array = gifts_to_remove | split: ',' %}
        {% assign unique_gifts = '' %}
        
        {% comment %} Remove duplicates {% endcomment %}
        {% for gift_id in gifts_array %}
          {% if gift_id != '' %}
            {% unless unique_gifts contains gift_id %}
              {% assign unique_gifts = unique_gifts | append: gift_id | append: ',' %}
            {% endunless %}
          {% endif %}
        {% endfor %}

        {% assign final_gifts = unique_gifts | split: ',' %}
        
        <script>
          console.log("{{ current_tier }}", "{{ GiftBoxAmountRaw }}");
          console.log("giftsToRemove: ", {{ final_gifts | json }});
          console.log("{{ first_tier_threshold }}", "{{ second_tier_threshold }}", "{{ third_tier_threshold }}");
          (function() {
            const giftsToRemove = {{ final_gifts | json }};
            
            if (giftsToRemove && giftsToRemove.length > 0) {
              console.log('Removing gifts via API sequentially:', giftsToRemove);
              
              // Function to remove all gifts at once
              async function removeAllGiftsAtOnce(giftIds) {
                const validGiftIds = giftIds.filter(giftId => giftId && giftId !== '');
                
                if (validGiftIds.length === 0) {
                  console.log('No valid gifts to remove');
                  return;
                }
                
                console.log('Removing all gifts at once:', validGiftIds);
                
                try {
                  // Create updates object with all gifts set to quantity 0
                  const updates = {};
                  validGiftIds.forEach(giftId => {
                    updates[giftId] = 0;
                  });
                  
                  console.log('Updates payload:', updates);
                  
                  // Make single API request to remove all gifts
                  const response = await fetch('/cart/update.js', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ updates })
                  });
                  
                  if (!response.ok) {
                    throw new Error(`Failed to remove gifts: ${response.status}`);
                  }
                  
                  const data = await response.json();
                  console.log('Successfully removed all gifts:', data);
                  
                } catch (error) {
                  console.error('Error removing gifts:', error);
                  throw error;
                }
              }
                
              console.log('All gift removal requests completed');
                // Trigger cart update event
                {% comment %} document.dispatchEvent(new CustomEvent('cart:updated')); {% endcomment %}
                // Reload the page to reflect all changes
                {% comment %} window.location.reload(); {% endcomment %}
              
              // Start the bulk removal process
              removeAllGiftsAtOnce(giftsToRemove).catch(error => {
                console.error('Error in bulk gift removal:', error);
                // Log error but don't fallback to permalink - rely only on API
                console.log('Gift removal completed with some errors, but continuing...');
              });
              window.location.reload();
            }
          })();
        </script>
      {% endif %}

      {% comment %} end {% endcomment %}
    {% endif %}
  {% endif %}

  {% comment %}UPSELL PRODUCTS{% endcomment %}
  {% assign col_products = '' %}
  {% for collection in collections %}
    {% if collection.handle == upsellCollection %}
      {% for product in collection.products limit: upsellLimit %}
        {% assign variant_product_id = product.selected_or_first_available_variant.id %}
        {% assign col_products = col_products | append: variant_product_id | append: ',' %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% assign upsell_product_found = true %}
  {% assign cartitemsids = cart.items | map: 'id' %}
  {% assign col_products_array = col_products | split: ',' %}
  {% for item in cart.items %}
    {% for col_product in col_products_array %}
      {% assign col_products_int = col_product | times: 1 %}
      {% assign col_products_comma = col_product | append: ',' %}
      {% if col_products_int == item.id %}
        {% assign col_products = col_products | replace: col_products_comma, '' %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% if settings.show_fbt %}
    {% if new_total_price < FirstTierAmountRaw %}
      <div class="upsell_box">
        {% unless col_products == '' %}
          <h4 class="upsell-heading upsell-product-heading" style="color:black;">{{ upsellTitle }}</h4>
        {% endunless %}
        <div class="upsell-collection dgCartUpsellCont">
          {% for collection in collections %}
            {% if collection.handle == upsellCollection %}
              {% for product in collection.products limit: upsellLimit %}
                {% assign product_id = product.selected_or_first_available_variant.id %}
                {% assign product_found = true %}
                {% for item in cart.items %}
                  {% if item.id == product_id %}
                    {% assign product_found = false %}
                  {% endif %}
                {% endfor %}

                <div
                  product-id="{{ product_id }}"
                  class="upsell-product-inner upsell_product-{{ product_id }} show {% if product_found %}{% else %}hide{% endif %}"
                >
                  <div class="upsell-product dgCartUpsellInner">
                    <div class="upsell-product-image">
                      <!--
                        <img class="dci-image" src="{{ product | img_url: '100x100' }}" alt="{{ product.title | escape }}">
                      -->
                      <img
                        class="dci-image lazyload"
                        src="{{ product | img_url: '100x100' }}"
                        data-src="{{ product | img_url: '100x100' }}"
                        data-aspectratio="1"
                        data-sizes="auto"
                        width="100"
                        height="100"
                        alt="{{ product.title | escape }}"
                        loading="lazy"
                      >
                      {% comment %}
                        <div class="upsell-product-price">
                          {{ product.price | money_without_trailing_zeros }}
                        </div>
                      {% endcomment %}
                    </div>
                    <div class="upsell-product-info">
                      <div class="product-title-link">
                        <strong class="dci-title">{{ product.title }}</strong>
                      </div>
                      {% if product.metafields.custom.description != blank %}
                        <p class="description">
                          {{ product.metafields.custom.description | truncate: 100, '. . . ' }}
                        </p>
                      {% endif %}
                      <div class="cart__item-sub">
                        <div class="upsell-product-price cccccccc">
                          {{ product.price | money_without_trailing_zeros }}
                          {% if product.compare_at_price > product.price %}
                            <span id="PriceA11y" class="visually-hidden">
                              {{ 'products.general.regular_price' | t }}
                            </span>
                            <span class="product-single__price--wrapper" aria-hidden="false" style="margin-left: 10px;">
                              <span
                                id="ComparePrice"
                                class="product-single__price--compare-at product__price product__price--compare"
                                style="font-size:14px;color:red"
                              >
                                {{ product.compare_at_price | money_without_trailing_zeros }}
                              </span>
                            </span>
                            <span id="ComparePriceA11y" class="visually-hidden" aria-hidden="false">
                              {{ 'products.general.sale_price' | t }}
                            </span>
                          {% else %}
                            <span id="PriceA11y" class="visually-hidden">
                              {{ 'products.general.regular_price' | t }}
                            </span>
                            <span class="product-single__price--wrapper hide" aria-hidden="true">
                              <span id="ComparePrice" class="product-single__price--compare-at"></span>
                            </span>
                            <span id="ComparePriceA11y" class="visually-hidden" aria-hidden="true">
                              {{ 'products.general.sale_price' | t }}
                            </span>
                          {% endif %}
                        </div>
                        {% if product.selected_or_first_available_variant.inventory_quantity < 1 %}
                          {% assign quick_buy_text = 'product.buttons.sold_out' | t %}
                          {% assign quick_buy_classes = quick_buy_classes | append: ' disabled' %}
                        {% endif %}
                        <div style="display:none;">
                          {{ product.selected_or_first_available_variant.inventory_quantity }}
                        </div>
                        {% if product.selected_or_first_available_variant.inventory_quantity < 1 %}
                          <button
                            data-product-id="{{ product_id }}"
                            class="button btn d-block upsell-suggest-product-button upsell_button_gtm upsell-add-to-cart disabled"
                            disabled
                          >
                            SOLD OUT
                          </button>
                        {% else %}
                          <button
                            data-product-id="{{ product_id }}"
                            class="first-gift-label button btn d-block upsell-suggest-product-button upsell_button_gtm upsell-add-to-cart"
                          >
                            {{ upsellAtc }}
                          </button>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}
</div>
