<style>
  .upsell-heading {
    letter-spacing: .8px !important;
  }
    .gift_box {
/*         border-radius: 3px;
        border: 1px solid rgb(196, 196, 196); */
        background: #f3f3f3;
    } 

  .item_added_to_cart button {
     pointer-events: none;
    }

    .gift_box_title{
      padding-top: 10px;
      color: black;
      /* border-bottom: 1px solid rgb(196, 196, 196); */
      margin: 0;
      font-size: 18px;
      font-weight: 800;
    }
  
  .gift_box_title_empty{
      padding-top: 10px;
      color: black;
      margin: 0;
      font-size: 18px;
      font-weight: 400;
     letter-spacing: 0.3px;
      display: none;
    }
  .gift-products .upsell-product {
      background: white;
      margin: 0;
      width: 100% !important;
  }
  .upsell-product-heading {
    margin-top: 5px;
    border-top: 1px solid #e9e9e9;
    padding-top: 10px;
    margin-bottom: 2px;
  }
  
    .dgCartUpsell {
        text-align: center;
/*         margin: 25px auto; */
        max-width: 1170px;
      margin-bottom: 0px;
    }
    .dgCartUpsellCont {
        margin: 0 auto;
    }
    .dgCartUpsellInner {
        display: inline-flex;
        margin: 0 auto;
        border: 1px solid #f0f0f0;
    }
    .dgCartUpsellForm {
        max-width: 300px;
        padding: 10px 15px;
        margin: 10px;
    }
    .dgCartUpsellForm * {
        display: block;
        clear: both;
        width: 100%;
        margin-bottom: 15px;
    }
    .dgCartUpsell .dci-title {
        font-size: 16px;
        line-height: 21px;
        min-height: 45px;
    }
    .dgCartUpsellQty {
        display: none !important;
    }
    .dgCartUpsell input[type=number] {
        float: none;
        display: block;
    }
    .dgCartUpsell .btn-primary,
    .dgCartUpsell .btn-primary:hover {}
    .overlay {
          left: 0;
          top: 0;
          width: 100%;
          height: 100%;
          position: fixed;
          background: #222222d9;
          z-index: 9999;
      }
      
      .overlay__inner {
          left: 0;
          top: 0;
          width: 100%;
          height: 100%;
          position: absolute;
      }
      
      .overlay__content {
          left: 50%;
          position: absolute;
          top: 50%;
          transform: translate(-50%, -50%);
      }
      
      .spinner {
          width: 75px;
          height: 75px;
          display: inline-block;
          border-width: 2px;
          border-color: rgba(255, 255, 255, 0.05);
          border-top-color: #fff;
          animation: spin 1s infinite linear;
          border-radius: 100%;
          border-style: solid;
      }
      
      @keyframes spin {
        100% {
          transform: rotate(360deg);
        }
      }


  @media  only screen and (max-width: 600px){
    .upsell-collection .upsell-product .upsell-product-image img {
    width: 100%;
    max-width: 80px !important;
}
  }
   .product-2 {
    opacity: 0 !important;
    visibility: hidden !important;
    height: 0 !important;
  } 
</style>
{% assign upsellCollection = "upsells" %}
{% assign upsellLimit = "3" -%}
{% assign upsellTitle =  settings.upsell_box_title  %}
{% assign upsellAtc = "Add to cart" %}

<div class="dgCartUpsell dgCartUpSellWrapper  appear-delay-3" id="cart_gift_wrap">
    <!-- <div class="overlay" style="display:none;">
      <div class="overlay__inner">
          <div class="overlay__content"><span class="spinner"></span></div>
      </div>
    </div> -->

    {% assign FirstTierAmountRaw = settings.cart_threshold_amount | times:100 %}
    {% assign SecondTierMinRaw = 100000000000 %}
    {% assign SecondTierMaxRaw = 100000000000 %}
    {% assign ThirdTierAmountRaw = settings.cart_threshold_amount_third | times:100 %}

    {% if settings.enable_collection_based_gifts %}
      {% assign show_first_tier = false %}
      {% assign show_second_tier = false %}
      {% assign show_third_tier = false %}
      
      {% for item in cart.items %}
        {% for collection in settings.first_tier_collections %}
          {% if item.product.collections contains collection %}
            {% assign show_first_tier = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        
        {% unless show_first_tier %}
          {% for collection in settings.second_tier_collections %}
            {% if item.product.collections contains collection %}
              {% assign show_second_tier = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endunless %}
        
        {% unless show_first_tier or show_second_tier %}
          {% for collection in settings.third_tier_collections %}
            {% if item.product.collections contains collection %}
              {% assign show_third_tier = true %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endunless %}
      {% endfor %}
    
      {% if show_first_tier %}
        {% assign new_total_price = FirstTierAmountRaw %}
      {% elsif show_second_tier %}
        {% assign new_total_price = SecondTierMinRaw %}
      {% elsif show_third_tier %}
        {% assign new_total_price = ThirdTierAmountRaw %}
      {% endif %}
    {% else %}
      {% assign new_total_price = cart.total_price | minus: hide_price %}
    {% endif %}

  

    {% if settings.second_show_gift_box %}
       {% assign SecondTierMinRaw = settings.min_cart_threshold_amount | times:100 %}
    {% endif %}

    {% if settings.third_show_gift_box %}
       {% assign SecondTierMaxRaw = settings.max_cart_threshold_amount | times:100 %}
    {% endif %}

    
    {% assign new_total_price = cart.total_price | minus: hide_price %}
    <script>console.log({{new_total_price | json}})</script>

    {% comment %} -------------------------------------------------------- {% endcomment %}
    {%- liquid
      if settings.enable_rewards_bar
        assign enable_rewards_bar = settings.enable_rewards_bar
      else
        assign enable_rewards_bar = true
      endif
    -%}
    {% if enable_rewards_bar and settings.show_gift_box %}
      <style>
        .upcart-rewards * {
          box-sizing: border-box;
        }
        .upcart-rewards p {
          margin: 0;
        }
        .UpcartDesignSettings__cartTextColor {
          color: #212322;
        }
        .styles_TieredRewards__ {
            font-size: 15px;
          line-height: 20px;
          padding-top: 5px;
          text-align: center;
        }
        .upcart-rewards-message p,
        .upcart-rewards-message p span {
          font-family: 'Gelica', sans-serif !important;
          font-size: 15px !important;
        }
        .styles_TieredRewards__progressBar__ {
          background: #e4e5e7;
          {% comment %} border-radius: 16px; {% endcomment %}
          height: 10px;
          margin-top: 22.5px;
          overflow: hidden;
          width: 100%;
        }
        .styles_Rewards__progressBar--progress__:empty {
          display: block;
        }
        .styles_Rewards__progressBar--progress__ {
          background-color: #93d3ff;
          height: inherit;
          overflow: hidden;
          transition: all .5s ease 0s;
        }
        .styles_TieredRewards__tiersContainer__ {
          display: flex;
          justify-content: space-between;
          margin-top: -25px;
        }
        .styles_TieredRewards__tierCircleAndDescription--leftOfCenter__ {
          margin-left: -20px;
          transform: translate(20px);
        }
        .styles_TieredRewards__tierCircleAndDescription__ {
          align-items: center;
          display: flex;
          flex-direction: column;
          max-height: 100px;
          max-width: 75px;
          min-width: 75px;
          width: 75px;
        }
        .styles_rewardsDescription__ {
          word-wrap: normal;
          font-size: x-small;
          line-height: 1.25;
          margin-top: 5px;
        }
        .styles_TieredRewards__tierCircle__ {
          border-radius: 50%;
          display: flex;
          height: 40px;
          margin-left: 2.5px;
          margin-right: 2.5px;
          width: 40px;
        }
      </style>
      {% comment %} vaildation gift box {% endcomment %}
      {%- liquid
        assign first_show_gift_box = settings.show_gift_box
        assign second_show_gift_box = settings.second_show_gift_box
        assign third_show_gift_box = settings.third_show_gift_box
        assign show_gift_box = first_show_gift_box

        assign first_cart_threshold_amount = settings.cart_threshold_amount | times: 100
        assign second_cart_threshold_amount = settings.cart_threshold_amount_second | times: 100
        assign third_cart_threshold_amount = settings.cart_threshold_amount_third | times: 100

        assign total_gift_box_amount = first_cart_threshold_amount
        if second_show_gift_box == true and second_cart_threshold_amount > first_cart_threshold_amount
          assign total_gift_box_amount = second_cart_threshold_amount
        endif
        if third_show_gift_box == true and third_cart_threshold_amount > second_cart_threshold_amount
          assign total_gift_box_amount = third_cart_threshold_amount
        endif

        assign pass_first_tier = false
        if new_total_price >= first_cart_threshold_amount
          assign pass_first_tier = true
        endif
        assign pass_second_tier = false
        if new_total_price >= second_cart_threshold_amount
          assign pass_second_tier = true
        endif
        assign pass_third_tier = false
        if new_total_price >= third_cart_threshold_amount
          assign pass_third_tier = true
        endif

        if pass_first_tier == false
          assign amount_away_number = first_cart_threshold_amount | minus: new_total_price
          assign amount_away = first_cart_threshold_amount | minus: new_total_price | money
          # assign banner_text = "You're " | append: amount_away | append: " away from " | append: "First Tier"
          assign banner_text = settings.top_text | replace: '(amount)', amount_away | replace: '(next)', 'First'
          assign gift_tier_count = 1
        else
          assign banner_text = settings.unlock_text | replace: '(tier?)', ''
        endif
        if second_show_gift_box == true
          assign gift_tier_count = 2
          if pass_second_tier == false and pass_first_tier == true
            assign amount_away_number = second_cart_threshold_amount | minus: new_total_price
            assign amount_away = second_cart_threshold_amount | minus: new_total_price | money
            assign banner_text = settings.top_text | replace: '(amount)', amount_away | replace: '(next)', 'Second'
          endif
          if pass_second_tier == true and pass_first_tier == true
            assign banner_text = settings.unlock_text | replace: '(tier?)', 'Second'
          endif
        endif
        if third_show_gift_box == true
          assign gift_tier_count = 3
          if pass_third_tier == false and pass_second_tier == true
            assign amount_away_number = third_cart_threshold_amount | minus: new_total_price
            assign amount_away = third_cart_threshold_amount | minus: new_total_price | money
            assign banner_text = settings.top_text | replace: '(amount)', amount_away | replace: '(next)', 'Third'
          endif
          if pass_third_tier == true and  pass_second_tier == true
            assign banner_text = settings.unlock_text | replace: '(tier?)', 'Third'
          endif
        endif
        
        assign new_total_price_number = new_total_price | plus: 0
        assign total_gift_box_amount_number = total_gift_box_amount | plus: 0 | times: 1.0
        assign first_cart_threshold_amount_number = first_cart_threshold_amount | plus: 0 | times: 1.0
        assign second_cart_threshold_amount_number = second_cart_threshold_amount | plus: 0 | times: 1.0
        assign third_cart_threshold_amount_number = third_cart_threshold_amount | plus: 0 | times: 1.0

        assign bar_width = new_total_price_number | divided_by: total_gift_box_amount_number | times: 100

        if pass_first_tier == false
          assign bar_width = new_total_price_number | divided_by: first_cart_threshold_amount_number | times: 100 | divided_by: gift_tier_count
        else
          if second_show_gift_box == true and pass_second_tier == false
            assign rest_new_total_price_number = new_total_price_number | minus: first_cart_threshold_amount_number
            assign rest_second_cart_threshold_amount_number = second_cart_threshold_amount_number | minus: first_cart_threshold_amount_number
            assign already_reached_bar = 100 | divided_by: gift_tier_count
            assign bar_width = rest_new_total_price_number | divided_by: rest_second_cart_threshold_amount_number | times: 100 | divided_by: gift_tier_count | plus: already_reached_bar
          else
            if third_show_gift_box == true and pass_third_tier == false
              assign rest_new_total_price_number = new_total_price_number | minus: second_cart_threshold_amount_number
              assign rest_third_cart_threshold_amount_number = third_cart_threshold_amount_number | minus: second_cart_threshold_amount_number
              assign already_reached_bar = 100 | divided_by: gift_tier_count | times: 2
              assign bar_width = rest_new_total_price_number | divided_by: rest_third_cart_threshold_amount_number | times: 100 | divided_by: gift_tier_count | plus: already_reached_bar
            endif
          endif
        endif

        assign purchased_ring = 0
        assign purchased_other_main = 0
        for purchased_product in cart.items
          if purchased_product.product.metafields.custom.product_type != blank
            assign purchased_other_main = purchased_other_main | plus: 1
            assign purchased_main_product_on_cart = purchased_product
            assign purchased_main_product = purchased_product.product
            
            if purchased_product.product.metafields.custom.product_type == "Ring"
              assign purchased_ring = purchased_ring | plus: 1
            else
              assign testvar = "testvar"
              assign testvar = purchased_product.product.metafields.custom.product_type
              for product_type in purchased_product.product.metafields.custom.product_type
                assign testvar = purchased_product.product.metafields.custom.product_type
                if product_type contains "Ring"
                  assign purchased_ring = purchased_ring | plus: 1
                endif
              endfor
            endif

            if purchased_product.product.metafields.custom.product_type contains "Ring"
              assign purchased_ring = purchased_ring | plus: 1
            endif
          endif
        endfor

        assign total_main_products = purchased_other_main

        if total_main_products == 1
          assign will_suggest_upsell = true
          assign will_suggest_upsell_protection_plan = true
          assign will_suggest_upsell_protection_plan_product = all_products[purchased_main_product.metafields.custom.premium_protection_product]
          for property in purchased_main_product_on_cart.properties
            if property[0] == "Protection Plan"
              if property[1] == "Yes"
                assign will_suggest_upsell_protection_plan = false
              endif
            endif
          endfor
          #if purchased_ring == 1
            assign will_suggest_upsell_engraving = false
            for property in purchased_main_product_on_cart.properties
              if property[0] == "engraving"
                if property[1] == ""
                  assign will_suggest_upsell_engraving = true
                endif
              endif
            endfor
          #endif
          assign will_suggest_upsell_glowstone = true
          for property in purchased_main_product_on_cart.properties
            if property[0] == "Glowstone Enhancement"
              if property[1] == "Yes"
                assign will_suggest_upsell_glowstone = false
              endif
            endif
          endfor
        endif

        assign reward_bar_main_color = "#138f7e"
        assign reward_secondary_color = "rgb(238, 238, 238)"
      -%}
      {% comment %} end vaildation gift box {% endcomment %}
      <div class="upcart-rewards styles_TieredRewards__ UpcartDesignSettings__cartTextColor">
        <div class="upcart-rewards-message">
          <p><b>{{ banner_text | replace: '(amount)' }}</b></p>
        </div>
        <div
          class="upcart-rewards-bar-background styles_TieredRewards__progressBar__"
          style="background-color: rgb(238, 238, 238);"
        >
          <div
            class="upcart-rewards-bar-foreground styles_Rewards__progressBar--progress__"
            style="background-color: {{ reward_bar_main_color }}; width: {{ bar_width }}%;"
          ></div>
        </div>
        <div class="styles_TieredRewards__tiersContainer__">
          <div></div>
          <div class="upcart-rewards-tier styles_TieredRewards__tierCircleAndDescription__ styles_TieredRewards__tierCircleAndDescription--leftOfCenter__">
            <div
              class="upcart-rewards-tier-circle styles_TieredRewards__tierCircle__"
              style="fill: {{ reward_bar_main_color }}; background-color: {% if pass_first_tier == false %}{{ reward_secondary_color }}{% else %}{{ reward_bar_main_color }}{% endif %}; border: 2px solid {{ reward_bar_main_color }};"
            >
              <div class="upcart-rewards-tier-icon" style="width: 25px; height: 25px; margin: auto; color: {% if pass_first_tier == false %}{{ reward_bar_main_color }}{% else %}{{ reward_secondary_color }}{% endif %};">
                {% if settings.reward_bar_first_icon != blank %}
                  <img src="{{ settings.reward_bar_first_icon | img_url: 'master' }}">
                {% else %}
                  <svg viewBox="0 0 30 30" fill="currentColor" style="width: 30px; height: 30px; margin: auto; position: relative; top: 1px;">
                    <path d="M12.18 10.79C12.0694 10.7906 11.96 10.7666 11.8598 10.7199C11.7595 10.6733 11.6708 10.605 11.6 10.52L7 5C6.87702 4.8625 6.80902 4.68449 6.80902 4.5C6.80902 4.31552 6.87702 4.13751 7 4L8.82 2.14C8.89109 2.0661 8.97657 2.00757 9.07117 1.96801C9.16577 1.92845 9.26747 1.90871 9.37 1.91H14.89C15.0888 1.91018 15.2795 1.98931 15.42 2.13L17.23 3.93C17.3581 4.06233 17.4338 4.23667 17.443 4.42061C17.4521 4.60454 17.3942 4.78555 17.28 4.93L12.76 10.5C12.6917 10.5885 12.6037 10.6599 12.5031 10.7085C12.4024 10.7571 12.2918 10.7816 12.18 10.78V10.79ZM8.59 4.56L12.17 8.86L15.69 4.52L14.58 3.41H9.69L8.59 4.56Z"/>
                    <path d="M12.14 21.18C10.7295 21.1785 9.35111 20.7593 8.17862 19.9753C7.00613 19.1913 6.09212 18.0775 5.55191 16.7746C5.01171 15.4717 4.8695 14.038 5.14323 12.6543C5.41697 11.2707 6.09439 9.99908 7.09001 9C7.15868 8.92631 7.24148 8.86721 7.33348 8.82622C7.42548 8.78523 7.52479 8.76319 7.62549 8.76141C7.72619 8.75963 7.82622 8.77816 7.91961 8.81588C8.013 8.8536 8.09783 8.90974 8.16905 8.98096C8.24027 9.05218 8.29642 9.13701 8.33414 9.2304C8.37186 9.32379 8.39038 9.42382 8.38861 9.52452C8.38683 9.62523 8.36479 9.72454 8.3238 9.81654C8.2828 9.90854 8.2237 9.99134 8.15001 10.06C7.36462 10.8501 6.83082 11.8551 6.61593 12.9482C6.40104 14.0414 6.5147 15.1737 6.94257 16.2023C7.37044 17.2309 8.09335 18.1097 9.02011 18.728C9.94687 19.3462 11.036 19.6761 12.15 19.6761C13.2641 19.6761 14.3532 19.3462 15.2799 18.728C16.2067 18.1097 16.9296 17.2309 17.3575 16.2023C17.7853 15.1737 17.899 14.0414 17.6841 12.9482C17.4692 11.8551 16.9354 10.8501 16.15 10.06C16.0096 9.91937 15.9307 9.72875 15.9307 9.53C15.9307 9.33125 16.0096 9.14062 16.15 9C16.219 8.92924 16.3014 8.87301 16.3924 8.83461C16.4834 8.79621 16.5812 8.77643 16.68 8.77643C16.7788 8.77643 16.8766 8.79621 16.9676 8.83461C17.0587 8.87301 17.1411 8.92924 17.21 9C18.2091 9.99856 18.8895 11.271 19.1652 12.6564C19.4409 14.0417 19.2995 15.4777 18.7589 16.7827C18.2183 18.0877 17.3027 19.203 16.1281 19.9875C14.9535 20.772 13.5725 21.1905 12.16 21.19L12.14 21.18Z"/>
                  </svg>
                {% endif %}
              </div>
            </div>
            <div class="upcart-rewards-tier-description styles_rewardsDescription__">First Tier</div>
          </div>
          {% if second_show_gift_box == true %}
            <div class="upcart-rewards-tier styles_TieredRewards__tierCircleAndDescription__ styles_TieredRewards__tierCircleAndDescription--leftOfCenter__">
              <div
                class="upcart-rewards-tier-circle styles_TieredRewards__tierCircle__"
                style="fill: {{ reward_bar_main_color }}; background-color: {% if pass_second_tier == false %}{{ reward_secondary_color }}{% else %}{{ reward_bar_main_color }}{% endif %}; border: 2px solid {{ reward_bar_main_color }};"
              >
                <div class="upcart-rewards-tier-icon" style="width: 25px; height: 25px; margin: auto; color: {% if pass_second_tier == false %}{{ reward_bar_main_color }}{% else %}{{ reward_secondary_color }}{% endif %};">
                  {% if settings.reward_bar_second_icon != blank %}
                    <img src="{{ settings.reward_bar_second_icon | img_url: 'master' }}">
                  {% else %}
