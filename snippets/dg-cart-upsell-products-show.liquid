              </p>
            </div>
            <div class="cart__item-sub padding-top-0px price-and-button-container">
              <div class="upsell-product-price">
                {{ upsell_product.selected_or_first_available_variant.price | money }}
                <s
                  ><span class="money">
                    {%- if upsell_product.selected_or_first_available_variant.price
                        != upsell_product.selected_or_first_available_variant.compare_at_price
                    -%}
                      {{- upsell_product.selected_or_first_available_variant.compare_at_price | money -}}
                    {%- endif %}
                  </span></s
                >
              </div>
              <button
                class="button btn d-block upsell-suggest-product-button upsell-suggest-product-button-{{ purchased_main_product_on_cart.id }} upsell-suggest-product-button-{{ purchased_main_product_on_cart.id }}-engraving"
                data-main-product-id="{{ purchased_main_product_on_cart.id }}"
                data-product-id="{{ all_products[settings['product-engraving']].selected_or_first_available_variant.id }}"
                data-main-product-cart-id="{{ purchased_main_product_on_cart.id }}"
              >
                Add To Cart
              </button>
            </div>
          </div>
        </div>
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Ensure the DOM is fully loaded before attaching event listeners
          document.querySelector('.upsell-suggest-product-button-{{ purchased_main_product_on_cart.id }}-engraving').addEventListener('click', function(e) {
            e.preventDefault();
            var mainProductId = this.getAttribute('data-main-product-id');
            var productId = this.getAttribute('data-product-id');
            var mainProductCartId = this.getAttribute('data-main-product-cart-id');
            var customProperties = {{ purchased_main_product_on_cart.properties | json }};
            var customPropertiesJSON = {}
            customProperties.forEach(propert =>
              customPropertiesJSON[propert[0]] = propert[1]
            );
            const customEngravingNote = document.querySelector('.custom-engraving-note').value;
            if (customEngravingNote.trim() === '') {
              document.querySelector('.error-text.empty-text').classList.remove('hide');
              return;
            } else {
              document.querySelector('.error-text.empty-text').classList.add('hide');
            }
            customPropertiesJSON['engraving'] = customEngravingNote;
            fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                items: [{
                  id: productId,
                  quantity: 1
                }]
              })
            })
            .then(response => response.json())
            .then(data => {
              // main product property update
              fetch('/cart/change.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  id: mainProductCartId,
                  properties: customPropertiesJSON
                })
              }).
              then(response => response.json())
              .then(data => {
                console.log('Main product properties updated:', data);
                location.reload(); // Reload the page to reflect changes
              })
              .catch(error => console.error('Error updating main product properties:', error));
            })
            .catch(error => console.error('Error adding product to cart:', error));
          });
        });
      </script>
    {% endif %}
    {% comment %} {% endif %} {% endcomment %}
  </div>
{% endif %}
{% comment %} -------------------------------------------------------- {% endcomment %}
