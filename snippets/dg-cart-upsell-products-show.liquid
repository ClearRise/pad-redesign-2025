  {% assign new_total_price = cart.total_price | minus: hide_price %}
  {% assign third_cart_threshold_amount = settings.cart_threshold_amount_third | times: 100 %}


  {% if new_total_price < third_cart_threshold_amount %}
    <div class="upsells-header-container">
      <div class="upsells-variant-text">Add {{ amount_away }} more to unlock your next reward</div>
      <div class="upsells-text">Choose from these premium selections</div>
    </div>
  {% endif %}

  {% comment %} <div>{{ purchased_main_product_on_cart | json }}</div> {% endcomment %}

  <div class="upsells-container">
    {% if amount_away_number < all_products[settings['product-glowstone']].selected_or_first_available_variant.price
      and will_suggest_upsell_glowstone
    %}
      {% assign upsell_product = all_products[settings['product-glowstone']] %}
      <div class="upsell-collection dgCartUpsellCont gift-products margin-top-10px">
        <div class="upsell-product dgCartUpsellInner  border_line mb_10">
          <div class="upsell-product-image">
            {% comment %} {{ upsell_product.featured_image |  }} {% endcomment %}
            <img
              class="dci-image"
              src="{{ upsell_product.featured_image | img_url: '100x100' }}"
              alt="{{ upsell_product.title | escape }}"
            >
          </div>
          <div class="upsell-product-info">
            <div class="upsell-product-suggest-text product-title-link">
              <span class="suggested-product-title ">
                {% assign upsell_product_price_money = all_products[settings['product-glowstone']].selected_or_first_available_variant.price
                  | divided_by: 100
                %}
                {% comment %} <b>{{ settings.bottom_text | replace: '(upsell_product_title)', 'Glowstone Enhancement' | replace: '(upsell_product_price)', upsell_product_price_money | replace: '(main_product_title)', purchased_main_product.title }}</b> {% endcomment %}
                <div class="main-product-title">{{ purchased_main_product_on_cart.product.title }}</div>
                <div class="upselll-product-title">{{ upsell_product.title }}</div>
              </span>
            </div>
            <div class="cart__item-sub price-and-button-container">
              <div class="upsell-product-price aaaaaaaaa">
                {{ upsell_product.selected_or_first_available_variant.price | money }}
                <s
                  ><span class="money">
                    {%- if upsell_product.selected_or_first_available_variant.price
                        != upsell_product.selected_or_first_available_variant.compare_at_price
                    -%}
                      {%- if upsell_product.selected_or_first_available_variant.price
                          != upsell_product.selected_or_first_available_variant.compare_at_price
                      -%}
                        {{- upsell_product.selected_or_first_available_variant.compare_at_price | money -}}
                      {%- endif -%}
                    {%- endif %}
                  </span></s
                >
              </div>
              <button
                class="button btn d-block upsell-suggest-product-button upsell-suggest-product-button-{{ purchased_main_product_on_cart.id }}"
                data-main-product-id="{{ purchased_main_product_on_cart.id }}"
                data-product-id="{{ all_products[settings['product-glowstone']].selected_or_first_available_variant.id }}"
                data-main-product-cart-id="{{ purchased_main_product_on_cart.id }}"
              >
                Add To Cart
              </button>
            </div>
          </div>
        </div>
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Ensure the DOM is fully loaded before attaching event listeners
          document.querySelector('.upsell-suggest-product-button-{{ purchased_main_product_on_cart.id }}').addEventListener('click', function(e) {
            e.preventDefault();
            var mainProductId = this.getAttribute('data-main-product-id');
            var productId = this.getAttribute('data-product-id');
            var mainProductCartId = this.getAttribute('data-main-product-cart-id');
            var customProperties = {{ purchased_main_product_on_cart.properties | json }};
            var customPropertiesJSON = {}
            customProperties.forEach(propert =>
              customPropertiesJSON[propert[0]] = propert[1]
            );
            customPropertiesJSON['Glowstone Enhancement'] = 'Yes';
            fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                items: [{
                  id: productId,
                  quantity: 1
                }]
              })
            })
            .then(response => response.json())
            .then(data => {
              // main product property update
              fetch('/cart/change.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  id: mainProductCartId,
                  properties: customPropertiesJSON
                })
              }).
              then(response => response.json())
              .then(data => {
                console.log('Main product properties updated:', data);
                location.reload(); // Reload the page to reflect changes
              })
              .catch(error => console.error('Error updating main product properties:', error));
            })
            .catch(error => console.error('Error adding product to cart:', error));
          });
        });
      </script>
    {% endif %}
