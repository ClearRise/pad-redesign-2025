<div
  class="cart__item rm_border {% if hidden %}hide{% endif %}"
  data-quantity="{{ product.quantity }}"
  data-key="{{ product.key }}"
  data-handle="{{ product.product.handle }}"
>
  {%- assign img_url = product | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
  <div class="cart__image">
    <a href="{{ product.url }}" style="height: 0; padding-bottom: {{ 100 | divided_by: product.image.aspect_ratio }}%;">
      <img
        class="lazyload"
        data-src="{{ img_url }}"
        data-widths="[180, 360, 540]"
        data-aspectratio="{{ product.aspect_ratio }}"
        data-sizes="auto"
        alt="{{ product.product.title | escape }}"
      >

      <noscript>
        <img
          class="lazyloaded"
          src="{{ product | img_url: '400x' }}"
          alt="{{ product.product.title | escape }}"
        >
      </noscript>
    </a>
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title ">
      <a href="{{ product.url }}" class="cart__item-name black_txt">
        {{ product.product.title }}
      </a>
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div class="black_txt">
              <span>{{ option.name }}:</span> {{ option.value }}
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      
      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants black_txt">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}
      {%- assign property_size = product.properties | size -%}
      <span class="bold_load_cart_item_properties black_txt"></span>

      {% if property_size > 0 %}
        {% for p in product.properties %}
          {% if product.product.metafields.custom.premium_protection_product %}
            {% if p.first contains 'Protection Plan' %}
              {% unless p.last == '' or p.last == null %}
                {% assign protection_product = all_products[product.product.metafields.custom.premium_protection_product] %}
                {% assign protection_product_id = protection_product.selected_or_first_available_variant.id %}
                {% assign p_product_id = protection_product.selected_or_first_available_variant.id %}
                
                <div class="product-option action_icons">
                  <input type="hidden" name="Protection" class="Protection_p" value="true" data-product-id = "{{ protection_product_id }}">
                </div>
              {% endunless %}
            {% endif %}
          {% endif %}
          
          {% if settings.show_engraving and settings['product-engraving'] %}
            {% if p.first contains 'engraving' %}
              {% unless p.last == '' or p.last == null %}
                {% assign engrave_product = settings['product-engraving'] %}
                {% assign first_gift_product_id_var = engrave_product.selected_or_first_available_variant.id %}
                {% assign e_product_id = engrave_product.selected_or_first_available_variant.id %}
                
                <div class="product-option action_icons">
                  <input type="hidden" name="engraving" class="engraving_p" value="true">
                </div>
              {% endunless %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
      <div class="bold_edit_in_cart"></div>
    </div>
    <div class="cart__item-sub">
      <div>
        <div class="js-qty__wrapper">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input
            type="text"
            {% if match_gift_product %}
              style="pointer-events: none;"
            {% endif %}
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num black_txt"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}"
            data-engraving="{{ e_product_id }}"
            data-protection="{{ p_product_id }}"
            data-quantity="{{ product.quantity }}"
          >
          <button
            type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}"
          >
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20">
              <path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/>
            </svg>
            <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button
            {% if match_gift_product %}
              style="pointer-events: none;"
            {% endif %}
            type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}"
          >
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20">
              <path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/>
            </svg>
            <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>

        <div class="cart__remove">
          <a href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0" data-product-id="{{product.variant_id}}" class="text-link" alt=" {{ 'cart.general.remove' | t }}">
            {% render 'icon-delete' %}
          </a>
        </div>
      </div>

      <div class="cart__item-price-col text-right">
        {% if product.original_price != product.final_price %}
          {% if product.final_price == 0 %}
            <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
            <small class="cart__price cart__price--strikethrough  black_txt">
              <span>
                  <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_price igPrice" data-item-key="{{item.key}}" style="display:none !important;"></span>
                {{- product.original_price | money -}}
              </span>
            </small>
          {% else %}
          {% if intelligems_discount == 0 %}
            <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
              <small class="cart__price cart__price--strikethrough  black_txt">
                <span>
                    <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_price" data-item-key="{{item.key}}" style="display:none !important;"></span>
                  {{- product.original_price | money -}}
                </span>
              </small>
            {% endif %}
          {% endif %}
         
          
          <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
          <span class="cart__price cart__discount black_txt">
            <span class="bcpo-cart-item-price" data-key="{{product.key}}">{{ product.final_price | money }}</span>
          </span>
        {% else %}
          <span class="cart__price  black_txt">
            <span>
              <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_price" data-item-key="{{item.key}}" style="display:none !important;"></span>
            {% if intelligems_discount == 0 %}
              {{ product.original_price | money }}
            {% else %}
              <span class="Bold-theme-hook-DO-NOT-DELETE bold_cart_item_price" data-item-key="{{item.key}}" style="display:none !important;"></span>
              {{ product.final_price | money }}
            {% endif %}
            </span>

          </span>
        {% endif %}

        {% if false %}
        {%- if product.line_level_discount_allocations != blank -%}
          {%- for discount_allocation in product.line_level_discount_allocations -%}
            <small class="cart__discount">
              {{- discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small
            >
          {%- endfor -%}
        {%- endif -%}
        {% endif %}

        
        {%- if product.unit_price_measurement -%}
          {%- capture unit_price_base_unit -%}
            <span class="unit-price-base">
              {%- if product.unit_price_measurement -%}
                {%- if product.unit_price_measurement.reference_value != 1 -%}
                  {{ product.unit_price_measurement.reference_value }}
                {%- endif -%}
                {{ product.unit_price_measurement.reference_unit }}
              {%- endif -%}
            </span>
          {%- endcapture -%}

          <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if product.line_level_discount_allocations != blank -%}
      <div class="custom_discount_wrap">
      {%- for discount_allocation in product.line_level_discount_allocations -%}
        {% if discount_allocation.amount > 0 %}
        <small class="cart__discount">
          {{- discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
        </small>
        {% endif %}
      {%- endfor -%}
      </div>
    {%- endif -%} 
  </div>
</div>

