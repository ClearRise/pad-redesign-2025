<script>
  /* eslint-disable no-use-before-define */
function injectNvdCss() {
  const cssId = 'myCss'; // you could encode the css path itself to generate id..
  if (!document.getElementById(cssId)) {
    const head = document.getElementsByTagName('head')[0];
    const link = document.createElement('link');
    link.id = cssId;
    link.rel = 'stylesheet';
    link.type = 'text/css';
    link.href = 'https://navidiumcheckout.com/cdn/nvd-styles-plus.css';
    link.media = 'all';
    head.appendChild(link);
  }
}
function formatMoney(cents, format = shopCurrency) {
  if (typeof cents === 'string') {
    cents = cents.replace('.', '');
  }
  let value = '';
  const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
  const formatString = format || this.money_format;

  function defaultOption(opt, def) {
    return typeof opt === 'undefined' ? def : opt;
  }

  function formatWithDelimiters(number, precision, thousands, decimal) {
    precision = defaultOption(precision, 2);
    thousands = defaultOption(thousands, ',');
    decimal = defaultOption(decimal, '.');

    if (isNaN(number) || number == null) {
      return 0;
    }
    number = (number / 100.0).toFixed(precision);
    const parts = number.split('.');
    const dollars = parts[0].replace(
      /(\d)(?=(\d\d\d)+(?!\d))/g,
      `$1${thousands}`,
    );
    const cents = parts[1] ? decimal + parts[1] : '';

    return dollars + cents;
  }

  switch (formatString.match(placeholderRegex)[1]) {
    case 'amount':
      value = formatWithDelimiters(cents, 2);
      break;
    case 'amount_no_decimals':
      value = formatWithDelimiters(cents, 0);
      break;
    case 'amount_with_comma_separator':
      value = formatWithDelimiters(cents, 2, '.', ',');
      break;
    case 'amount_no_decimals_with_comma_separator':
      value = formatWithDelimiters(cents, 0, '.', ',');
      break;
    default:
      value = formatWithDelimiters(cents, 2);
      break;
  }

  return formatString.replace(placeholderRegex, value);
}
const nvdShop = Shopify.shop;
const prefetchNvd = async (callback) => {
  let nvdConfig = localStorage.getItem('nvdconfig')
    ? JSON.parse(localStorage.getItem('nvdconfig'))
    : null;
  if (nvdConfig) {
    const today = new Date();
    const expiration = new Date(nvdConfig.expiration);
    if (today > expiration) {
      localStorage.removeItem('nvdconfig');
      nvdConfig = null;
      prefetchNvd();
    }
    console.log('Navidium config avaialable in storage');
  } else {
    console.log('Navidium config not available in storage');
    await fetch(
      `https://app.navidiumapp.com/api/widet-serverless-api-stable-september-2022.php?shop_url=${nvdShop}`,
    )
      .then((res) => res.json())
      .then((initialData) => {
        console.log({ initialData });
        const today = new Date();
        // extract the configuration data
        const shopConfig = {
          success: initialData.success,
          show_on_cart: initialData.nvd_show_cart,
          show_on_checkout: initialData.nvd_show_checkout,
          widget_location: initialData.widget_location,
          auto_insurance: initialData.nvd_auto_insurance,
          nvd_name: initialData.nvd_name,
          nvd_subtitle: initialData.nvd_subtitle,
          widget_icon: initialData.nvd_widget_icon,
          learnMore: initialData?.nvd_learn_more,
          nvd_description: initialData.nvd_description,
          nvd_message: initialData.nvd_message,
          protection_variants: initialData.nvd_variants,
          product_exclusion: initialData.product_exclusion.split(','),
          min_protection_price: initialData.min_protection_value,
          max_protection_price: initialData.max_protection_value,
          protection_type: initialData.nvd_protection_type,
          protection_percentage: initialData.nvd_protection_type_value,
          min_protection_variant: initialData.min_variant_id,
          max_protection_variant: initialData.max_variant_id,
          expiration: today.setDate(today.getDate() + 3),
        };
        // store into localStorage
        localStorage.setItem('nvdconfig', JSON.stringify(shopConfig));
        return shopConfig;
      });
  }
  if (callback) return callback();
  return false;
};

const calculateProtection = async (cartTotal,nvdCurrency) => {
  const apiURL = await fetch(
    `https://app.navidiumapp.com/api/variant-id-checker-api-march6.php?shop_url=${nvdShop}&price=${cartTotal}&currency=${nvdCurrency}`,
  );
  const data = await apiURL.json();
  return data;
};

const appendWidget = async (markup) => {
  const stepsFinder = setTimeout(() => {
    const createElem = document.createElement('div');
    createElem.innerHTML = markup;
    if (document.querySelectorAll('.step__sections').length > 0) {
      document.querySelector('.switch_holder')?.remove();
      if (
        !document
          .querySelector('.step__sections')
          .querySelector('.switch_holder ')
      ) {
        document.querySelector('.step__sections').append(createElem);
      }
      clearInterval(stepsFinder);
    }
  }, 500);
};

const nvd_init = async () => {
  const nvdConfig = localStorage.getItem('nvdconfig')
    ? JSON.parse(localStorage.getItem('nvdconfig'))
    : null;
  //* if no nvd config call prefetchNvd()
  if (!nvdConfig) {
    console.log('navidium config not available in storage');
    await prefetchNvd(nvd_init);
    return;
  }
  const { success } = nvdConfig;
  const showWidget = nvdConfig.show_on_checkout === '1';
  const imageUrl = '';
  const widgetLocation = nvdConfig.widget_location;
  const thisStep = Shopify.Checkout.step;
  const autoInsurance = nvdConfig.auto_insurance === '1';
  const optedOut = JSON.parse(localStorage.getItem('nvd_opted_out'));
  const cartProtectionVariant = localStorage.getItem('cart_protection')
    ? parseInt(localStorage.getItem('cart_protection'), 10)
    : null;
  console.log('config data', success, showWidget, widgetLocation, thisStep);
  if (success && showWidget && thisStep === widgetLocation) {
    const cart = await getCartCallback();
    debugger;
    let cartTotal = cart.total_price / 100;
    let checkStatus;
    if (cartTotal === 0) return;
   cart.items.forEach(item=>{
        if(item.handle.includes('shipping-protection')){
            cartTotal -= item.price / 100
        }
    });
    const currency = cart.currency;
    const protection = await calculateProtection(cartTotal,currency);
    const protectionPrice = protection.price;
    const variantFromApi = parseInt(protection.variant_id, 10);
    if (autoInsurance || !optedOut) checkStatus = true;
    if (!autoInsurance || optedOut) checkStatus = false;
    if (!optedOut && optedOut !== null) checkStatus = true;
    const widgetMarkup = await buildWidget(
      protectionPrice,
      variantFromApi,
      checkStatus ? 'checked' : '',
      imageUrl || '',
      nvdConfig,
    );
    if (cartProtectionVariant) {
      if (cartProtectionVariant === variantFromApi) {
        console.log(
          '1. cart variant is same as the api variant,stay idle and build widget',
          cartProtectionVariant,
          variantFromApi,
        );
        await appendWidget(widgetMarkup);
        await checkWidgetView();
      } else {
        console.log(
          'cart variant and api variant is not same.swapping them now',
        );
        if (cartProtectionVariant) {
          // now add the new protection to the cart
          if (checkStatus) {
            console.log('removing old and adding new protection');
            await removeAndAddProtection(
              cartProtectionVariant,
              variantFromApi,
              false,
            );
          }
        }
        await appendWidget(widgetMarkup);
        await checkWidgetView();
      }
    } else if (checkStatus) {
      console.log(
        'Protection Not available. Adding now.',
        cartProtectionVariant,
        variantFromApi,
      );
      await addProtection(Number(variantFromApi), 1, false);
      // now append the snippet
      await appendWidget(widgetMarkup);
      await checkWidgetView();
    } else {
      console.log('no protection available, just append snippet');
      // now append the snippet
      await appendWidget(widgetMarkup);
      await checkWidgetView();
    }
  }
};

async function updateWidgetPrice () {
    let cartData = await fetch('/cart.js').then(res => res.json());
    let widget = document.querySelector('.switch_holder');

    if (widget == null) return;

    let shopCurrency = '{{ shop.money_with_currency_format }}';
    let items = await cartData.items;
    items.forEach((item) => {
      if (item.handle.includes('shipping-protection')) {
        let price = document.querySelector(`[data-variant-id="${item.variant_id}"] .product__price`).innerText;
        let priceElem = document.querySelector('.shipping-protection-price');
        if (priceElem) priceElem.innerHTML = price;
      }
    });
};
let getCartCallback = async () => {
  const cartJSON = await fetch('/cart.js');
  const cart = await cartJSON.json();
  return cart;
};

let buildWidget = async (
  protectionPrice,
  variantFromApi,
  checkStatus,
  imageUrl,
  nvdConfig,
) => {
  let currency = Shopify?.currency?.active || Shopify?.Checkout?.currency;
  let formatCurrency = `${currency} {{amount}}`
  const {learnMore} = nvdConfig  || '';
  let learMoreMarkup = '';
  if (learnMore.length !== 0) {
    learMoreMarkup = `<button type="button" class="btnCstm tooltipCstm">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.5 0C3.36433 0 0 3.36433 0 7.5C0 11.6357 3.36433 15 7.5 15C11.6357 15 15 11.6357 15 7.5C15 3.36433 11.6357 0 7.5 0ZM7.5 11.875C7.15496 11.875 6.87504 11.595 6.87504 11.25C6.87504 10.905 7.15496 10.625 7.5 10.625C7.84504 10.625 8.12496 10.905 8.12496 11.25C8.12496 11.595 7.84504 11.875 7.5 11.875ZM8.48934 7.90123C8.26813 8.00308 8.12496 8.22624 8.12496 8.46943V8.75004C8.12496 9.09496 7.84561 9.375 7.5 9.375C7.15439 9.375 6.87504 9.09496 6.87504 8.75004V8.46943C6.87504 7.73998 7.30373 7.0713 7.96566 6.76563C8.60252 6.47255 9.06246 5.69435 9.06246 5.31246C9.06246 4.45129 8.36185 3.75 7.5 3.75C6.63815 3.75 5.93754 4.45129 5.93754 5.31246C5.93754 5.6575 5.65807 5.93754 5.31246 5.93754C4.96685 5.93754 4.6875 5.6575 4.6875 5.31246C4.6875 3.7619 5.94933 2.49996 7.5 2.49996C9.05067 2.49996 10.3125 3.7619 10.3125 5.31246C10.3125 6.15692 9.57996 7.39815 8.48934 7.90123Z" fill="#212B36">
                    </path>
                </svg>
                <span class="toolltiptextCstm">${nvdConfig.learnMore}</span>
            </button>`;
  }

  const widgetMarkup = ` <div class="switch_holder ">
        <div class="switch">
          <div class="w80">
            <img style="" width="37" height="37" src="${nvdConfig.widget_icon}"
              alt="Navidium">
            <h4 class="ship_heading">${nvdConfig.nvd_name}
              ${learMoreMarkup}
            </h4>
            <span class="insurance_direction">${nvdConfig.nvd_subtitle}<strong
                class="shipping-protection-price">${formatMoney(protectionPrice * 100)}</strong> </span>
          </div>
          <div class="w19">
            <input type="checkbox" id="switch" class="checkbox nvdCheckbox" ${checkStatus}
              data-nvd-variant='${variantFromApi}' />
            <label for="switch" class="toggle">
              <p>ON OFF</p>
            </label>
          </div>
          <div class="w100 msg_holder">
            <p class="enable_msg">${nvdConfig.nvd_description}</p>
            <p class="disable_msg">${nvdConfig.nvd_message}</p>
          </div>
        </div>
      </div>`;

  return widgetMarkup;
};

const getProtection = async (id, element) => {
  setTimeout(async () => {
    const { checked } = element;
    if (checked) {
      await addProtection(id);
    } else {
      await removeProtection(id);
    }
  }, 200);
};

let addProtection = async (variantId, quantity = 1, reload = false) => {
  try {
    const id = parseInt(variantId, 10);
    const request = {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json;',
        Accept: 'application/json',
      },
      body: JSON.stringify({ id, quantity }),
    };
    const cartData = await fetch('/cart/add.js', request);
    const cartJson = await cartData.json();
    if (cartJson.id) {
      console.log(
        '%c Protection added successfully',
        'color: white; background-color: green',
      );
      await updateDom();
    }
    localStorage.setItem('nvd_opted_out', false);
    localStorage.setItem('cart_protection', variantId);
    checkWidgetView();
    if (reload) window.location.reload();
    return cartJson;
  } catch (error) {
    console.log('ERROR adding protection', error);
  }
};

let removeProtection = async (id) => {
  try {
    const request = {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json;',
        Accept: 'application/json',
      },
      body: JSON.stringify({
        id: String(id),
        quantity: 0,
      }),
    };

    const cartData = await fetch('/cart/change.js', request);
    const cartJson = await cartData.json();
    localStorage.setItem('nvd_opted_out', true);
    localStorage.removeItem('cart_protection');
    if (cartJson.token) {
      console.log(
        '%c Protection removed successfully',
        'color: white; background-color: red',
      );
      await updateDom();
    }

    await checkWidgetView();

    return cartJson;
  } catch (error) {
    console.log('ERROR removing protection', error);
  }
};

const removeAndAddProtection = async (remove, add, reload = false) => {
  const removeRequest = {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json;',
      Accept: 'application/json',
    },
    body: JSON.stringify({
      id: String(remove),
      quantity: 0,
    }),
  };

  const addRequest = {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json;',
      Accept: 'application/json',
    },
    body: JSON.stringify({
      id: String(add),
      quantity: 1,
    }),
  };

  await fetch('/cart/change.js', removeRequest)
    .then((res) => res.json())
    .then(() => {
      console.log('removed and now adding');

      fetch('/cart/add.js', addRequest)
        .then((res) => res.json())
        .then((data) => {
          if (data.id) {
            console.log(
              '%c Protection swapped successfully',
              'color: white; background-color: green',
            );
            updateDom();
          }

          localStorage.setItem('nvd_opted_out', false);
          localStorage.setItem('cart_protection', add);

          if (reload) window.location.reload();
        });
    });
};

const removeDuplicate = async (id, reload = false) => {
  let cartData = null;
  let cartJson = null;
  const variantId = id;
  const request = {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json;',
      Accept: 'application/json',
    },
    body: JSON.stringify({
      id: String(variantId),
      quantity: 0,
    }),
  };
  cartData = await fetch('/cart/change.js', request);
  cartJson = await cartData.json();
  if (cartJson.token) {
    console.log(
      '%c Duplicate Protection removed successfully',
      'color: white; background-color: green',
    );
    await initialCheck();
  }
  await checkWidgetView();
  if (reload) window.location.reload();
  return cartJson;
};

let updateDom = async () => {
  try {
    const url = '/checkout';
    await fetch(url)
      .then((data) => data.text())
      .then((html) => {
        const container = document.createElement('div');
        container.innerHTML = html;
        const productLists = container.querySelector('.order-summary__section--product-list');
        const orderTotals = container.querySelector('.order-summary__section--total-lines');
        const currentProductLists = document.querySelector('.order-summary__section--product-list');
        const currentOrderTotals = document.querySelector('.order-summary__section--total-lines');
        currentOrderTotals.innerHTML = orderTotals.innerHTML;
        currentProductLists.innerHTML = productLists.innerHTML;
        updateWidgetPrice();
      });
  } catch {
    console.log('error occured in update dom.redirecting to new checkout');
    window.location.href = '/checkout';
  }
};

let checkWidgetView = async () => {
  const cartData = await fetch('/cart.js').then((res) => res.json());
  const widget = document.querySelector('.swtich_holder');
  if (widget == null) return;
  const items = await cartData.items;
  items.forEach((item) => {
    if (item.handle.includes('shipping-protection')) {
      const price = formatMoney(item.price);
      const priceElem = document.querySelector('.shipping-protection-price');
      if (priceElem) priceElem.innerHTML = price;
    }
  });
};

const initialCheck = async () => {
  let lineItem;
  let nvdCounter = 0;
  const cart = await getCartCallback();
  const items = await cart.items;
  // TODO: check if the cart has the protection
  items.forEach((item) => {
    if (item.handle.includes('shipping-protection')) {
      lineItem = item;
      nvdCounter = item.quantity;
    }
  });
  if (nvdCounter > 1) {
    console.log(
      '%c Multiple Navidium Protection items found',
      'color: white; background-color: red',
    );
    await removeDuplicate(lineItem.variant_id);
  } else {
    await nvd_init();
    updateWidgetPrice();
  }
};
var inCloudFlare = true;
window.addEventListener('DOMContentLoaded', () => {
  inCloudFlare = false;
  initialCheck();
  injectNvdCss();
});
window.addEventListener('click', (event) => {
  const { target } = event;
  const protectionCheckbox = document.querySelector(
    '.switch .nvdCheckbox',
  );
  if (target === protectionCheckbox) {
    const { nvdVariant } = target.dataset;
    getProtection(nvdVariant, target);
  }
});


window.onload = function (){
    if (inCloudFlare) window.dispatchEvent(new Event("DOMContentLoaded"));
}
</script>