                </g>
                <defs>
                <clipPath id="clip0_15_529">
                <rect width="24" height="24" fill="#000000"/>
                </clipPath>
                </defs>
              </svg>
            </div>
            <div>
              {{ block.settings.phone }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
