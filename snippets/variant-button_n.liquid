{%- assign swatch_file_extension = 'png' -%}

{%- liquid
  assign is_size = false
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign downcased_option = option.name | downcase

  if downcased_option contains size_trigger and block.settings.size_chart
    assign is_size = true
  endif
-%}

{%- capture size_chart_title -%}
  {{ 'products.general.size_chart' | t }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path class="a" d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path class="a" d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39M46.78 33.53v7.44M38.65 33.53v7.44M30.52 33.53v7.44M22.39 33.53v7.44"/></svg>
{%- endcapture -%}

<div class="variant-wrapper js" data-type="button">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    {{ option.name }}
    {% if is_image %}
      <span class="variant__label-info">
        &mdash;
        <span
          data-variant-color-label
          data-variant-image-label
          data-index="option{{ forloop.index }}"
          data-option-index="{{ color_option_index }}">    
          {{ option.selected_value }}
        </span>
      </span>
    {% else %}
      <span class="variant__label-info">
        &mdash;
        {% if option.name contains 'Finish' %}
          {% comment %} <span class="variant__label-info-finish"> {% endcomment %}
            {% if option.selected_value contains 'Gold' %}
              <svg style="transform: translateY(4.8px);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="url(#paint0_linear_gold)"></circle><defs><linearGradient id="paint0_linear_gold" x1="20" y1="10" x2="0" y2="10" gradientUnits="userSpaceOnUse"><stop stop-color="#E9D396"></stop><stop offset="0.487898" stop-color="#FBEAAC"></stop><stop offset="1" stop-color="#E9D396"></stop></linearGradient></defs></svg>
            {% elsif option.selected_value contains 'Silver' %}
              <svg style="transform: translateY(4.8px);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="url(#paint0_linear_silver)"></circle><defs><linearGradient id="paint0_linear_silver" x1="20" y1="10" x2="0" y2="10" gradientUnits="userSpaceOnUse"><stop stop-color="#B9B9B9"></stop><stop offset="1" stop-color="#FFFFFF"></stop></linearGradient></defs></svg>
            {% elsif option.selected_value contains 'Platinum' %}
              <svg style="transform: translateY(4.8px);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="url(#paint0_linear_platinum)"></circle><defs><linearGradient id="paint0_linear_platinum" x1="20" y1="10" x2="0" y2="10" gradientUnits="userSpaceOnUse"><stop stop-color="#E0E0E0"></stop><stop offset="1" stop-color="#FFFFFF"></stop></linearGradient></defs></svg>
            {% elsif option.selected_value contains 'Palladium' %}
              <svg style="transform: translateY(4.8px);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="url(#paint0_linear_palladium)"></circle><defs><linearGradient id="paint0_linear_palladium" x1="20" y1="10" x2="0" y2="10" gradientUnits="userSpaceOnUse"><stop stop-color="#A9A9A9"></stop><stop offset="1" stop-color="#FFFFFF"></stop></linearGradient></defs></svg>
            {% elsif option.selected_value contains 'Rhodium' %}
              <svg style="transform: translateY(4.8px);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="url(#paint0_linear_rhodium)"></circle><defs><linearGradient id="paint0_linear_rhodium" x1="20" y1="10" x2="0" y2="10" gradientUnits="userSpaceOnUse"><stop stop-color="#D4D4D4"></stop><stop offset="1" stop-color="#FFFFFF"></stop></linearGradient></defs></svg>
            {% elsif option.selected_value contains 'Titanium' %}
              <svg style="transform: translateY(4.8px);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="url(#paint0_linear_titanium)"></circle><defs><linearGradient id="paint0_linear_titanium" x1="20" y1="10" x2="0" y2="10" gradientUnits="userSpaceOnUse"><stop stop-color="#A3A3A3"></stop><stop offset="1" stop-color="#FFFFFF"></stop></linearGradient></defs></svg>
            {% endif %}
          {% comment %} </span> {% endcomment %}
        {% endif %}
        <span
          data-variant-color-label
          data-index="option{{ forloop.index }}"
          data-option-index="{{ color_option_index }}">
          {% if is_color %}
            {% if option.selected_value contains 'Gold' %}
              {{ option.selected_value }}
            {% else %}
              {%- liquid
                assign color_swatch_tmp =  option.selected_value | split: ' ' | first
              -%}
              {{ color_swatch_tmp }}
            {% endif %}
          {% else %}        
            {{ option.selected_value }}
          {% endif %}
        </span>
      </span>
    {% endif %}
    {%- if is_size -%}
      {%- if block.settings.size_chart != blank -%}
        {%- render
          'tool-tip-trigger',
          title: size_chart_title,
          content: block.settings.size_chart.content,
          context: 'size-chart'
        -%}
      {%- endif -%}
    {%- endif -%}
    {%- if option.name == 'Size' -%}
      <span class="find-your-size-ss">
        {% render 'icon-ruler' %}
        Find Your Size
      </span>
      <input type="hidden" class="product-real-size-input" name="__real-size" id="__real-size">
    {%- endif -%}
  </label>
  {%- assign option_index = forloop.index -%}
  {%- assign option_index_0 = forloop.index0 -%}
  
    <fieldset class="variant-input-wrap swatch"
      name="{{ option.name }}"
      data-index="option{{ option_index }}"
      data-handle="{{ option.name | handleize }}"
      id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
      <legend class="hide">{{ option.name }}</legend>
      {%- for value in option.values -%}
        {%- liquid
          assign product_available = true
          if product.options.size == 1
            assign product_available = product.variants[forloop.index0].available
          endif
        -%}
        <div
          class="variant-input 
            {% if option.name contains 'Finish' %} variant-input-finish{% endif %}
            {% if option.values.size == 1 and option.name == 'Finish' %} hide{% endif %}"
          data-index="option{{ option_index }}"
          data-value="{{ value | escape }}">
          <input type="radio"
            form="{{ form_id }}"
            {% if option.selected_value == value %} checked="checked"{% endif %}
            value="{{ value | escape }}"
            data-index="option{{ option_index }}"
            name="{{ option.name }}"
            data-variant-input
            class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}{% if is_image %} variant__input--image-swatch{% endif %}"
            {% if is_color %} data-color-name="{{ value | escape }}"{% endif %}
            {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
            {% if is_image %} data-image-index="{{ color_option_index }}"{% endif %}
            id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}">
          {%- if is_color -%}
            {%- liquid
              assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
              assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
              if value contains "Gold"
                assign color_swatch_fallback = "Gold" 
              else
                assign color_swatch_fallback = value | split: ' ' | last
              endif
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              data-file-name="{{color_file_name}}" 
              style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
            >
              <span>{{ value | escape }}</span>
            </label>
          {%- elsif is_image -%}
            {%- liquid
              assign variant_image = blank
              for variant in product.variants
                if variant.options[option_index_0] == value
                  if variant.metafields.custom.custom_image != blank
                    assign variant_image = variant.metafields.custom.custom_image | img_url: '100x100'
                    break
                  elsif variant.featured_media
                    assign variant_image = variant.featured_media | img_url: '100x100'
                    break
                  endif
                endif
              endfor
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label bold_option_value_swatch color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="{% if variant_image != blank %}background-image: url({{ variant_image }});{% endif %} background-size: cover; background-position: center;"
            >
              <span>{{ value | escape }}</span>
            </label>
          {%- else -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label{% unless product_available %} disabled{% endunless %}">{{ value | escape }}</label>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </fieldset>
</div>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (document.querySelector('.find-your-size-ss') != undefined) {
      document.querySelector('.find-your-size-ss').addEventListener('click', function (e) {
        e.preventDefault();
        Swal.fire({
          {% if block.settings.size_chart_title != blank %}
            title: '{{ block.settings.size_chart_title }}', // Title of the alert
          {% endif %}
          {% if block.settings.size_chart_text != blank %}
            text: '{{ block.settings.size_chart_text }}.', // Custom message/text
          {% endif %}
          {% if block.settings.size_chart_image != blank %}
            imageUrl: '{{ block.settings.size_chart_image | img_url: 'master' }}', // Image URL (replace with your image URL)
            imageWidth: 400, // Optional: width of the image
            imageAlt: 'Custom Image', // Optional: alt text for the image
          {% endif %}
          confirmButtonText: 'OK', // Optional: button text
        });
      })
    }
  })
</script>