
{% if linklists.gift-wrapping.links.size > 0 and
linklists.gift-wrapping.links.first.type == 'product_link' %}

<div
  id="is-a-gift"
  style="clear: left; margin: 5px 0"
  class="clearfix rte"
>
  
  <line-item class="line-item" style="column-gap: 1rem;">

  <p>
    <input
      id="gift-wrapping"
      type="checkbox"
      name="attributes[gift-wrapping]"
      value="yes"
      {% if cart.attributes.gift-wrapping %}
      checked="checked"
      {% endif %}
      style="float: none"
    />
    <label id="giftwraplabel"
      for="gift-wrapping"
      style="display:inline; padding-left: 5px; float: none;"
    > Add protection warranty
    </label>
  </p>


  
</line-item>
  
</div>

