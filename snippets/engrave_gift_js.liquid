              return;
            }
          } else {
            if (wasNotPuchased != "false") {
              console.log("will new puchase 🤔 not now", oldVariant, newVariant);
            } else {
              console.log("will other puchase");
              itemsData = [
                { id: newVariant, quantity: 1, properties: { '_gift_product': 'true' } }
