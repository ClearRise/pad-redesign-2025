      $protectionID = $(this).parents(".cart__item").find(".Protection_p").attr('data-product-id');
      bothRemoveEngrageShippingItems($protectionID, engravingProductID, $productId, itemQuantity);
    }
    else if ($(this).parents(".cart__item").find(".engraving_p").val() == "true") {
