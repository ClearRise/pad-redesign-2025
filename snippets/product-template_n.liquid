{%- if product.metafields.inventory.ShappifyHidden == 'true' -%}{%- break -%}{%- endif -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  unless thumbnail_position
    assign thumbnail_position = 'beside'
  endunless

  assign product_zoom_size = '1800x1800'
  assign product_image_size = '620x'

  case image_container_width
    when 'small'
      assign product_image_width = 'medium-up--two-fifths'
      assign product_description_width = 'medium-up--three-fifths'
      assign product_image_size = '480x'
    when 'medium'
      assign product_image_width = 'medium-up--one-half'
      assign product_description_width = 'medium-up--one-half'
      assign product_image_size = '620x'
    when 'large'
      assign product_image_width = 'medium-up--three-fifths'
      assign product_description_width = 'medium-up--two-fifths'
      assign product_image_size = '740x'
  endcase
  assign free_gift_index = 0
  assign product_img_structure = product.featured_media | img_url: '1x1' | replace: '_1x1.', '_{width}x.'
-%}

{{'product-template_n.css' | asset_url | stylesheet_tag }}
<style>
  .buy-one-get-one-free {
    flex: 1;
    text-align: right;
  }
  .buy-one-get-one-free span {
    background: #DC3030;
    padding: 5px 25px;
    border-radius: 20px;
    font-size: 14px;
    color: white;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .buy-one-get-one-free {
      flex: unset;
      width: 100%;
      text-align: left;
    }
  }
  @media (max-width: 520px) {
    .buy-one-get-one-free span {
      padding: 3px 10px;
      font-size: 11px;
      flex: unset !important;
    }  
  }
  @media (max-width: 400px) {
    .buy-one-get-one-free {
      width: 100%;
      text-align: left;
    }
  }
  
  @media (min-width: 768px) and (max-width: 1023px) {
    .pdp-product-block--price-ss .product__price.on-sale {
      margin-right: 5px;
      font-size: calc(var(--typeBaseSize)* 1.5);
    }
    .pdp-product-block--price-ss .product-single__title {
      font-size: calc(var(--typeHeaderSize)* .65);
    }
  }
  @media (min-width: 1024px) and (max-width: 1100px) {
    .pdp-product-block--price-ss .product__price.on-sale {
      margin-right: 5px;
      font-size: calc(var(--typeBaseSize)* 1.5);
    }
    .pdp-product-block--price-ss .product-single__title {
      font-size: calc(var(--typeHeaderSize)* .65);
    }
  }

  /** sticky buy button wrapper style start **/
  .buy-button-wrapper-sticky {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 60%;
    justify-content: flex-end;
    .product-block {
      margin-bottom: 0px !important;
    }
  }
  .sticky-bar #tryon-wrapper {
    width: 75%;
    .tryon-button {
      margin-top: 0 !important;
      font-size: inherit !important;
    }
    .tryon-desc-span {
      display: none;
    }
  }
  @media (max-width: 768px) {
    .sticky-bar #tryon-wrapper {
      width: 100%;
      .tryon-button {
        font-size: max(calc(var(--typeBaseSize) - 6px), 10px) !important;
        padding: 10px 0px !important;
      }
    }
  }
  @media (max-width: 520px) {
    .buy-button-wrapper-sticky {
      width: 80% !important;
    }
  }

  /*******************************************/
</style>

<div id="adding-product-modal" class="add-to-cart-loader Modal Modal--dark" aria-hidden="true" role="dialog" data-scrollable="" style="display: none;">
   <div class="Modal__Content Rte">
      <div class="CircleSpinner">
        <div class="Checkmark Draw"></div>
      </div>
      <div class="Message">Adding to Cart</div>
   </div>
</div>
<div id="ProductSection-{{ section_id }}-{{ product.id }}"
  class="product-section"
  data-section-id="{{ section_id }}"
  data-product-id="{{ product.id }}"
  data-section-type="product"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url | within: collection }}"
  data-aspect-ratio="{{ 100 | divided_by: product.featured_media.aspect_ratio }}"
  data-img-url="{{ product_img_structure }}"
  {% unless isModal %}
    data-history="true"
  {% endunless %}
  data-modal="{{ isModal }}">

  <div class="pg_overlay" style="display:none;">
      <div class="pg_overlay__inner">
          <div class="pg_overlay__content">
              <span class="pg_spinner"></span>
          </div>
      </div>
  </div>
  
  {%- render 'product-template-variables', product: product, current_variant: current_variant -%}

  <div class="page-content page-content--product custom_product">
    <div class="page-width">

      <div class="grid{% unless image_position == 'left' %} grid--product-images-right{% endunless %}{% if mobile_layout == 'partial' %} grid--product-images--partial{% endif %}">
        {%- if image_position == 'left' -%}
          <div class="grid__item {{ product_image_width }} product-single__sticky">
            {%- render 'product-images_n',
              section_id: section_id,
              product: product,
              isModal: isModal,
              image_position: image_position,
              product_zoom_enable: product_zoom_enable,
              product_zoom_size: product_zoom_size,
              product_image_size: product_image_size,
              thumbnail_arrows: thumbnail_arrows,
              thumbnail_position: thumbnail_position,
              video_looping: video_looping,
              video_style: video_style
            -%}
          </div>
        {%- endif -%}

        <div class="grid__item {{ product_description_width }}">

          <div class="product-single__meta">
            <div class="custom_product_block product-block product-block--header">
              {% comment %} {%- if settings.show_breadcrumbs and isModal != true -%}
                {%- render 'breadcrumbs' -%}
              {%- endif -%} {% endcomment %}

              {%- if settings.vendor_enable -%}
                <div class="product-single__vendor">
                  {%- assign vendor_handle = product.vendor | handleize -%}
                  {%- if collections[vendor_handle] != empty -%}
                    <a href="{{ routes.collections_url }}/{{ collections[vendor_handle].handle }}">
                      {{ collections[vendor_handle].title }}
                    </a>
                  {%- else -%}
                    {{ product.vendor | link_to_vendor }}
                  {%- endif -%}
                </div>
              {% endif %}

              {% if section.settings.type_enable and product.metafields.custom.set_type != blank %}
                <div class="grid-product__vendor">{{ product.metafields.custom.set_type }}</div>
              {%- endif -%}

              {%- for block in blocks -%}
                {%- if block.type == '@app' -%}
                  {%- if block.id contains "judge_me_review" -%}
                    <div class="judge_me_review-prev-container-ss">
                      {%- render block -%}
                      {% comment %} <a class='upload-svg-container-ss'>
                        {%- render 'icon-upload' -%}
                      </a> {% endcomment %}
                    </div>
                    {%- break -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if isModal -%}
                <p class="h2 product-single__title">
                  {% if product.metafields.custom.title != blank %}
                  {{product.metafields.custom.title}}
                  {% else %}
                  {{ product.title }}
                  {% endif %}
                </p>
              {%- else -%}
                <h1 class="h2 product-single__title">
                  {%- unless product.empty? -%}
                  {% if product.metafields.custom.title != blank %}
                  {{product.metafields.custom.title}}
                  {% else %}
                  {{ product.title }}
                  {% endif %}
                  {%- else -%}
                    {{ 'home_page.onboarding.product_title' | t }}
                  {%- endunless -%}
                </h1>
              {%- endif -%}


              {% if product.tags contains 'Partial.ly' %}
              <div id="partiallyWidget" style="top-margin:10px;bottom-margin:10px"></div>
<script>
document.partiallyWidgetConfig = {
  source: 'shopify',
  offer: '92db5468-d835-4199-bf4e-29247cdbb53c',
  amount: {{product.selected_or_first_available_variant.price}} / 100,
  targetSelector: '#partiallyWidget',
  currency: 'USD',
  {%raw%}
body:'Finance with 0% Interest',
{%endraw%}
  style:'thin', 
  popupDetails: 'Finance with 0% Interest <br> Available in Cart',

};
(function() {
    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = 'https://partial.ly/js/partially-widget.js';
    script.async = true;
    document.head.appendChild(script);
})();
</script>
{% endif %}


              {%- if sku_enable -%}
                <p data-sku class="product-single__sku">
                  {%- if current_variant.sku -%}
                    {{ current_variant.sku }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- if section.settings.subtitle_enable and product.metafields.custom.plan_out_subtitle -%}
                {% if section.settings.subtitle_type == 'two' and product.metafields.custom.collection_subtitle contains "|" %}
                {% assign subtitle_items = product.metafields.custom.plan_out_subtitle | split: '|' %}
                <p class="product-subtitle">{{subtitle_items[0]}}|{{subtitle_items[1]}}</p>
                {% else %}
                <p class="product-subtitle">{{product.metafields.custom.plan_out_subtitle}}</p>
                {% endif %}
              {%- endif -%}

            </div>
            <style>
              .slr-widget--mini .slr-stars svg {
                width: 20px;
                height: 20px;
              }
              .slr-widget--mini .slr-stars-score__total {
                font-size: 14.5px;
                font-weight: 400;
              }
              .slr-stars-score__total {
                font-family: -apple-system, "system-ui", "Segoe UI", Roboto, Ubuntu, "Helvetica Neue", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
              }
            </style>

            <div class="sendlane-reviews" sl-product-id="{{product.id}}" sl-type="mini"></div>
            
            <div data-product-blocks>
              {%- form 'product', product, id: form_id, class: 'product-single__form' -%}
                
              {%- capture form_id -%}AddToCartForm-{{ section_id }}-{{ product.id }}{%- endcapture -%}
              {%- for block in blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {%- unless block.id contains "judge_me_review" -%}
                      {% render block %}
                    {%- endunless -%}
                  {%- when 'separator' -%}
                    <div class="product-block"><hr></div>
                  {%- when 'text' -%}
                    <div class="product-block custom_txt_block" {{ block.shopify_attributes }}>
                      <p class="bold--{{block.settings.bold}}" >{{ block.settings.text }}</p>
                    </div>
                  {% when 'richtext' %}
                    <div class="product-block custom_txt_block" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>
                  {%- when 'glowstone_enhancement' -%}

                    {%- assign selected_collection = block.settings.in_collection -%}

                  

                    {% assign found = false %}
                    {% if selected_collection != blank %}
                      {% for collection in product.collections %}
                        {% if collection.handle == selected_collection %}
                          {% assign found = true %}
                        {% endif %}
                      {% endfor %}

                      {% comment %}
                      {% for product_col in collections[block.settings.in_collection].products %}

                        {{ product_col.id }}
                        
                        {% if product_col.id == product.id %}
                          {% assign found = true %}
                        {% endif %}
                      {% endfor %}
                      {% endcomment %}
                      
                    {% elsif selected_collection == blank %} 
                      {% assign found = true %}
                    {% else %}
                      {% assign found = false %}
                    {% endif %}

                    {% if found %}

                       {% style %}
                      .custom_enhancement_block ._u_upsell-product {
                        background: {{block.settings.bg_color}};
                        color: {{block.settings.text_color}};
                        border-color: {{block.settings.border_color}}!important;
                      }
                      {% endstyle %}
                      {% assign selected_product = block.settings.up_product %}
                      {% if selected_product and selected_product != blank  %}
                      <div class="product-block custom_enhancement_block" {{ block.shopify_attributes }}>                         
                         <div class="_u_upsell-collection _b_dgCartUpsellCont"> 
                              <div  class="show" >
                                <div class="_u_upsell-product  _b_custom_border inline-box">
                                {% assign u_product = block.settings.up_product %}
                                {%- liquid
                                  assign featured_media = u_product.selected_or_first_available_variant.featured_media | default: u_product.featured_media
                                -%} 
                                  <div>
                                    <div class="_b_dgCartUpsellInner">
                                      <div class="_u_upsell-product-image">
                                        <img class="dci-image" src="{{ featured_media | img_url: '70x' }}" alt="{{ title | escape }}">     
                                      </div>
                                      <div class="_u_upsell-product-info">
                                        <div class="_u_product-title-link">
                                            <strong class="dci-title">{{ block.settings.enhancement_title }}</strong>
                                        </div>
                                        <div class="_u_cart__item-sub">
                                          <div style="display: block;">
                                              <p class="_b_txt">{{ block.settings.enhancement_text }}</p>
                                          </div>
                                        </div> 
                                        <div class="desktop_show">
                                            <div class="bold_option bold_option_checkbox _u_checkbox_wrap">
                                              <label>
                                                <span class="bold_option_element">                                        
                                                  <input
                                                      type="checkbox"
                                                      class="protection-plan-glow"
                                                      name="properties[_glowstone_enhancement]"
                                                      value="Yes"
                                                      data-protection="{{ u_product.selected_or_first_available_variant.id }}"
                                                      {% if u_product.selected_or_first_available_variant.price == 0 %} checked {% endif %}
                                                    >
                                                    <input
                                                      type="hidden"
                                                      class="hidden_glowstone_enhancement_info"
                                                      name="properties[_prot-glowstone_enhancement]"
                                                      value="{{ u_product.title }}"
                                                    >
                                                   <input
                                                      type="hidden"
                                                      class="hidden_glowstone_enhancement_info"
                                                      name="properties[_prot-glowstone_enhancement_id]"
                                                      value="{{ u_product.selected_or_first_available_variant.id }}"
                                                    >
                                                </span>  
                                                <span class="_u_checkbox_txt">Add Glowstone Enhancement +{{ u_product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span>
                                                <span class="money compare_money">{{ u_product.selected_or_first_available_variant.compare_at_price | money_without_trailing_zeros }}</span>
                                              </label>
                                            </div>                                    
                                        </div>
                                        
                                      </div>
                                    </div>
                                  </div> 
                                  <div class="mobile_show">
                                      <div class="bold_option bold_option_checkbox _u_checkbox_wrap">
                                        <label>
                                          <span class="bold_option_element">                                        
                                            <input
                                                type="checkbox"
                                                class="protection-plan-glow"
                                                name="properties[_glowstone_enhancement]"
                                                value="Yes"
                                                data-protection="{{ u_product.selected_or_first_available_variant.id }}"
                                                {% if u_product.selected_or_first_available_variant.price == 0 %} checked {% endif %}
                                              >
                                              <input
                                                type="hidden"
                                                class="hidden_glowstone_enhancement_info"
                                                name="properties[_prot-glowstone_enhancement]"
                                                value="{{ u_product.title }}"
                                              >
                                             <input
                                                type="hidden"
                                                class="hidden_glowstone_enhancement_info"
                                                name="properties[_prot-glowstone_enhancement_id]"
                                                value="{{ u_product.selected_or_first_available_variant.id }}"
                                              >
                                          </span>  
                                          <span class="_u_checkbox_txt">Add Glowstone Enhancement +{{ u_product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span>
                                          <span class="money compare_money">{{ u_product.selected_or_first_available_variant.compare_at_price | money_without_trailing_zeros }}</span>
                                        </label>
                                      </div>                                    
                                  </div>
                                </div>
                              </div>
                         </div>   
                      </div>  
                      {% endif %}                                           
                    {% endif %}
                  {%- when 'free_gifts' -%}
                    {% style %}
                    .custom_gift_block ._b_upsell-product {
                      background: {{block.settings.bg_color}};
                      color: {{block.settings.text_color}};
                      border-color: {{block.settings.border_color}}!important;
                    }
                    {% endstyle %}
                    <div class="product-block product-block-gifts custom_gift_block" {{ block.shopify_attributes }}>
                    {% assign GiftBoxAmount = section.settings.product_threshold_amount | default: settings.product_threshold_amount %}
                    {% assign GiftBoxAmountRaw = section.settings.product_threshold_amount | default: settings.product_threshold_amount | times:100 %}
                    {% assign GiftBoxAmountMoney = GiftBoxAmountRaw | abs | money_without_trailing_zeros %}
                    {% assign already_added =  'Included' %}

                      {% if product.price >= GiftBoxAmountRaw %}
                        {% if block.settings.gift_box_title != blank %}
                        <div class="_b_giftbox_title">{{ block.settings.gift_box_title }}</div> 
                        {% endif %}
                       
                       <div class="_b_upsell-collection _b_dgCartUpsellCont _b_gift-products"> 
                        {% for i in (1..3) %}
                          {% assign image_1 = 'product' | append: i | append: '-img1' %}
                          {% assign image_2 = 'product' | append: i | append: '-img2' %}
                          {% assign title = 'product' | append: i | append: '-title' %}
                          {% assign text = 'product' | append: i | append: '-text' %}

                          {% assign image1 = block.settings[image_1] | default: settings[image_1] %}
                          {% assign image2 = block.settings[image_2] | default: settings[image_2] %}
                          {% assign title = block.settings[title] | default: settings[title] %}
                          {% assign text = block.settings[text] | default: settings[text] %}

                          {% if image1 %}
                            <div  class="_b_upsell-product-inner _b_gift-product show" >
                              <div class="_b_upsell-product _b_dgCartUpsellInner _b_custom_border {% if image2 == blank %}inline-box{% endif %}">
                                <div class="_b_upsell-product-image" style="margin-right: 5px;">
                                  <img class="dci-image" src="{{ image1 | img_url: '200x' }}" alt="{{ title | escape }}">     
                                </div>
                                {% if image2 %}
                                  <div class="_b_upsell-product-image">
                                    <img class="dci-image" src="{{ image2 | img_url: '200x' }}" alt="{{ title | escape }}">     
                                  </div>
                                {% endif %}
                                <div class="_b_upsell-product-info">
                                  <div class="_b_product-title-link">
                                      <strong class="dci-title">{{ title }}</strong>
                                  </div>
                                  <div class="_b_cart__item-sub">
                                    <div >
                                        <p class="_b_txt">{{ text }}</p>
                                    </div>
                                  </div>    
                                </div>
                              </div>
                            </div>
                          {% endif %}
                        {% endfor %}
                        <span style="font-size:12px;">{{block.settings.bottom_text}}</span>    
                       </div>   
                      {% endif %}
                    </div>
                  {%- when 'pre_free_gifts' -%}
                    {% if product.metafields.custom.pre_order_date != blank %}
                      {% style %}
                        .block--{{block.id}} .perorder-content {
                          background: {{block.settings.background}};
                        }
                        .block--{{block.id}}.product-block .perorder-content p, .custom_gift_block span {
                          color: {{block.settings.color}};
                        }
                        .block--{{block.id}}.product-block .perorder-content ul li.disable {
                          background: {{block.settings.first_bg}};
                          color: {{block.settings.first_color}};
                        }
                        .block--{{block.id}}.product-block .perorder-content ul li.bold {
                          background: {{block.settings.second_bg}};
                          color: {{block.settings.second_color}};
                        }
                        .block--{{block.id}}.product-block .perorder-content ul li.normal {
                          background: {{block.settings.third_bg}};
                          color: {{block.settings.third_color}};
                        }
                        .block--{{block.id}}.product-block .perorder-content ._b_upsell-product {
                          background: {{block.settings.gift_bg}};
                          color: {{block.settings.gift_text}};
                        }
                        .block--{{block.id}}.product-block .perorder-content ._b_upsell-product ._b_txt {
                          color: {{block.settings.gift_text}};
                        }
                      {% endstyle %}
                  
                      <div class="product-block product-block--pre-order block--{{block.id}}" {{ block.shopify_attributes }}>
                        <div class="perorder-content">
                          {{product.metafields.custom.pre_order_text | metafield_tag }}
                          <ul>
                            {% for value in product.metafields.custom.pre_order_date.value %}
                              {% assign text_array = value | split: ':' %}
                              <li class="{{text_array[2]}}" >
                                <span>{{text_array[0]}}</span>
                                <span>{{text_array[1]}}</span>
                              </li>
                            {% endfor %}
                          </ul>
                          <div class="custom_gift_block">
                            {% assign GiftBoxAmount = settings.product_threshold_amount %}
                            {% assign GiftBoxAmountRaw = settings.product_threshold_amount | times:100 %}
                            {% assign GiftBoxAmountMoney = GiftBoxAmountRaw | abs | money_without_trailing_zeros %}
                            {% assign already_added =  'Included' %}
        
                              {% if product.price >= GiftBoxAmountRaw %}
                                {% if block.settings.gift_box_title != blank %}
                                <div class="_b_giftbox_title">{{ block.settings.gift_box_title }}</div> 
                                {% endif %}
                               
                               <div class="_b_upsell-collection _b_dgCartUpsellCont _b_gift-products"> 
        
                                {% if settings.product1-img1 %}
                                  <div  class="_b_upsell-product-inner _b_gift-product show" >
                                    <div class="_b_upsell-product _b_dgCartUpsellInner _b_custom_border {% if settings.product1-img2 == blank %}inline-box{% endif %}">
                                      <div class="_b_upsell-product-image" style="margin-right: 5px;">
                                        <img class="dci-image" src="{{ settings.product1-img1 | img_url: '200x' }}" alt="{{ settings.product1-title | escape }}">     
                                      </div>
                                      {% if settings.product1-img2 %}
                                        <div class="_b_upsell-product-image">
                                          <img class="dci-image" src="{{ settings.product1-img2 | img_url: '200x' }}" alt="{{ settings.product1-title | escape }}">     
                                        </div>
                                      {% endif %}
                                      <div class="_b_upsell-product-info">
                                        <div class="_b_product-title-link">
                                            <strong class="dci-title">{{ settings.product1-title}}</strong>
                                        </div>
                                      <div class="_b_cart__item-sub">
                                        <div >
                                            <p class="_b_txt">{{ settings.product1-text}}</p>
                                        </div>
                                      </div>    
                                  </div>
                                    </div>
                                  </div>
                                {% endif %}
                      
                                {% if settings.product2-img1 %}
                                  <div  class="_b_upsell-product-inner _b_gift-product show">
                                    <div class="_b_upsell-product _b_dgCartUpsellInner _b_custom_border  {% if settings.product2-img2 == blank %}inline-box{% endif %}">
                                      <div class="_b_upsell-product-image" style="margin-right: 5px;">
                                        <img class="dci-image" src="{{ settings.product2-img1 | img_url: '200x' }}" alt="{{ settings.product2-title | escape }}">     
                                      </div>
                                  {% if settings.product2-img2 %}
                                      <div class="_b_upsell-product-image">
                                        <img class="dci-image" src="{{ settings.product2-img2 | img_url: '200x' }}" alt="{{ settings.product2-title | escape }}">     
                                      </div>
                                    {% endif %}
                                      <div class="_b_upsell-product-info">
                                          <div class="_b_product-title-link">
                                              <strong class="dci-title">{{ settings.product2-title}}</strong>
                                          </div>
                                     <div class="_b_cart__item-sub">
                                       <div >
                                            <p class="_b_txt">{{ settings.product2-text}}</p>
                                        </div>
                                      </div>    
                                 </div>
                                    </div>
                                  </div>
                                {% endif %}
                      
                                 {% if settings.product3-img1 %}
                                  <div  class="_b_upsell-product-inner _b_gift-product show">
                                    <div class="_b_upsell-product _b_dgCartUpsellInner _b_custom_border {% if settings.product3-img2 == blank %}inline-box{% endif %}">
                                      <div class="_b_upsell-product-image" style="margin-right: 5px;">
